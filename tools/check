#!/usr/bin/env bash
# Build the library and check it: the root file imports every file, no forbidden words appear,
# and every declaration uses only Lean's three standard axioms.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
python3 tools/gen_root.py --check
if grep -rn -E '\b(sorry|native_decide|ofReduceBool|implemented_by|admit)\b|^\s*axiom ' Maroti --include='*.lean'; then
  echo "CHECK FAILED: forbidden word above"; exit 1
fi
python3 -I tools/import_boundary.py
lake build Maroti Checks.Axioms Checks.ImportBoundary
echo "CHECK PASSED"
