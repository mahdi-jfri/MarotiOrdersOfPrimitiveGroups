/-- Root subgroup element `smallReeX K i c` in `adjointGroup .G2 K`. -/
private noncomputable def g2X {K : Type} [Field K] (i : Fin 6) (c : K) :
    ↥(adjointGroup Tag.G2 K) :=
  ⟨smallReeX K i c, pinnedX_mem_adjointGroup _ c⟩

private theorem g2X_eq_rootX {K : Type} [Field K] (i : Fin 6) (c : K) :
    g2X i c = rootX (smallReeRoot i) c :=
  rfl

private theorem g2X_add {K : Type} [Field K] (i : Fin 6) (c d : K) :
    g2X i (c + d) = g2X i c * g2X i d :=
  Subtype.ext (smallReeX_add i c d)

private theorem g2X_zero {K : Type} [Field K] (i : Fin 6) :
    g2X i (0 : K) = 1 :=
  Subtype.ext (smallReeX_zero i)

private theorem g2X_neg {K : Type} [Field K] (i : Fin 6) (c : K) :
    (g2X i c)⁻¹ = g2X i (-c) :=
  Subtype.ext (pinnedX_neg Tag.G2 K (smallReeRoot i) c)

private theorem g2X_injective {K : Type} [Field K] (i : Fin 6) :
    Function.Injective (g2X (K := K) i) :=
  fun _ _ h => pinnedX_injective Tag.G2 K (smallReeRoot i) (congrArg Subtype.val h)

private theorem g2X_word_eq {K : Type} [Field K] {i j : Fin 6} {cs : List Factor}
    (h : wordCheck Tag.G2 0 (smallReeLeft i j) (smallReeRight i j cs) = true) (x y : K) :
    smallReeX K j y * smallReeX K i x =
      smallReeX K i x * smallReeX K j y * factorPinned Tag.G2 K cs x y := by
  rw [← factorPinned_smallReeLeft, ← factorPinned_smallReeRight]
  exact factorPinned_eq_of_wordCheck h K Nat.cast_zero x y

private theorem g2X_comm_of_check {K : Type} [Field K] {i j : Fin 6}
    (h : wordCheck Tag.G2 0 (smallReeLeft i j) (smallReeRight i j []) = true) (x y : K) :
    g2X j y * g2X i x = g2X i x * g2X j y := by
  apply Subtype.ext
  have := g2X_word_eq h x y
  rwa [factorPinned_nil, mul_one] at this

private theorem g2X_comm_1_2 {K : Type} [Field K] (x y : K) :
    g2X 2 y * g2X 1 x = g2X 1 x * g2X 2 y := g2X_comm_of_check g2Check0_1_2 x y

private theorem g2X_comm_1_3 {K : Type} [Field K] (x y : K) :
    g2X 3 y * g2X 1 x = g2X 1 x * g2X 3 y := g2X_comm_of_check g2Check0_1_3 x y

private theorem g2X_comm_1_5 {K : Type} [Field K] (x y : K) :
    g2X 5 y * g2X 1 x = g2X 1 x * g2X 5 y := g2X_comm_of_check g2Check0_1_5 x y

private theorem g2X_comm_2_4 {K : Type} [Field K] (x y : K) :
    g2X 4 y * g2X 2 x = g2X 2 x * g2X 4 y := g2X_comm_of_check g2Check0_2_4 x y

private theorem g2X_comm_2_5 {K : Type} [Field K] (x y : K) :
    g2X 5 y * g2X 2 x = g2X 2 x * g2X 5 y := g2X_comm_of_check g2Check0_2_5 x y

private theorem g2X_comm_3_4 {K : Type} [Field K] (x y : K) :
    g2X 4 y * g2X 3 x = g2X 3 x * g2X 4 y := g2X_comm_of_check g2Check0_3_4 x y

private theorem g2X_comm_3_5 {K : Type} [Field K] (x y : K) :
    g2X 5 y * g2X 3 x = g2X 3 x * g2X 5 y := g2X_comm_of_check g2Check0_3_5 x y

private theorem g2X_comm_4_5 {K : Type} [Field K] (x y : K) :
    g2X 5 y * g2X 4 x = g2X 4 x * g2X 5 y := g2X_comm_of_check g2Check0_4_5 x y

private theorem g2X_swap_1_4 {K : Type} [Field K] (x y : K) :
    g2X 4 y * g2X 1 x = g2X 1 x * g2X 4 y * g2X 5 (-(x * y)) := by
  apply Subtype.ext
  have h := g2X_word_eq g2Check0_1_4 x y
  simp only [factorPinned_cons, factorPinned_nil, root_smallReePos, Int.cast_neg, Int.cast_one,
    neg_mul, one_mul, pow_one, mul_one, smallReeX] at h
  exact h

private theorem g2X_swap_2_3 {K : Type} [Field K] (x y : K) :
    g2X 3 y * g2X 2 x = g2X 2 x * g2X 3 y * g2X 5 (-(3 * x * y)) := by
  apply Subtype.ext
  have h := g2X_word_eq g2Check0_2_3 x y
  simp only [factorPinned_cons, factorPinned_nil, root_smallReePos, Int.cast_neg, Int.cast_ofNat,
    neg_mul, pow_one, mul_one, smallReeX] at h
  exact h

private theorem g2X_conj_1_4 {K : Type} [Field K] (x y : K) :
    g2X 1 x * g2X 4 y * (g2X 1 x)⁻¹ = g2X 4 y * g2X 5 (x * y) := by
  have h := g2X_swap_1_4 (-x) y
  rw [neg_mul, neg_neg, ← g2X_neg] at h
  calc g2X 1 x * g2X 4 y * (g2X 1 x)⁻¹
      = g2X 1 x * (g2X 4 y * (g2X 1 x)⁻¹) := by group
    _ = g2X 1 x * ((g2X 1 x)⁻¹ * g2X 4 y * g2X 5 (x * y)) := by rw [h]
    _ = g2X 4 y * g2X 5 (x * y) := by group

private theorem g2X_conj_2_3 {K : Type} [Field K] (x y : K) :
    g2X 2 x * g2X 3 y * (g2X 2 x)⁻¹ = g2X 3 y * g2X 5 (3 * x * y) := by
  have h := g2X_swap_2_3 (-x) y
  have h1 : -(3 * -x * y) = 3 * x * y := by ring
  rw [h1, ← g2X_neg] at h
  calc g2X 2 x * g2X 3 y * (g2X 2 x)⁻¹
      = g2X 2 x * (g2X 3 y * (g2X 2 x)⁻¹) := by group
    _ = g2X 2 x * ((g2X 2 x)⁻¹ * g2X 3 y * g2X 5 (3 * x * y)) := by rw [h]
    _ = g2X 3 y * g2X 5 (3 * x * y) := by group

/-! ### Torus conjugation on `g2X` -/

private theorem isRoot_smallReeRoot (i : Fin 6) : IsRoot Tag.G2 (smallReeRoot i) :=
  RootOps.isRootB_iff.1 (smallReeRoot_check i).1

private theorem cartanCoord_smallReeRoot_3 :
    cartanCoord (smallReeRoot 3) ⟨0, by decide⟩ = 0 ∧
      cartanCoord (smallReeRoot 3) ⟨1, by decide⟩ = 1 := by
  decide +kernel

private theorem cartanCoord_smallReeRoot_5 :
    cartanCoord (smallReeRoot 5) ⟨0, by decide⟩ = 1 ∧
      cartanCoord (smallReeRoot 5) ⟨1, by decide⟩ = 0 := by
  decide +kernel

private noncomputable def g2TorusVec {K : Type} [Field K] (u v : Kˣ) : Fin Tag.G2.rank → Kˣ :=
  ![u, v]

private theorem rootChar_smallReeRoot_3 {K : Type} [Field K] (u v : Kˣ) :
    rootChar K (smallReeRoot 3) (g2TorusVec u v) = v := by
  change ∏ k : Fin 2, (![u, v] : Fin 2 → Kˣ) k ^ cartanCoord (smallReeRoot 3) k = v
  rw [Fin.prod_univ_two]
  change u ^ cartanCoord (smallReeRoot 3) ⟨0, by decide⟩ *
    v ^ cartanCoord (smallReeRoot 3) ⟨1, by decide⟩ = v
  rw [cartanCoord_smallReeRoot_3.1, cartanCoord_smallReeRoot_3.2, zpow_zero, zpow_one, one_mul]

private theorem rootChar_smallReeRoot_5 {K : Type} [Field K] (u v : Kˣ) :
    rootChar K (smallReeRoot 5) (g2TorusVec u v) = u := by
  change ∏ k : Fin 2, (![u, v] : Fin 2 → Kˣ) k ^ cartanCoord (smallReeRoot 5) k = u
  rw [Fin.prod_univ_two]
  change u ^ cartanCoord (smallReeRoot 5) ⟨0, by decide⟩ *
    v ^ cartanCoord (smallReeRoot 5) ⟨1, by decide⟩ = u
  rw [cartanCoord_smallReeRoot_5.1, cartanCoord_smallReeRoot_5.2, zpow_one, zpow_zero, mul_one]

private noncomputable def g2TorusHom {K : Type} [Field K] :
    (Kˣ × Kˣ) →* ↥(adjointGroup Tag.G2 K) where
  toFun p := torusX (g2TorusVec p.1 p.2)
  map_one' := Subtype.ext (by
    change torusVec Tag.G2 K (g2TorusVec 1 1) = 1
    have h : g2TorusVec (1 : Kˣ) 1 = 1 := by
      ext i; fin_cases i <;> rfl
    rw [h, map_one])
  map_mul' p q := Subtype.ext (by
    change torusVec Tag.G2 K (g2TorusVec (p.1 * q.1) (p.2 * q.2)) =
      torusVec Tag.G2 K (g2TorusVec p.1 p.2) * torusVec Tag.G2 K (g2TorusVec q.1 q.2)
    have h : g2TorusVec (p.1 * q.1) (p.2 * q.2) = g2TorusVec p.1 p.2 * g2TorusVec q.1 q.2 := by
      ext i; fin_cases i <;> rfl
    rw [h, map_mul])

private theorem g2TorusHom_conj_g2X {K : Type} [Field K] (p : Kˣ × Kˣ) (i : Fin 6) (c : K) :
    g2TorusHom p * g2X i c * (g2TorusHom p)⁻¹ =
      g2X i ((rootChar K (smallReeRoot i) (g2TorusVec p.1 p.2) : K) * c) :=
  torusX_conj_rootX (isRoot_smallReeRoot i) (g2TorusVec p.1 p.2) c

private theorem g2TorusHom_conj_g2X_3 {K : Type} [Field K] (u v : Kˣ) (c : K) :
    g2TorusHom (u, v) * g2X 3 c * (g2TorusHom (u, v))⁻¹ = g2X 3 ((v : K) * c) := by
  rw [g2TorusHom_conj_g2X, rootChar_smallReeRoot_3]

private theorem g2TorusHom_conj_g2X_5 {K : Type} [Field K] (u v : Kˣ) (c : K) :
    g2TorusHom (u, v) * g2X 5 c * (g2TorusHom (u, v))⁻¹ = g2X 5 ((u : K) * c) := by
  rw [g2TorusHom_conj_g2X, rootChar_smallReeRoot_5]

private noncomputable def g2Torus1 {K : Type} [Field K] : Kˣ →* ↥(adjointGroup Tag.G2 K) :=
  g2TorusHom.comp (MonoidHom.inl Kˣ Kˣ)

private theorem g2Torus1_conj_g2X {K : Type} [Field K] (u : Kˣ) (i : Fin 6) (c : K) :
    g2Torus1 u * g2X i c * (g2Torus1 u)⁻¹ =
      g2X i ((rootChar K (smallReeRoot i) (g2TorusVec u 1) : K) * c) :=
  g2TorusHom_conj_g2X (u, 1) i c

private theorem g2Torus1_conj_g2X_5 {K : Type} [Field K] (u : Kˣ) (c : K) :
    g2Torus1 u * g2X 5 c * (g2Torus1 u)⁻¹ = g2X 5 ((u : K) * c) :=
  g2TorusHom_conj_g2X_5 u 1 c

/-! ### Subgroup index bounds in all characteristics and for `p ≠ 3` -/

private noncomputable def g2Hom (K : Type) [Field K] (i : Fin 6) :
    Multiplicative K →* ↥(adjointGroup Tag.G2 K) where
  toFun c := g2X i c.toAdd
  map_one' := g2X_zero i
  map_mul' c d := g2X_add i c.toAdd d.toAdd

private theorem card_range_id_units (K : Type) [Field K] [Finite K] :
    Nat.card (MonoidHom.id Kˣ).range = Nat.card K - 1 := by
  have htop : (MonoidHom.id Kˣ).range = ⊤ := MonoidHom.range_eq_top.mpr Function.surjective_id
  rw [htop, Subgroup.card_top, Nat.card_units]

/-- In any finite field `K`, every proper subgroup `M` of `adjointGroup .G2 K` has index at least
`(Nat.card K - 1) * Nat.card K + 1`. -/
theorem card_sub_one_mul_card_add_one_le_index_g2
    {K : Type} [Field K] [Finite K] [Finite ↥(adjointGroup Tag.G2 K)]
    [IsSimpleGroup ↥(adjointGroup Tag.G2 K)]
    {M : Subgroup ↥(adjointGroup Tag.G2 K)} (hM : M ≠ ⊤) :
    (Nat.card K - 1) * Nat.card K + 1 ≤ M.index := by
  rw [Subgroup.index_eq_card, ← card_range_id_units K]
  have hz1 : g2Hom K 5 (Multiplicative.ofAdd 1) ≠ 1 :=
    fun h => one_ne_zero (g2X_injective 5 (h.trans (g2X_zero 5).symm))
  refine card_range_mul_card_add_one_le_card_of_heis_root_of_inj
    (MulAction.toPermHom ↥(adjointGroup Tag.G2 K) (↥(adjointGroup Tag.G2 K) ⧸ M))
    (g2Hom K 5) (g2Hom K 4) (g2X 1) (LinearMap.mul K K)
    (fun v hv => ⟨1, by simpa using hv⟩)
    (fun u hu => ⟨1, by simpa using hu⟩)
    (fun c hc => g2X_injective 5 (hc.trans (g2X_zero 5).symm))
    (fun c u => g2X_comm_4_5 u.toAdd c.toAdd)
    (fun u v => by simpa [g2Hom, mul_comm] using g2X_conj_1_4 v u)
    (fun c v => (g2X_comm_1_5 v c.toAdd).symm)
    g2Torus1 (MonoidHom.id Kˣ)
    (fun s c => g2Torus1_conj_g2X_5 s c)
    (fun s u => ⟨_, g2Torus1_conj_g2X s 4 u⟩)
    (toPermHom_quotient_ne_one_of_ne_one hM hz1)

private noncomputable def g2Hom34 (K : Type) [Field K] :
    Multiplicative (K × K) →* ↥(adjointGroup Tag.G2 K) where
  toFun u := g2X 3 u.toAdd.1 * g2X 4 u.toAdd.2
  map_one' := by
    change g2X 3 0 * g2X 4 0 = 1
    rw [g2X_zero, g2X_zero, mul_one]
  map_mul' u v := by
    change g2X 3 (u.toAdd.1 + v.toAdd.1) * g2X 4 (u.toAdd.2 + v.toAdd.2) =
      (g2X 3 u.toAdd.1 * g2X 4 u.toAdd.2) * (g2X 3 v.toAdd.1 * g2X 4 v.toAdd.2)
    rw [g2X_add, g2X_add]
    calc g2X 3 u.toAdd.1 * g2X 3 v.toAdd.1 * (g2X 4 u.toAdd.2 * g2X 4 v.toAdd.2)
        = g2X 3 u.toAdd.1 * (g2X 3 v.toAdd.1 * g2X 4 u.toAdd.2) * g2X 4 v.toAdd.2 := by group
      _ = g2X 3 u.toAdd.1 * (g2X 4 u.toAdd.2 * g2X 3 v.toAdd.1) * g2X 4 v.toAdd.2 := by
        rw [g2X_comm_3_4]
      _ = (g2X 3 u.toAdd.1 * g2X 4 u.toAdd.2) * (g2X 3 v.toAdd.1 * g2X 4 v.toAdd.2) := by group

private noncomputable def g2Beta34 (K : Type) [Field K] : (K × K) →ₗ[K] (K × K) →ₗ[K] K :=
  LinearMap.mk₂ K (fun u v => 3 * u.1 * v.1 + u.2 * v.2)
    (fun _ _ _ => by simp; ring) (fun _ _ _ => by simp; ring)
    (fun _ _ _ => by simp; ring) (fun _ _ _ => by simp; ring)

private theorem g2Hom5_comm_g2Hom34 {K : Type} [Field K]
    (c : Multiplicative K) (u : Multiplicative (K × K)) :
    g2Hom K 5 c * g2Hom34 K u = g2Hom34 K u * g2Hom K 5 c := by
  change g2X 5 c.toAdd * (g2X 3 u.toAdd.1 * g2X 4 u.toAdd.2) =
    (g2X 3 u.toAdd.1 * g2X 4 u.toAdd.2) * g2X 5 c.toAdd
  rw [← mul_assoc, g2X_comm_3_5, mul_assoc, g2X_comm_4_5, ← mul_assoc]

private theorem g2B34_comm_g2Hom5 {K : Type} [Field K]
    (c : Multiplicative K) (v : K × K) :
    (g2X 2 v.1 * g2X 1 v.2) * g2Hom K 5 c = g2Hom K 5 c * (g2X 2 v.1 * g2X 1 v.2) := by
  change (g2X 2 v.1 * g2X 1 v.2) * g2X 5 c.toAdd = g2X 5 c.toAdd * (g2X 2 v.1 * g2X 1 v.2)
  rw [mul_assoc, ← g2X_comm_1_5, ← mul_assoc, ← g2X_comm_2_5, mul_assoc]

private theorem g2Hom34_conj {K : Type} [Field K] (u v : K × K) :
    (g2X 2 v.1 * g2X 1 v.2) * g2Hom34 K (Multiplicative.ofAdd u) *
        (g2X 2 v.1 * g2X 1 v.2)⁻¹ =
      g2Hom34 K (Multiplicative.ofAdd u) * g2Hom K 5 (Multiplicative.ofAdd (g2Beta34 K u v)) := by
  change (g2X 2 v.1 * g2X 1 v.2) * (g2X 3 u.1 * g2X 4 u.2) * (g2X 2 v.1 * g2X 1 v.2)⁻¹ =
    (g2X 3 u.1 * g2X 4 u.2) * g2X 5 (3 * u.1 * v.1 + u.2 * v.2)
  have h1 : g2X 1 v.2 * (g2X 3 u.1 * g2X 4 u.2) * (g2X 1 v.2)⁻¹ =
      g2X 3 u.1 * (g2X 4 u.2 * g2X 5 (v.2 * u.2)) := by
    calc g2X 1 v.2 * (g2X 3 u.1 * g2X 4 u.2) * (g2X 1 v.2)⁻¹
        = (g2X 1 v.2 * g2X 3 u.1) * g2X 4 u.2 * (g2X 1 v.2)⁻¹ := by group
      _ = (g2X 3 u.1 * g2X 1 v.2) * g2X 4 u.2 * (g2X 1 v.2)⁻¹ := by rw [g2X_comm_1_3]
      _ = g2X 3 u.1 * (g2X 1 v.2 * g2X 4 u.2 * (g2X 1 v.2)⁻¹) := by group
      _ = g2X 3 u.1 * (g2X 4 u.2 * g2X 5 (v.2 * u.2)) := by rw [g2X_conj_1_4]
  have h245 : g2X 2 v.1 * (g2X 4 u.2 * g2X 5 (v.2 * u.2)) * (g2X 2 v.1)⁻¹ =
      g2X 4 u.2 * g2X 5 (v.2 * u.2) := by
    calc g2X 2 v.1 * (g2X 4 u.2 * g2X 5 (v.2 * u.2)) * (g2X 2 v.1)⁻¹
        = (g2X 2 v.1 * g2X 4 u.2) * g2X 5 (v.2 * u.2) * (g2X 2 v.1)⁻¹ := by group
      _ = g2X 4 u.2 * (g2X 2 v.1 * g2X 5 (v.2 * u.2)) * (g2X 2 v.1)⁻¹ := by
        rw [← g2X_comm_2_4]; group
      _ = g2X 4 u.2 * (g2X 5 (v.2 * u.2) * g2X 2 v.1) * (g2X 2 v.1)⁻¹ := by rw [g2X_comm_2_5]
      _ = g2X 4 u.2 * g2X 5 (v.2 * u.2) := by group
  have h2 : g2X 2 v.1 * (g2X 3 u.1 * (g2X 4 u.2 * g2X 5 (v.2 * u.2))) * (g2X 2 v.1)⁻¹ =
      (g2X 3 u.1 * g2X 4 u.2) * g2X 5 (3 * u.1 * v.1 + u.2 * v.2) := by
    calc g2X 2 v.1 * (g2X 3 u.1 * (g2X 4 u.2 * g2X 5 (v.2 * u.2))) * (g2X 2 v.1)⁻¹
        = (g2X 2 v.1 * g2X 3 u.1 * (g2X 2 v.1)⁻¹) *
          (g2X 2 v.1 * (g2X 4 u.2 * g2X 5 (v.2 * u.2)) * (g2X 2 v.1)⁻¹) := by group
      _ = (g2X 3 u.1 * g2X 5 (3 * v.1 * u.1)) * (g2X 4 u.2 * g2X 5 (v.2 * u.2)) := by
        rw [g2X_conj_2_3, h245]
      _ = g2X 3 u.1 * (g2X 5 (3 * v.1 * u.1) * g2X 4 u.2) * g2X 5 (v.2 * u.2) := by group
      _ = (g2X 3 u.1 * g2X 4 u.2) * (g2X 5 (3 * v.1 * u.1) * g2X 5 (v.2 * u.2)) := by
        rw [g2X_comm_4_5]; group
      _ = (g2X 3 u.1 * g2X 4 u.2) * g2X 5 (3 * u.1 * v.1 + u.2 * v.2) := by
        rw [← g2X_add]
        congr 2
        ring
  calc (g2X 2 v.1 * g2X 1 v.2) * (g2X 3 u.1 * g2X 4 u.2) * (g2X 2 v.1 * g2X 1 v.2)⁻¹
      = g2X 2 v.1 * (g2X 1 v.2 * (g2X 3 u.1 * g2X 4 u.2) * (g2X 1 v.2)⁻¹) * (g2X 2 v.1)⁻¹ := by
        group
    _ = (g2X 3 u.1 * g2X 4 u.2) * g2X 5 (3 * u.1 * v.1 + u.2 * v.2) := by rw [h1, h2]

private theorem g2Torus1_conj_g2Hom34 {K : Type} [Field K] (s : Kˣ) (u : K × K) :
    ∃ u' : K × K, g2Torus1 s * g2Hom34 K (Multiplicative.ofAdd u) * (g2Torus1 s)⁻¹ =
      g2Hom34 K (Multiplicative.ofAdd u') := by
  refine ⟨((rootChar K (smallReeRoot 3) (g2TorusVec s 1) : K) * u.1,
    (rootChar K (smallReeRoot 4) (g2TorusVec s 1) : K) * u.2), ?_⟩
  change g2Torus1 s * (g2X 3 u.1 * g2X 4 u.2) * (g2Torus1 s)⁻¹ = _
  calc g2Torus1 s * (g2X 3 u.1 * g2X 4 u.2) * (g2Torus1 s)⁻¹
      = (g2Torus1 s * g2X 3 u.1 * (g2Torus1 s)⁻¹) *
        (g2Torus1 s * g2X 4 u.2 * (g2Torus1 s)⁻¹) := by group
    _ = _ := by rw [g2Torus1_conj_g2X s 3 u.1, g2Torus1_conj_g2X s 4 u.2]; rfl

/-- When `(3 : K) ≠ 0`, every proper subgroup `M` of `adjointGroup .G2 K` has index at least
`(Nat.card K - 1) * (Nat.card K) ^ 2 + 1`. -/
theorem card_sub_one_mul_sq_add_one_le_index_g2_of_ne_three
    {K : Type} [Field K] [Finite K] [Finite ↥(adjointGroup Tag.G2 K)]
    [IsSimpleGroup ↥(adjointGroup Tag.G2 K)]
    (h3 : (3 : K) ≠ 0) {M : Subgroup ↥(adjointGroup Tag.G2 K)} (hM : M ≠ ⊤) :
    (Nat.card K - 1) * (Nat.card K) ^ 2 + 1 ≤ M.index := by
  rw [Subgroup.index_eq_card, ← card_range_id_units K, sq, ← Nat.card_prod]
  have hz1 : g2Hom K 5 (Multiplicative.ofAdd 1) ≠ 1 :=
    fun h => one_ne_zero (g2X_injective 5 (h.trans (g2X_zero 5).symm))
  refine card_range_mul_card_add_one_le_card_of_heis_root_of_inj
    (MulAction.toPermHom ↥(adjointGroup Tag.G2 K) (↥(adjointGroup Tag.G2 K) ⧸ M))
    (g2Hom K 5) (g2Hom34 K) (fun v => g2X 2 v.1 * g2X 1 v.2) (g2Beta34 K)
    (fun v hv => ?_) (fun u hu => ?_)
    (fun c hc => g2X_injective 5 (hc.trans (g2X_zero 5).symm))
    g2Hom5_comm_g2Hom34 g2Hom34_conj g2B34_comm_g2Hom5
    g2Torus1 (MonoidHom.id Kˣ)
    (fun s c => g2Torus1_conj_g2X_5 s c)
    g2Torus1_conj_g2Hom34
    (toPermHom_quotient_ne_one_of_ne_one hM hz1)
  · by_cases hv1 : v.1 ≠ 0
    · refine ⟨(1, 0), ?_⟩
      change 3 * 1 * v.1 + 0 * v.2 ≠ 0
      simpa using mul_ne_zero h3 hv1
    · push Not at hv1
      have hv2 : v.2 ≠ 0 := fun h => hv (Prod.ext hv1 h)
      refine ⟨(0, 1), ?_⟩
      change 3 * 0 * v.1 + 1 * v.2 ≠ 0
      simpa using hv2
  · by_cases hu1 : u.1 ≠ 0
    · refine ⟨(1, 0), ?_⟩
      change 3 * u.1 * 1 + u.2 * 0 ≠ 0
      simpa using mul_ne_zero h3 hu1
    · push Not at hu1
      have hu2 : u.2 ≠ 0 := fun h => hu (Prod.ext hu1 h)
      refine ⟨(0, 1), ?_⟩
      change 3 * u.1 * 0 + u.2 * 1 ≠ 0
      simpa using hu2

/-! ### Two-system Heisenberg eigenvector bounds and characteristic `3` index bound -/

private theorem xi_eq_imp_u_eq {K : Type} [Field K] {ψ : K → ℂ}
    (hψadd : ∀ c d : K, ψ (c + d) = ψ c * ψ d) (hψne : ∀ c : K, ψ c ≠ 0)
    {c₀ : Kˣ} (hψc₀ : ψ c₀ ≠ 1) {u u' : Kˣ}
    (h : ∀ c : K, ψ ((u : K) * c) = ψ ((u' : K) * c)) : u = u' := by
  by_contra hne
  have hd : (u : K) - (u' : K) ≠ 0 :=
    sub_ne_zero.mpr fun h1 => hne (Units.ext h1)
  have h1 := h (((u : K) - (u' : K))⁻¹ * (c₀ : K))
  have h2 : (u : K) * (((u : K) - (u' : K))⁻¹ * (c₀ : K)) =
      (u' : K) * (((u : K) - (u' : K))⁻¹ * (c₀ : K)) + (c₀ : K) := by
    calc (u : K) * (((u : K) - (u' : K))⁻¹ * (c₀ : K))
        = (u' : K) * (((u : K) - (u' : K))⁻¹ * (c₀ : K)) +
          ((u : K) - (u' : K)) * ((u : K) - (u' : K))⁻¹ * (c₀ : K) := by ring
      _ = _ := by rw [mul_inv_cancel₀ hd, one_mul]
  rw [h2, hψadd] at h1
  exact hψc₀ (mul_left_cancel₀ (hψne _) (h1.trans (mul_one _).symm))

private theorem xi_eq_imp_v_eq {K : Type} [Field K] {ψ η : K → ℂ}
    (hψadd : ∀ c d : K, ψ (c + d) = ψ c * ψ d) (hψne : ∀ c : K, ψ c ≠ 0)
    (hηne : ∀ d : K, η d ≠ 0) {c₀ : Kˣ} (hψc₀ : ψ c₀ ≠ 1) (r : Kˣ) {v v' : K}
    (h : ∀ d : K, ψ ((r : K) * d * v) * η ((r : K) * d) =
      ψ ((r : K) * d * v') * η ((r : K) * d)) : v = v' := by
  by_contra hne
  have hd : v - v' ≠ 0 := sub_ne_zero.mpr hne
  let d₀ : K := ((r⁻¹ : Kˣ) : K) * (v - v')⁻¹ * (c₀ : K)
  have hrd : (r : K) * d₀ = (v - v')⁻¹ * (c₀ : K) := by
    change (r : K) * (((r⁻¹ : Kˣ) : K) * (v - v')⁻¹ * (c₀ : K)) = _
    calc (r : K) * (((r⁻¹ : Kˣ) : K) * (v - v')⁻¹ * (c₀ : K))
        = ((r : K) * ((r⁻¹ : Kˣ) : K)) * (v - v')⁻¹ * (c₀ : K) := by ring
      _ = _ := by rw [Units.mul_inv, one_mul]
  have h1 := mul_right_cancel₀ (hηne ((r : K) * d₀)) (h d₀)
  have h2 : (r : K) * d₀ * v = (r : K) * d₀ * v' + (c₀ : K) := by
    rw [hrd]
    calc (v - v')⁻¹ * (c₀ : K) * v
        = (v - v')⁻¹ * (c₀ : K) * v' + ((v - v') * (v - v')⁻¹) * (c₀ : K) := by ring
      _ = _ := by rw [mul_inv_cancel₀ hd, one_mul]
  rw [h2, hψadd] at h1
  exact hψc₀ (mul_left_cancel₀ (hψne _) (h1.trans (mul_one _).symm))

private def twoHeisConjMap {K : Type} [Field K] (r₁ r₂ : Kˣ × Kˣ → Kˣ)
    (x : (Kˣ × K) × (Kˣ × K)) (m : (K × K) × (K × K)) : (K × K) × (K × K) :=
  (((x.1.1 : K) * m.1.1 + (r₁ (x.1.1, x.2.1) : K) * m.1.2 * x.1.2,
    (r₁ (x.1.1, x.2.1) : K) * m.1.2),
   ((x.2.1 : K) * m.2.1 + (r₂ (x.1.1, x.2.1) : K) * m.2.2 * x.2.2,
    (r₂ (x.1.1, x.2.1) : K) * m.2.2))

private theorem jointEigen_mul {U Λ : Type*} [Group U] {ρ : U →* Module.End ℂ (Λ → ℂ)}
    {χ₀ : (⊤ : Subgroup U) → ℂ} {w₀ : Λ → ℂ} (hw₀ : w₀ ≠ 0)
    (hev₀ : ∀ m : (⊤ : Subgroup U), ρ m w₀ = χ₀ m • w₀)
    (x y : (⊤ : Subgroup U)) : χ₀ (x * y) = χ₀ x * χ₀ y := by
  have h1 : ρ ((x * y : (⊤ : Subgroup U)) : U) w₀ = (χ₀ x * χ₀ y) • w₀ := by
    rw [Subgroup.coe_mul, map_mul, Module.End.mul_apply, hev₀ y, map_smul, hev₀ x, smul_smul,
      mul_comm]
  have h2 := hev₀ (x * y)
  rw [h1] at h2
  exact (smul_left_injective ℂ hw₀ h2).symm

private theorem jointEigen_ne_zero {U Λ : Type*} [Group U] {ρ : U →* Module.End ℂ (Λ → ℂ)}
    {χ₀ : (⊤ : Subgroup U) → ℂ} {w₀ : Λ → ℂ} (hw₀ : w₀ ≠ 0)
    (hev₀ : ∀ m : (⊤ : Subgroup U), ρ m w₀ = χ₀ m • w₀)
    (x : (⊤ : Subgroup U)) : χ₀ x ≠ 0 := by
  have hχ1 : χ₀ 1 = 1 := by
    have h := jointEigen_mul hw₀ hev₀ 1 1
    rw [one_mul] at h
    have h3 : χ₀ 1 * (χ₀ 1 - 1) = 0 := by rw [mul_sub, mul_one, ← h, sub_self]
    rcases mul_eq_zero.mp h3 with h0 | h0
    · exfalso
      have := hev₀ 1
      rw [h0, zero_smul, Subgroup.coe_one, map_one, Module.End.one_apply] at this
      exact hw₀ this
    · exact sub_eq_zero.mp h0
  intro h
  have := jointEigen_mul hw₀ hev₀ x x⁻¹
  rw [mul_inv_cancel, hχ1, h, zero_mul] at this
  exact one_ne_zero this

private theorem jointEigen_conj_ne_zero {S Λ : Type*} [Group S] (π : S →* Equiv.Perm Λ)
    {w₀ : Λ → ℂ} (hw₀ : w₀ ≠ 0) (g : S) :
    permFunHom Λ (π g⁻¹) w₀ ≠ 0 := by
  intro h
  apply hw₀
  have h1 : permFunHom Λ (π g) (permFunHom Λ (π g⁻¹) w₀) = w₀ := by
    rw [← Module.End.mul_apply, ← map_mul, ← map_mul, mul_inv_cancel, map_one, map_one,
      Module.End.one_apply]
  rw [← h1]
  exact (congrArg (permFunHom Λ (π g)) h).trans (map_zero _)

private theorem jointEigen_conj_ev {S Λ : Type*} {K : Type} [Group S] [Field K]
    (π : S →* Equiv.Perm Λ)
    (φ : Multiplicative ((K × K) × (K × K)) →* S)
    (g : (Kˣ × K) × (Kˣ × K) → S) (r₁ r₂ : Kˣ × Kˣ → Kˣ)
    (hgconj : ∀ x m, g x * φ (Multiplicative.ofAdd m) * (g x)⁻¹ =
      φ (Multiplicative.ofAdd (twoHeisConjMap r₁ r₂ x m)))
    {χ₀ : (⊤ : Subgroup (Multiplicative ((K × K) × (K × K)))) → ℂ} {w₀ : Λ → ℂ}
    (hev₀ : ∀ m : (⊤ : Subgroup (Multiplicative ((K × K) × (K × K)))),
      ((permFunHom Λ).comp π).comp φ m w₀ = χ₀ m • w₀)
    (x : (Kˣ × K) × (Kˣ × K)) :
    ∀ m : (⊤ : Subgroup (Multiplicative ((K × K) × (K × K)))),
      ((permFunHom Λ).comp π).comp φ m (permFunHom Λ (π (g x)⁻¹) w₀) =
        χ₀ ⟨Multiplicative.ofAdd (twoHeisConjMap r₁ r₂ x m.1.toAdd), Subgroup.mem_top _⟩ •
          permFunHom Λ (π (g x)⁻¹) w₀ := by
  rintro ⟨m, -⟩
  set u := m.toAdd
  have hm : m = Multiplicative.ofAdd u := rfl
  show permFunHom Λ (π (φ m)) (permFunHom Λ (π (g x)⁻¹) w₀) = _
  have h1 : permFunHom Λ (π (φ m)) (permFunHom Λ (π (g x)⁻¹) w₀) =
      permFunHom Λ (π (g x)⁻¹) (permFunHom Λ (π (g x * φ m * (g x)⁻¹)) w₀) := by
    rw [← Module.End.mul_apply, ← map_mul, ← map_mul, ← Module.End.mul_apply, ← map_mul,
      ← map_mul]
    congr 2; group
  rw [h1, hm, hgconj x u]
  have h2 := hev₀ ⟨Multiplicative.ofAdd (twoHeisConjMap r₁ r₂ x u), Subgroup.mem_top _⟩
  change permFunHom Λ (π (φ _)) w₀ = _ • w₀ at h2
  rw [h2, map_smul]

private theorem sq_card_sub_one_mul_card_add_one_le_card_of_two_heis_eigenvector
    {S Λ : Type*} [Group S] [Finite Λ] (π : S →* Equiv.Perm Λ)
    {K : Type} [Field K] [Finite K]
    (φ : Multiplicative ((K × K) × (K × K)) →* S)
    (g : (Kˣ × K) × (Kˣ × K) → S) (r₁ r₂ : Kˣ × Kˣ → Kˣ)
    (hgconj : ∀ x m, g x * φ (Multiplicative.ofAdd m) * (g x)⁻¹ =
      φ (Multiplicative.ofAdd (twoHeisConjMap r₁ r₂ x m)))
    (hΛ : Nonempty Λ)
    (χ₀ : (⊤ : Subgroup (Multiplicative ((K × K) × (K × K)))) → ℂ)
    (w₀ : Λ → ℂ) (hw₀ : w₀ ≠ 0)
    (hev₀ : ∀ m : (⊤ : Subgroup (Multiplicative ((K × K) × (K × K)))),
      ((permFunHom Λ).comp π).comp φ m w₀ = χ₀ m • w₀)
    {c₀ : Kˣ}
    (hc₀ : χ₀ ⟨Multiplicative.ofAdd (((c₀ : K), 0), (0, 0)), trivial⟩ ≠ 1)
    (hd₀ : χ₀ ⟨Multiplicative.ofAdd ((0, 0), (1, 0)), trivial⟩ ≠ 1) :
    ((Nat.card K - 1) * Nat.card K) ^ 2 + 1 ≤ Nat.card Λ := by
  classical
  have : Fintype K := Fintype.ofFinite K
  have : Fintype Kˣ := Fintype.ofFinite Kˣ
  have : Fintype Λ := Fintype.ofFinite Λ
  let U := Multiplicative ((K × K) × (K × K))
  let A : Subgroup U := ⊤
  let ρ : U →* Module.End ℂ (Λ → ℂ) := ((permFunHom Λ).comp π).comp φ
  have hA : IsMulCommutative A := inferInstance
  have hχmul := jointEigen_mul hw₀ hev₀
  have hχne := jointEigen_ne_zero hw₀ hev₀
  let ψ₁ : K → ℂ := fun c => χ₀ ⟨Multiplicative.ofAdd ((c, 0), (0, 0)), trivial⟩
  let η₁ : K → ℂ := fun d => χ₀ ⟨Multiplicative.ofAdd ((0, d), (0, 0)), trivial⟩
  let ψ₂ : K → ℂ := fun c => χ₀ ⟨Multiplicative.ofAdd ((0, 0), (c, 0)), trivial⟩
  let η₂ : K → ℂ := fun d => χ₀ ⟨Multiplicative.ofAdd ((0, 0), (0, d)), trivial⟩
  have hψ₁add : ∀ c d : K, ψ₁ (c + d) = ψ₁ c * ψ₁ d := fun c d => by
    change χ₀ ⟨Multiplicative.ofAdd ((c + d, 0), (0, 0)), trivial⟩ =
      χ₀ ⟨Multiplicative.ofAdd ((c, 0), (0, 0)), trivial⟩ *
        χ₀ ⟨Multiplicative.ofAdd ((d, 0), (0, 0)), trivial⟩
    rw [← hχmul]
    congr 1; apply Subtype.ext; rw [Subgroup.coe_mul, ← ofAdd_add]; simp
  have hψ₂add : ∀ c d : K, ψ₂ (c + d) = ψ₂ c * ψ₂ d := fun c d => by
    change χ₀ ⟨Multiplicative.ofAdd ((0, 0), (c + d, 0)), trivial⟩ =
      χ₀ ⟨Multiplicative.ofAdd ((0, 0), (c, 0)), trivial⟩ *
        χ₀ ⟨Multiplicative.ofAdd ((0, 0), (d, 0)), trivial⟩
    rw [← hχmul]
    congr 1; apply Subtype.ext; rw [Subgroup.coe_mul, ← ofAdd_add]; simp
  have hsplit₁ : ∀ c d : K,
      χ₀ ⟨Multiplicative.ofAdd ((c, d), (0, 0)), trivial⟩ = ψ₁ c * η₁ d := fun c d => by
    change χ₀ ⟨Multiplicative.ofAdd ((c, d), (0, 0)), trivial⟩ =
      χ₀ ⟨Multiplicative.ofAdd ((c, 0), (0, 0)), trivial⟩ *
        χ₀ ⟨Multiplicative.ofAdd ((0, d), (0, 0)), trivial⟩
    rw [← hχmul]
    congr 1; apply Subtype.ext; rw [Subgroup.coe_mul, ← ofAdd_add]; simp
  have hsplit₂ : ∀ c d : K,
      χ₀ ⟨Multiplicative.ofAdd ((0, 0), (c, d)), trivial⟩ = ψ₂ c * η₂ d := fun c d => by
    change χ₀ ⟨Multiplicative.ofAdd ((0, 0), (c, d)), trivial⟩ =
      χ₀ ⟨Multiplicative.ofAdd ((0, 0), (c, 0)), trivial⟩ *
        χ₀ ⟨Multiplicative.ofAdd ((0, 0), (0, d)), trivial⟩
    rw [← hχmul]
    congr 1; apply Subtype.ext; rw [Subgroup.coe_mul, ← ofAdd_add]; simp
  let w : Option ((Kˣ × K) × (Kˣ × K)) → (Λ → ℂ)
    | none => fun _ => 1
    | some x => permFunHom Λ (π (g x)⁻¹) w₀
  let χ' : Option ((Kˣ × K) × (Kˣ × K)) → A → ℂ
    | none => fun _ => 1
    | some x => fun m => χ₀ ⟨Multiplicative.ofAdd (twoHeisConjMap r₁ r₂ x m.1.toAdd), trivial⟩
  have hw : ∀ i, w i ≠ 0 := by
    rintro (_ | x)
    · rcases hΛ with ⟨x₀⟩
      exact fun h => one_ne_zero (congrFun h x₀)
    · exact jointEigen_conj_ne_zero π hw₀ (g x)
  have hev : ∀ i (m : A), ρ m (w i) = χ' i m • w i := by
    rintro (_ | x) m
    · ext x₀; simp [w, χ', ρ, permFunHom_apply]
    · exact jointEigen_conj_ev π φ g r₁ r₂ hgconj hev₀ x m
  have hχ'inj : Function.Injective χ' := by
    rintro (_ | x) (_ | y) hxy
    · rfl
    · exfalso
      have h1 := congrFun hxy ⟨Multiplicative.ofAdd ((0, 0), (((y.2.1⁻¹ : Kˣ) : K), 0)), trivial⟩
      simp only [χ', twoHeisConjMap, toAdd_ofAdd, mul_zero, zero_mul, add_zero,
        Units.mul_inv] at h1
      exact hd₀ h1.symm
    · exfalso
      have h1 := congrFun hxy ⟨Multiplicative.ofAdd ((0, 0), (((x.2.1⁻¹ : Kˣ) : K), 0)), trivial⟩
      simp only [χ', twoHeisConjMap, toAdd_ofAdd, mul_zero, zero_mul, add_zero,
        Units.mul_inv] at h1
      exact hd₀ h1
    · congr 1
      have hu₁ : x.1.1 = y.1.1 :=
        xi_eq_imp_u_eq hψ₁add (fun _ => hχne _) hc₀ fun c => by
          simpa [χ', twoHeisConjMap, ψ₁] using
            congrFun hxy ⟨Multiplicative.ofAdd ((c, 0), (0, 0)), trivial⟩
      have hu₂ : x.2.1 = y.2.1 :=
        xi_eq_imp_u_eq hψ₂add (fun _ => hχne _) (c₀ := 1) hd₀ fun c => by
          simpa [χ', twoHeisConjMap, ψ₂] using
            congrFun hxy ⟨Multiplicative.ofAdd ((0, 0), (c, 0)), trivial⟩
      have hv₁ : x.1.2 = y.1.2 :=
        xi_eq_imp_v_eq (η := η₁) hψ₁add (fun _ => hχne _) (fun _ => hχne _) hc₀ (r₁ (x.1.1, x.2.1))
          fun d => by
            have h1 := congrFun hxy ⟨Multiplicative.ofAdd ((0, d), (0, 0)), trivial⟩
            simp only [χ', twoHeisConjMap, toAdd_ofAdd, mul_zero, zero_mul, zero_add,
              ← hu₁, ← hu₂] at h1
            rwa [hsplit₁, hsplit₁] at h1
      have hv₂ : x.2.2 = y.2.2 :=
        xi_eq_imp_v_eq (η := η₂) hψ₂add (fun _ => hχne _) (fun _ => hχne _) (c₀ := 1) hd₀
          (r₂ (x.1.1, x.2.1)) fun d => by
            have h1 := congrFun hxy ⟨Multiplicative.ofAdd ((0, 0), (0, d)), trivial⟩
            simp only [χ', twoHeisConjMap, toAdd_ofAdd, mul_zero, zero_mul, zero_add,
              ← hu₁, ← hu₂] at h1
            rwa [hsplit₂, hsplit₂] at h1
      exact Prod.ext (Prod.ext hu₁ hv₁) (Prod.ext hu₂ hv₂)
  have hli := linearIndependent_of_distinct_weights ρ A hA w χ' hw hev hχ'inj
  have hcard := hli.fintype_card_le_finrank
  rw [Module.finrank_fintype_fun_eq_card, Fintype.card_option, Fintype.card_prod,
    Fintype.card_prod, ← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card,
    ← Nat.card_eq_fintype_card, Nat.card_units, ← sq] at hcard
  exact hcard

private theorem two_mul_card_sub_one_mul_card_add_one_le_card_of_two_heis
    {S Λ : Type*} [Group S] [Finite Λ] (π : S →* Equiv.Perm Λ)
    {K : Type} [Field K] [Finite K] (hK : 3 ≤ Nat.card K)
    (φ : Multiplicative ((K × K) × (K × K)) →* S)
    (g : (Kˣ × K) × (Kˣ × K) → S) (r₁ r₂ : Kˣ × Kˣ → Kˣ)
    (hgconj : ∀ x m, g x * φ (Multiplicative.ofAdd m) * (g x)⁻¹ =
      φ (Multiplicative.ofAdd (twoHeisConjMap r₁ r₂ x m)))
    (hnt1 : π (φ (Multiplicative.ofAdd ((1, 0), (0, 0)))) ≠ 1)
    (hnt2 : π (φ (Multiplicative.ofAdd ((0, 0), (1, 0)))) ≠ 1) :
    2 * ((Nat.card K - 1) * Nat.card K) + 1 ≤ Nat.card Λ := by
  classical
  have : Fintype K := Fintype.ofFinite K
  have : Fintype Kˣ := Fintype.ofFinite Kˣ
  have : Fintype Λ := Fintype.ofFinite Λ
  have hΛ : Nonempty Λ := by
    by_contra! hE
    exact hnt1 (Subsingleton.elim _ _)
  let U := Multiplicative ((K × K) × (K × K))
  let A : Subgroup U := ⊤
  let ρ : U →* Module.End ℂ (Λ → ℂ) := ((permFunHom Λ).comp π).comp φ
  have hA : IsMulCommutative A := inferInstance
  have hinv : (Nat.card A : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr Nat.card_pos.ne'
  let u₁ : U := Multiplicative.ofAdd ((1, 0), (0, 0))
  let u₂ : U := Multiplicative.ofAdd ((0, 0), (1, 0))
  obtain ⟨χ₁, w₁, hev₁, hTw₁⟩ :=
    exists_jointEigenvector_apply_ne_zero ρ A hA hinv (ρ u₁ - 1)
      (sub_ne_zero.mpr (permFunHom_ne_one hnt1))
  obtain ⟨χ₂, w₂, hev₂, hTw₂⟩ :=
    exists_jointEigenvector_apply_ne_zero ρ A hA hinv (ρ u₂ - 1)
      (sub_ne_zero.mpr (permFunHom_ne_one hnt2))
  have hw₁ : w₁ ≠ 0 := by rintro rfl; exact hTw₁ (map_zero _)
  have hw₂ : w₂ ≠ 0 := by rintro rfl; exact hTw₂ (map_zero _)
  have hχ₁u₁ : χ₁ ⟨u₁, trivial⟩ ≠ 1 := fun h =>
    hTw₁ (by
      rw [LinearMap.sub_apply, hev₁ ⟨u₁, trivial⟩, h, one_smul, Module.End.one_apply, sub_self])
  have hχ₂u₂ : χ₂ ⟨u₂, trivial⟩ ≠ 1 := fun h =>
    hTw₂ (by
      rw [LinearMap.sub_apply, hev₂ ⟨u₂, trivial⟩, h, one_smul, Module.End.one_apply, sub_self])
  by_cases hcross : ∃ c₀ : Kˣ, χ₂ ⟨Multiplicative.ofAdd (((c₀ : K), 0), (0, 0)), trivial⟩ ≠ 1
  · rcases hcross with ⟨c₀, hc₀⟩
    have hsq := sq_card_sub_one_mul_card_add_one_le_card_of_two_heis_eigenvector π φ g r₁ r₂
      hgconj hΛ χ₂ w₂ hw₂ hev₂ hc₀ hχ₂u₂
    have hge2 : 2 ≤ (Nat.card K - 1) * Nat.card K := by
      have h1 : 2 ≤ Nat.card K - 1 := by omega
      nlinarith
    nlinarith [sq ((Nat.card K - 1) * Nat.card K)]
  · push Not at hcross
    have hχ₁mul := jointEigen_mul hw₁ hev₁
    have hχ₁ne := jointEigen_ne_zero hw₁ hev₁
    have hχ₂mul := jointEigen_mul hw₂ hev₂
    have hχ₂ne := jointEigen_ne_zero hw₂ hev₂
    have hχ₂_left_one : ∀ c : K, χ₂ ⟨Multiplicative.ofAdd ((c, 0), (0, 0)), trivial⟩ = 1 := by
      intro c
      by_cases hc : c = 0
      · subst hc
        have h := hχ₂mul 1 1
        rw [one_mul] at h
        have h3 : χ₂ 1 * (χ₂ 1 - 1) = 0 := by rw [mul_sub, mul_one, ← h, sub_self]
        exact sub_eq_zero.mp ((mul_eq_zero.mp h3).resolve_left (hχ₂ne 1))
      · exact hcross (Units.mk0 c hc)
    let ψ₁ : K → ℂ := fun c => χ₁ ⟨Multiplicative.ofAdd ((c, 0), (0, 0)), trivial⟩
    let η₁ : K → ℂ := fun d => χ₁ ⟨Multiplicative.ofAdd ((0, d), (0, 0)), trivial⟩
    let ψ₂ : K → ℂ := fun c => χ₂ ⟨Multiplicative.ofAdd ((0, 0), (c, 0)), trivial⟩
    let η₂ : K → ℂ := fun d => χ₂ ⟨Multiplicative.ofAdd ((0, 0), (0, d)), trivial⟩
    have hψ₁add : ∀ c d : K, ψ₁ (c + d) = ψ₁ c * ψ₁ d := fun c d => by
      change χ₁ ⟨Multiplicative.ofAdd ((c + d, 0), (0, 0)), trivial⟩ =
        χ₁ ⟨Multiplicative.ofAdd ((c, 0), (0, 0)), trivial⟩ *
          χ₁ ⟨Multiplicative.ofAdd ((d, 0), (0, 0)), trivial⟩
      rw [← hχ₁mul]
      congr 1; apply Subtype.ext; rw [Subgroup.coe_mul, ← ofAdd_add]; simp
    have hψ₂add : ∀ c d : K, ψ₂ (c + d) = ψ₂ c * ψ₂ d := fun c d => by
      change χ₂ ⟨Multiplicative.ofAdd ((0, 0), (c + d, 0)), trivial⟩ =
        χ₂ ⟨Multiplicative.ofAdd ((0, 0), (c, 0)), trivial⟩ *
          χ₂ ⟨Multiplicative.ofAdd ((0, 0), (d, 0)), trivial⟩
      rw [← hχ₂mul]
      congr 1; apply Subtype.ext; rw [Subgroup.coe_mul, ← ofAdd_add]; simp
    have hsplit₁ : ∀ c d : K,
        χ₁ ⟨Multiplicative.ofAdd ((c, d), (0, 0)), trivial⟩ = ψ₁ c * η₁ d := fun c d => by
      change χ₁ ⟨Multiplicative.ofAdd ((c, d), (0, 0)), trivial⟩ =
        χ₁ ⟨Multiplicative.ofAdd ((c, 0), (0, 0)), trivial⟩ *
          χ₁ ⟨Multiplicative.ofAdd ((0, d), (0, 0)), trivial⟩
      rw [← hχ₁mul]
      congr 1; apply Subtype.ext; rw [Subgroup.coe_mul, ← ofAdd_add]; simp
    have hsplit₂ : ∀ c d : K,
        χ₂ ⟨Multiplicative.ofAdd ((0, 0), (c, d)), trivial⟩ = ψ₂ c * η₂ d := fun c d => by
      change χ₂ ⟨Multiplicative.ofAdd ((0, 0), (c, d)), trivial⟩ =
        χ₂ ⟨Multiplicative.ofAdd ((0, 0), (c, 0)), trivial⟩ *
          χ₂ ⟨Multiplicative.ofAdd ((0, 0), (0, d)), trivial⟩
      rw [← hχ₂mul]
      congr 1; apply Subtype.ext; rw [Subgroup.coe_mul, ← ofAdd_add]; simp
    let w : Option ((Kˣ × K) ⊕ (Kˣ × K)) → (Λ → ℂ)
      | none => fun _ => 1
      | some (Sum.inl x) => permFunHom Λ (π (g (x, (1, 0)))⁻¹) w₁
      | some (Sum.inr x) => permFunHom Λ (π (g ((1, 0), x))⁻¹) w₂
    let χ' : Option ((Kˣ × K) ⊕ (Kˣ × K)) → A → ℂ
      | none => fun _ => 1
      | some (Sum.inl x) =>
          fun m => χ₁ ⟨Multiplicative.ofAdd (twoHeisConjMap r₁ r₂ (x, (1, 0)) m.1.toAdd), trivial⟩
      | some (Sum.inr x) =>
          fun m => χ₂ ⟨Multiplicative.ofAdd (twoHeisConjMap r₁ r₂ ((1, 0), x) m.1.toAdd), trivial⟩
    have hw : ∀ i, w i ≠ 0 := by
      rintro (_ | x | x)
      · rcases hΛ with ⟨x₀⟩
        exact fun h => one_ne_zero (congrFun h x₀)
      · exact jointEigen_conj_ne_zero π hw₁ (g (x, (1, 0)))
      · exact jointEigen_conj_ne_zero π hw₂ (g ((1, 0), x))
    have hev : ∀ i (m : A), ρ m (w i) = χ' i m • w i := by
      rintro (_ | x | x) m
      · ext x₀; simp [w, χ', ρ, permFunHom_apply]
      · exact jointEigen_conj_ev π φ g r₁ r₂ hgconj hev₁ (x, (1, 0)) m
      · exact jointEigen_conj_ev π φ g r₁ r₂ hgconj hev₂ ((1, 0), x) m
    have hχ'inj : Function.Injective χ' := by
      rintro (_ | x | x) (_ | y | y) hxy
      · rfl
      · exfalso
        have h1 := congrFun hxy ⟨Multiplicative.ofAdd ((((y.1⁻¹ : Kˣ) : K), 0), (0, 0)), trivial⟩
        simp only [χ', twoHeisConjMap, toAdd_ofAdd, mul_zero, zero_mul, add_zero,
          Units.mul_inv] at h1
        exact hχ₁u₁ h1.symm
      · exfalso
        have h1 := congrFun hxy ⟨Multiplicative.ofAdd ((0, 0), (((y.1⁻¹ : Kˣ) : K), 0)), trivial⟩
        simp only [χ', twoHeisConjMap, toAdd_ofAdd, mul_zero, zero_mul, add_zero,
          Units.mul_inv] at h1
        exact hχ₂u₂ h1.symm
      · exfalso
        have h1 := congrFun hxy ⟨Multiplicative.ofAdd ((((x.1⁻¹ : Kˣ) : K), 0), (0, 0)), trivial⟩
        simp only [χ', twoHeisConjMap, toAdd_ofAdd, mul_zero, zero_mul, add_zero,
          Units.mul_inv] at h1
        exact hχ₁u₁ h1
      · congr 2
        have hu : x.1 = y.1 :=
          xi_eq_imp_u_eq hψ₁add (fun _ => hχ₁ne _) (c₀ := 1) hχ₁u₁ fun c => by
            simpa [χ', twoHeisConjMap, ψ₁] using
              congrFun hxy ⟨Multiplicative.ofAdd ((c, 0), (0, 0)), trivial⟩
        have hv : x.2 = y.2 :=
          xi_eq_imp_v_eq (η := η₁) hψ₁add (fun _ => hχ₁ne _) (fun _ => hχ₁ne _) (c₀ := 1) hχ₁u₁
            (r₁ (x.1, 1)) fun d => by
              have h1 := congrFun hxy ⟨Multiplicative.ofAdd ((0, d), (0, 0)), trivial⟩
              simp only [χ', twoHeisConjMap, toAdd_ofAdd, mul_zero, zero_add, ← hu] at h1
              rwa [hsplit₁, hsplit₁] at h1
        exact Prod.ext hu hv
      · exfalso
        have h1 := congrFun hxy ⟨Multiplicative.ofAdd ((((x.1⁻¹ : Kˣ) : K), 0), (0, 0)), trivial⟩
        simp only [χ', twoHeisConjMap, toAdd_ofAdd, mul_zero, zero_mul, add_zero, Units.mul_inv,
          Units.val_one, one_mul] at h1
        rw [hχ₂_left_one] at h1
        exact hχ₁u₁ h1
      · exfalso
        have h1 := congrFun hxy ⟨Multiplicative.ofAdd ((0, 0), (((x.1⁻¹ : Kˣ) : K), 0)), trivial⟩
        simp only [χ', twoHeisConjMap, toAdd_ofAdd, mul_zero, zero_mul, add_zero,
          Units.mul_inv] at h1
        exact hχ₂u₂ h1
      · exfalso
        have h1 := congrFun hxy ⟨Multiplicative.ofAdd ((((y.1⁻¹ : Kˣ) : K), 0), (0, 0)), trivial⟩
        simp only [χ', twoHeisConjMap, toAdd_ofAdd, mul_zero, zero_mul, add_zero, Units.mul_inv,
          Units.val_one, one_mul] at h1
        rw [hχ₂_left_one] at h1
        exact hχ₁u₁ h1.symm
      · congr 2
        have hu : x.1 = y.1 :=
          xi_eq_imp_u_eq hψ₂add (fun _ => hχ₂ne _) (c₀ := 1) hχ₂u₂ fun c => by
            simpa [χ', twoHeisConjMap, ψ₂] using
              congrFun hxy ⟨Multiplicative.ofAdd ((0, 0), (c, 0)), trivial⟩
        have hv : x.2 = y.2 :=
          xi_eq_imp_v_eq (η := η₂) hψ₂add (fun _ => hχ₂ne _) (fun _ => hχ₂ne _) (c₀ := 1) hχ₂u₂
            (r₂ (1, x.1)) fun d => by
              have h1 := congrFun hxy ⟨Multiplicative.ofAdd ((0, 0), (0, d)), trivial⟩
              simp only [χ', twoHeisConjMap, toAdd_ofAdd, mul_zero, zero_add, ← hu] at h1
              rwa [hsplit₂, hsplit₂] at h1
        exact Prod.ext hu hv
    have hli := linearIndependent_of_distinct_weights ρ A hA w χ' hw hev hχ'inj
    have hcard := hli.fintype_card_le_finrank
    rw [Module.finrank_fintype_fun_eq_card, Fintype.card_option, Fintype.card_sum,
      Fintype.card_prod, ← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card,
      ← Nat.card_eq_fintype_card, Nat.card_units, ← two_mul] at hcard
    exact hcard

private theorem sq_card_sub_one_mul_card_add_one_le_card_of_two_heis_of_moved
    {S Λ : Type*} [Group S] [Finite Λ] (π : S →* Equiv.Perm Λ)
    {K : Type} [Field K] [Finite K]
    (φ : Multiplicative ((K × K) × (K × K)) →* S)
    (g : (Kˣ × K) × (Kˣ × K) → S) (r₁ r₂ : Kˣ × Kˣ → Kˣ)
    (hgconj : ∀ x m, g x * φ (Multiplicative.ofAdd m) * (g x)⁻¹ =
      φ (Multiplicative.ofAdd (twoHeisConjMap r₁ r₂ x m)))
    {x₀ : Λ}
    (hx₁ : π (φ (Multiplicative.ofAdd ((1, 0), (0, 0)))) x₀ ≠ x₀)
    (hx₂ : π (φ (Multiplicative.ofAdd ((0, 0), (1, 0)))) x₀ ≠ x₀) :
    ((Nat.card K - 1) * Nat.card K) ^ 2 + 1 ≤ Nat.card Λ := by
  classical
  have : Fintype Λ := Fintype.ofFinite Λ
  let U := Multiplicative ((K × K) × (K × K))
  let A : Subgroup U := ⊤
  let ρ : U →* Module.End ℂ (Λ → ℂ) := ((permFunHom Λ).comp π).comp φ
  have hA : IsMulCommutative A := inferInstance
  have hinv : (Nat.card A : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr Nat.card_pos.ne'
  let u₁ : U := Multiplicative.ofAdd ((1, 0), (0, 0))
  let u₂ : U := Multiplicative.ofAdd ((0, 0), (1, 0))
  have hT : (ρ u₁ - 1) * (ρ u₂ - 1) ≠ 0 := by
    intro h0
    let f : Λ → ℂ := Pi.single x₀ 1
    have h1 := congrFun (LinearMap.congr_fun h0 f) x₀
    let σ₁ := π (φ u₁)
    let σ₂ := π (φ u₂)
    have hσ₁ : σ₁⁻¹ x₀ ≠ x₀ := fun h => hx₁ (by simpa using (Equiv.Perm.inv_eq_iff_eq.1 h).symm)
    have hσ₂ : σ₂⁻¹ x₀ ≠ x₀ := fun h => hx₂ (by simpa using (Equiv.Perm.inv_eq_iff_eq.1 h).symm)
    change (f (σ₂⁻¹ (σ₁⁻¹ x₀)) - f (σ₁⁻¹ x₀)) - (f (σ₂⁻¹ x₀) - f x₀) = 0 at h1
    simp only [f, Pi.single_eq_of_ne hσ₁, Pi.single_eq_of_ne hσ₂, Pi.single_eq_same, sub_zero,
      zero_sub, sub_neg_eq_add] at h1
    by_cases h12 : σ₂⁻¹ (σ₁⁻¹ x₀) = x₀
    · rw [h12, Pi.single_eq_same] at h1
      norm_num at h1
    · rw [Pi.single_eq_of_ne h12, zero_add] at h1
      exact one_ne_zero h1
  obtain ⟨χ₀, w₀, hev₀, hTw₀⟩ :=
    exists_jointEigenvector_apply_ne_zero ρ A hA hinv ((ρ u₁ - 1) * (ρ u₂ - 1)) hT
  have hw₀ : w₀ ≠ 0 := by rintro rfl; exact hTw₀ (map_zero _)
  have hχu₁ : χ₀ ⟨u₁, trivial⟩ ≠ 1 := by
    intro h
    apply hTw₀
    have h2 : (ρ u₂ - 1) w₀ = (χ₀ ⟨u₂, trivial⟩ - 1) • w₀ := by
      rw [LinearMap.sub_apply, hev₀ ⟨u₂, trivial⟩, Module.End.one_apply, sub_smul, one_smul]
    rw [Module.End.mul_apply, h2, map_smul, LinearMap.sub_apply, hev₀ ⟨u₁, trivial⟩, h,
      one_smul, Module.End.one_apply, sub_self, smul_zero]
  have hχu₂ : χ₀ ⟨u₂, trivial⟩ ≠ 1 := by
    intro h
    apply hTw₀
    have h2 : (ρ u₂ - 1) w₀ = 0 := by
      rw [LinearMap.sub_apply, hev₀ ⟨u₂, trivial⟩, h, one_smul, Module.End.one_apply, sub_self]
    rw [Module.End.mul_apply, h2, map_zero]
  exact sq_card_sub_one_mul_card_add_one_le_card_of_two_heis_eigenvector π φ g r₁ r₂ hgconj
    ⟨x₀⟩ χ₀ w₀ hw₀ hev₀ (c₀ := 1) hχu₁ hχu₂

/-! ### Specialization of the two-system bound to `G₂` in characteristic `3` -/

private theorem g2X_comm_0_3 {K : Type} [Field K] (h3 : (3 : K) = 0) (x y : K) :
    g2X 3 y * g2X 0 x = g2X 0 x * g2X 3 y :=
  Subtype.ext (show smallReeX K 3 y * smallReeX K 0 x = smallReeX K 0 x * smallReeX K 3 y by
    simpa using smallRee_comm_mul h3 (i := 0) (j := 3) (by decide) x y 1)

private theorem g2X_comm_0_4 {K : Type} [Field K] (h3 : (3 : K) = 0) (x y : K) :
    g2X 4 y * g2X 0 x = g2X 0 x * g2X 4 y :=
  Subtype.ext (show smallReeX K 4 y * smallReeX K 0 x = smallReeX K 0 x * smallReeX K 4 y by
    simpa using smallRee_comm_mul h3 (i := 0) (j := 4) (by decide) x y 1)

private theorem g2X_comm_0_5 {K : Type} [Field K] (h3 : (3 : K) = 0) (x y : K) :
    g2X 5 y * g2X 0 x = g2X 0 x * g2X 5 y :=
  Subtype.ext (show smallReeX K 5 y * smallReeX K 0 x = smallReeX K 0 x * smallReeX K 5 y by
    simpa using smallRee_comm_mul h3 (i := 0) (j := 5) (by decide) x y 1)

private theorem g2X_comm_2_3 {K : Type} [Field K] (h3 : (3 : K) = 0) (x y : K) :
    g2X 3 y * g2X 2 x = g2X 2 x * g2X 3 y :=
  Subtype.ext (show smallReeX K 3 y * smallReeX K 2 x = smallReeX K 2 x * smallReeX K 3 y by
    simpa using smallRee_comm_mul h3 (i := 2) (j := 3) (by decide) x y 1)

private theorem g2X_conj_0_2 {K : Type} [Field K] (h3 : (3 : K) = 0) (x y : K) :
    g2X 0 x * g2X 2 y * (g2X 0 x)⁻¹ = g2X 2 y * g2X 3 (x * y) := by
  have h : g2X 2 y * g2X 0 (-x) = g2X 0 (-x) * g2X 2 y * g2X 3 (-(-x * y)) :=
    Subtype.ext (show smallReeX K 2 y * smallReeX K 0 (-x) =
        smallReeX K 0 (-x) * smallReeX K 2 y * smallReeX K 3 (-(-x * y)) by
      simpa [mul_assoc] using smallRee_swap02_mul h3 (-x) y 1)
  rw [neg_mul, neg_neg, ← g2X_neg] at h
  calc g2X 0 x * g2X 2 y * (g2X 0 x)⁻¹
      = g2X 0 x * (g2X 2 y * (g2X 0 x)⁻¹) := by group
    _ = g2X 0 x * ((g2X 0 x)⁻¹ * g2X 2 y * g2X 3 (x * y)) := by rw [h]
    _ = g2X 2 y * g2X 3 (x * y) := by group

private noncomputable def g2Hom32 (K : Type) [Field K] (h3 : (3 : K) = 0) :
    Multiplicative (K × K) →* ↥(adjointGroup Tag.G2 K) where
  toFun u := g2X 3 u.toAdd.1 * g2X 2 u.toAdd.2
  map_one' := by
    change g2X 3 0 * g2X 2 0 = 1
    rw [g2X_zero, g2X_zero, mul_one]
  map_mul' u v := by
    change g2X 3 (u.toAdd.1 + v.toAdd.1) * g2X 2 (u.toAdd.2 + v.toAdd.2) =
      (g2X 3 u.toAdd.1 * g2X 2 u.toAdd.2) * (g2X 3 v.toAdd.1 * g2X 2 v.toAdd.2)
    rw [g2X_add, g2X_add]
    calc g2X 3 u.toAdd.1 * g2X 3 v.toAdd.1 * (g2X 2 u.toAdd.2 * g2X 2 v.toAdd.2)
        = g2X 3 u.toAdd.1 * (g2X 3 v.toAdd.1 * g2X 2 u.toAdd.2) * g2X 2 v.toAdd.2 := by group
      _ = g2X 3 u.toAdd.1 * (g2X 2 u.toAdd.2 * g2X 3 v.toAdd.1) * g2X 2 v.toAdd.2 := by
        rw [g2X_comm_2_3 h3]
      _ = (g2X 3 u.toAdd.1 * g2X 2 u.toAdd.2) * (g2X 3 v.toAdd.1 * g2X 2 v.toAdd.2) := by group

private noncomputable def g2Hom54 (K : Type) [Field K] :
    Multiplicative (K × K) →* ↥(adjointGroup Tag.G2 K) where
  toFun u := g2X 5 u.toAdd.1 * g2X 4 u.toAdd.2
  map_one' := by
    change g2X 5 0 * g2X 4 0 = 1
    rw [g2X_zero, g2X_zero, mul_one]
  map_mul' u v := by
    change g2X 5 (u.toAdd.1 + v.toAdd.1) * g2X 4 (u.toAdd.2 + v.toAdd.2) =
      (g2X 5 u.toAdd.1 * g2X 4 u.toAdd.2) * (g2X 5 v.toAdd.1 * g2X 4 v.toAdd.2)
    rw [g2X_add, g2X_add]
    calc g2X 5 u.toAdd.1 * g2X 5 v.toAdd.1 * (g2X 4 u.toAdd.2 * g2X 4 v.toAdd.2)
        = g2X 5 u.toAdd.1 * (g2X 5 v.toAdd.1 * g2X 4 u.toAdd.2) * g2X 4 v.toAdd.2 := by group
      _ = g2X 5 u.toAdd.1 * (g2X 4 u.toAdd.2 * g2X 5 v.toAdd.1) * g2X 4 v.toAdd.2 := by
        rw [g2X_comm_4_5]
      _ = (g2X 5 u.toAdd.1 * g2X 4 u.toAdd.2) * (g2X 5 v.toAdd.1 * g2X 4 v.toAdd.2) := by group

private theorem g2Hom32_comm_g2Hom54 {K : Type} [Field K] (h3 : (3 : K) = 0)
    (u v : Multiplicative (K × K)) :
    g2Hom32 K h3 u * g2Hom54 K v = g2Hom54 K v * g2Hom32 K h3 u := by
  change (g2X 3 u.toAdd.1 * g2X 2 u.toAdd.2) * (g2X 5 v.toAdd.1 * g2X 4 v.toAdd.2) =
    (g2X 5 v.toAdd.1 * g2X 4 v.toAdd.2) * (g2X 3 u.toAdd.1 * g2X 2 u.toAdd.2)
  have h254 : g2X 2 u.toAdd.2 * (g2X 5 v.toAdd.1 * g2X 4 v.toAdd.2) =
      (g2X 5 v.toAdd.1 * g2X 4 v.toAdd.2) * g2X 2 u.toAdd.2 := by
    rw [← mul_assoc, ← g2X_comm_2_5, mul_assoc, ← g2X_comm_2_4, ← mul_assoc]
  have h354 : g2X 3 u.toAdd.1 * (g2X 5 v.toAdd.1 * g2X 4 v.toAdd.2) =
      (g2X 5 v.toAdd.1 * g2X 4 v.toAdd.2) * g2X 3 u.toAdd.1 := by
    rw [← mul_assoc, ← g2X_comm_3_5, mul_assoc, ← g2X_comm_3_4, ← mul_assoc]
  rw [mul_assoc, h254, ← mul_assoc, h354, mul_assoc]

private noncomputable def g2Hom3254 (K : Type) [Field K] (h3 : (3 : K) = 0) :
    Multiplicative ((K × K) × (K × K)) →* ↥(adjointGroup Tag.G2 K) where
  toFun m := g2Hom32 K h3 (Multiplicative.ofAdd m.toAdd.1) *
    g2Hom54 K (Multiplicative.ofAdd m.toAdd.2)
  map_one' := by
    change g2Hom32 K h3 1 * g2Hom54 K 1 = 1
    rw [map_one, map_one, mul_one]
  map_mul' m n := by
    change g2Hom32 K h3 (Multiplicative.ofAdd m.toAdd.1 * Multiplicative.ofAdd n.toAdd.1) *
      g2Hom54 K (Multiplicative.ofAdd m.toAdd.2 * Multiplicative.ofAdd n.toAdd.2) = _
    rw [map_mul, map_mul]
    calc (g2Hom32 K h3 (Multiplicative.ofAdd m.toAdd.1) *
            g2Hom32 K h3 (Multiplicative.ofAdd n.toAdd.1)) *
          (g2Hom54 K (Multiplicative.ofAdd m.toAdd.2) *
            g2Hom54 K (Multiplicative.ofAdd n.toAdd.2))
        = g2Hom32 K h3 (Multiplicative.ofAdd m.toAdd.1) *
          (g2Hom32 K h3 (Multiplicative.ofAdd n.toAdd.1) *
            g2Hom54 K (Multiplicative.ofAdd m.toAdd.2)) *
          g2Hom54 K (Multiplicative.ofAdd n.toAdd.2) := by group
      _ = _ := by rw [g2Hom32_comm_g2Hom54 h3]; group

private noncomputable def g2TwoHeisG {K : Type} [Field K]
    (x : (Kˣ × K) × (Kˣ × K)) : ↥(adjointGroup Tag.G2 K) :=
  g2X 0 x.1.2 * g2X 1 x.2.2 * g2TorusHom (x.2.1, x.1.1)

private noncomputable def g2TwoHeisR1 {K : Type} [Field K] (p : Kˣ × Kˣ) : Kˣ :=
  rootChar K (smallReeRoot 2) (g2TorusVec p.2 p.1)

private noncomputable def g2TwoHeisR2 {K : Type} [Field K] (p : Kˣ × Kˣ) : Kˣ :=
  rootChar K (smallReeRoot 4) (g2TorusVec p.2 p.1)

private theorem g2TwoHeis_conj {K : Type} [Field K] (h3 : (3 : K) = 0)
    (x : (Kˣ × K) × (Kˣ × K)) (m : (K × K) × (K × K)) :
    g2TwoHeisG x * g2Hom3254 K h3 (Multiplicative.ofAdd m) * (g2TwoHeisG x)⁻¹ =
      g2Hom3254 K h3 (Multiplicative.ofAdd (twoHeisConjMap g2TwoHeisR1 g2TwoHeisR2 x m)) := by
  have ht1 : ∀ c d : K,
      g2TorusHom (x.2.1, x.1.1) * g2Hom32 K h3 (Multiplicative.ofAdd (c, d)) *
        (g2TorusHom (x.2.1, x.1.1))⁻¹ =
        g2Hom32 K h3 (Multiplicative.ofAdd ((x.1.1 : K) * c,
          (g2TwoHeisR1 (x.1.1, x.2.1) : K) * d)) := fun c d => by
    change g2TorusHom (x.2.1, x.1.1) * (g2X 3 c * g2X 2 d) * (g2TorusHom (x.2.1, x.1.1))⁻¹ = _
    calc g2TorusHom (x.2.1, x.1.1) * (g2X 3 c * g2X 2 d) * (g2TorusHom (x.2.1, x.1.1))⁻¹
        = (g2TorusHom (x.2.1, x.1.1) * g2X 3 c * (g2TorusHom (x.2.1, x.1.1))⁻¹) *
          (g2TorusHom (x.2.1, x.1.1) * g2X 2 d * (g2TorusHom (x.2.1, x.1.1))⁻¹) := by group
      _ = _ := by rw [g2TorusHom_conj_g2X_3, g2TorusHom_conj_g2X]; rfl
  have ht2 : ∀ c d : K,
      g2TorusHom (x.2.1, x.1.1) * g2Hom54 K (Multiplicative.ofAdd (c, d)) *
        (g2TorusHom (x.2.1, x.1.1))⁻¹ =
        g2Hom54 K (Multiplicative.ofAdd ((x.2.1 : K) * c,
          (g2TwoHeisR2 (x.1.1, x.2.1) : K) * d)) := fun c d => by
    change g2TorusHom (x.2.1, x.1.1) * (g2X 5 c * g2X 4 d) * (g2TorusHom (x.2.1, x.1.1))⁻¹ = _
    calc g2TorusHom (x.2.1, x.1.1) * (g2X 5 c * g2X 4 d) * (g2TorusHom (x.2.1, x.1.1))⁻¹
        = (g2TorusHom (x.2.1, x.1.1) * g2X 5 c * (g2TorusHom (x.2.1, x.1.1))⁻¹) *
          (g2TorusHom (x.2.1, x.1.1) * g2X 4 d * (g2TorusHom (x.2.1, x.1.1))⁻¹) := by group
      _ = _ := by rw [g2TorusHom_conj_g2X_5, g2TorusHom_conj_g2X]; rfl
  have hb1_32 : ∀ v c d : K,
      g2X 1 v * g2Hom32 K h3 (Multiplicative.ofAdd (c, d)) * (g2X 1 v)⁻¹ =
        g2Hom32 K h3 (Multiplicative.ofAdd (c, d)) := fun v c d => by
    change g2X 1 v * (g2X 3 c * g2X 2 d) * (g2X 1 v)⁻¹ = g2X 3 c * g2X 2 d
    calc g2X 1 v * (g2X 3 c * g2X 2 d) * (g2X 1 v)⁻¹
        = (g2X 1 v * g2X 3 c) * g2X 2 d * (g2X 1 v)⁻¹ := by group
      _ = g2X 3 c * (g2X 1 v * g2X 2 d) * (g2X 1 v)⁻¹ := by rw [← g2X_comm_1_3]; group
      _ = g2X 3 c * (g2X 2 d * g2X 1 v) * (g2X 1 v)⁻¹ := by rw [← g2X_comm_1_2]
      _ = g2X 3 c * g2X 2 d := by group
  have hb1_54 : ∀ v c d : K,
      g2X 1 v * g2Hom54 K (Multiplicative.ofAdd (c, d)) * (g2X 1 v)⁻¹ =
        g2Hom54 K (Multiplicative.ofAdd (c + d * v, d)) := fun v c d => by
    change g2X 1 v * (g2X 5 c * g2X 4 d) * (g2X 1 v)⁻¹ = g2X 5 (c + d * v) * g2X 4 d
    calc g2X 1 v * (g2X 5 c * g2X 4 d) * (g2X 1 v)⁻¹
        = (g2X 1 v * g2X 5 c) * g2X 4 d * (g2X 1 v)⁻¹ := by group
      _ = g2X 5 c * (g2X 1 v * g2X 4 d * (g2X 1 v)⁻¹) := by rw [← g2X_comm_1_5]; group
      _ = g2X 5 c * (g2X 4 d * g2X 5 (v * d)) := by rw [g2X_conj_1_4]
      _ = (g2X 5 c * g2X 5 (v * d)) * g2X 4 d := by
        rw [← mul_assoc, mul_assoc (g2X 5 c), ← g2X_comm_4_5, ← mul_assoc]
      _ = g2X 5 (c + d * v) * g2X 4 d := by rw [← g2X_add, mul_comm v d]
  have hb0_32 : ∀ v c d : K,
      g2X 0 v * g2Hom32 K h3 (Multiplicative.ofAdd (c, d)) * (g2X 0 v)⁻¹ =
        g2Hom32 K h3 (Multiplicative.ofAdd (c + d * v, d)) := fun v c d => by
    change g2X 0 v * (g2X 3 c * g2X 2 d) * (g2X 0 v)⁻¹ = g2X 3 (c + d * v) * g2X 2 d
    calc g2X 0 v * (g2X 3 c * g2X 2 d) * (g2X 0 v)⁻¹
        = (g2X 0 v * g2X 3 c) * g2X 2 d * (g2X 0 v)⁻¹ := by group
      _ = g2X 3 c * (g2X 0 v * g2X 2 d * (g2X 0 v)⁻¹) := by rw [← g2X_comm_0_3 h3]; group
      _ = g2X 3 c * (g2X 2 d * g2X 3 (v * d)) := by rw [g2X_conj_0_2 h3]
      _ = (g2X 3 c * g2X 3 (v * d)) * g2X 2 d := by
        rw [← mul_assoc, mul_assoc (g2X 3 c), ← g2X_comm_2_3 h3, ← mul_assoc]
      _ = g2X 3 (c + d * v) * g2X 2 d := by rw [← g2X_add, mul_comm v d]
  have hb0_54 : ∀ v c d : K,
      g2X 0 v * g2Hom54 K (Multiplicative.ofAdd (c, d)) * (g2X 0 v)⁻¹ =
        g2Hom54 K (Multiplicative.ofAdd (c, d)) := fun v c d => by
    change g2X 0 v * (g2X 5 c * g2X 4 d) * (g2X 0 v)⁻¹ = g2X 5 c * g2X 4 d
    calc g2X 0 v * (g2X 5 c * g2X 4 d) * (g2X 0 v)⁻¹
        = (g2X 0 v * g2X 5 c) * g2X 4 d * (g2X 0 v)⁻¹ := by group
      _ = g2X 5 c * (g2X 0 v * g2X 4 d) * (g2X 0 v)⁻¹ := by rw [← g2X_comm_0_5 h3]; group
      _ = g2X 5 c * (g2X 4 d * g2X 0 v) * (g2X 0 v)⁻¹ := by rw [← g2X_comm_0_4 h3]
      _ = g2X 5 c * g2X 4 d := by group
  change (g2X 0 x.1.2 * g2X 1 x.2.2 * g2TorusHom (x.2.1, x.1.1)) *
      (g2Hom32 K h3 (Multiplicative.ofAdd m.1) * g2Hom54 K (Multiplicative.ofAdd m.2)) *
      (g2X 0 x.1.2 * g2X 1 x.2.2 * g2TorusHom (x.2.1, x.1.1))⁻¹ = _
  calc (g2X 0 x.1.2 * g2X 1 x.2.2 * g2TorusHom (x.2.1, x.1.1)) *
        (g2Hom32 K h3 (Multiplicative.ofAdd m.1) * g2Hom54 K (Multiplicative.ofAdd m.2)) *
        (g2X 0 x.1.2 * g2X 1 x.2.2 * g2TorusHom (x.2.1, x.1.1))⁻¹
      = (g2X 0 x.1.2 * (g2X 1 x.2.2 * (g2TorusHom (x.2.1, x.1.1) *
          g2Hom32 K h3 (Multiplicative.ofAdd m.1) * (g2TorusHom (x.2.1, x.1.1))⁻¹) *
          (g2X 1 x.2.2)⁻¹) * (g2X 0 x.1.2)⁻¹) *
        (g2X 0 x.1.2 * (g2X 1 x.2.2 * (g2TorusHom (x.2.1, x.1.1) *
          g2Hom54 K (Multiplicative.ofAdd m.2) * (g2TorusHom (x.2.1, x.1.1))⁻¹) *
          (g2X 1 x.2.2)⁻¹) * (g2X 0 x.1.2)⁻¹) := by group
    _ = _ := by
      rw [ht1 m.1.1 m.1.2, ht2 m.2.1 m.2.2, hb1_32, hb1_54, hb0_32, hb0_54]
      rfl

private theorem g2Hom3254_inl_eq {K : Type} [Field K] (h3 : (3 : K) = 0) :
    g2Hom3254 K h3 (Multiplicative.ofAdd ((1, 0), (0, 0))) = g2X 3 1 := by
  have h1 : g2Hom3254 K h3 (Multiplicative.ofAdd ((1, 0), (0, 0))) =
      (g2X 3 1 * g2X 2 0) * (g2X 5 0 * g2X 4 0) := rfl
  rw [h1, g2X_zero, g2X_zero, g2X_zero, mul_one, mul_one, mul_one]

private theorem g2Hom3254_inr_eq {K : Type} [Field K] (h3 : (3 : K) = 0) :
    g2Hom3254 K h3 (Multiplicative.ofAdd ((0, 0), (1, 0))) = g2X 5 1 := by
  have h1 : g2Hom3254 K h3 (Multiplicative.ofAdd ((0, 0), (1, 0))) =
      (g2X 3 0 * g2X 2 0) * (g2X 5 1 * g2X 4 0) := rfl
  rw [h1, g2X_zero, g2X_zero, g2X_zero, mul_one, mul_one, one_mul]

private theorem three_le_card_of_three_eq_zero {K : Type} [Field K] [Finite K]
    (h3 : (3 : K) = 0) : 3 ≤ Nat.card K := by
  have h2 : (2 : K) ≠ 0 := fun h20 => one_ne_zero (by linear_combination h3 - h20)
  have h21 : (2 : K) ≠ 1 := fun h => one_ne_zero (by linear_combination h)
  let f : Fin 3 → K := fun i => (i.1 : K)
  have hinj : Function.Injective f := by
    intro i j hij
    fin_cases i <;> fin_cases j <;> simp [f, h2, h2.symm, h21, h21.symm] at hij ⊢
  simpa using Nat.card_le_card_of_injective f hinj

/-- In characteristic `3` (`(3 : K) = 0`), every proper subgroup `M` of `adjointGroup .G2 K` has
index at least `2 * ((Nat.card K - 1) * Nat.card K) + 1`. -/
theorem two_mul_card_sub_one_mul_card_add_one_le_index_g2_of_char_three
    {K : Type} [Field K] [Finite K] [Finite ↥(adjointGroup Tag.G2 K)]
    [IsSimpleGroup ↥(adjointGroup Tag.G2 K)]
    (h3 : (3 : K) = 0) {M : Subgroup ↥(adjointGroup Tag.G2 K)} (hM : M ≠ ⊤) :
    2 * ((Nat.card K - 1) * Nat.card K) + 1 ≤ M.index := by
  have hz3 : g2Hom3254 K h3 (Multiplicative.ofAdd ((1, 0), (0, 0))) ≠ 1 := by
    rw [g2Hom3254_inl_eq h3]
    exact fun h => one_ne_zero (g2X_injective 3 (h.trans (g2X_zero 3).symm))
  have hz5 : g2Hom3254 K h3 (Multiplicative.ofAdd ((0, 0), (1, 0))) ≠ 1 := by
    rw [g2Hom3254_inr_eq h3]
    exact fun h => one_ne_zero (g2X_injective 5 (h.trans (g2X_zero 5).symm))
  rw [Subgroup.index_eq_card]
  exact two_mul_card_sub_one_mul_card_add_one_le_card_of_two_heis
    (MulAction.toPermHom ↥(adjointGroup Tag.G2 K) (↥(adjointGroup Tag.G2 K) ⧸ M))
    (three_le_card_of_three_eq_zero h3)
    (g2Hom3254 K h3) g2TwoHeisG g2TwoHeisR1 g2TwoHeisR2 (g2TwoHeis_conj h3)
    (toPermHom_quotient_ne_one_of_ne_one hM hz3)
    (toPermHom_quotient_ne_one_of_ne_one hM hz5)

/-! ### Degree `36` bound in characteristic `3` via `ZMod 3` Heisenberg-Weyl orbits -/

private theorem zmod3_cases : ∀ u : ZMod 3, u = 0 ∨ u = 1 ∨ u = 2 := by
  decide

private theorem zmod3_conj_all {G : Type*} [Group G] (f g : ZMod 3 → G) (w : G) (s : ZMod 3)
    (hf0 : f 0 = 1) (hfadd : ∀ u v, f (u + v) = f u * f v)
    (hg0 : g 0 = 1) (hgadd : ∀ u v, g (u + v) = g u * g v)
    (hw1 : w⁻¹ * f 1 * w = g s) (u : ZMod 3) :
    w⁻¹ * f u * w = g (s * u) := by
  rcases zmod3_cases u with rfl | rfl | rfl
  · rw [mul_zero, hf0, hg0]; group
  · rw [mul_one, hw1]
  · have h2 : (2 : ZMod 3) = 1 + 1 := rfl
    have hs2 : s * 2 = s + s := (by decide : ∀ x : ZMod 3, x * 2 = x + x) s
    rw [hs2, hgadd, h2, hfadd, ← hw1]
    group

private theorem zmod3_sq_add_sq_eq_zero :
    ∀ a b : ZMod 3, a * (-a) - b * b = 0 → a = 0 ∧ b = 0 := by
  decide

private theorem eighteen_le_card_moved_of_heis_zmod3
    {S Λ : Type*} [Group S] [Finite Λ] (π : S →* Equiv.Perm Λ)
    (x_a x_b z : ZMod 3 → S) (w : S)
    (hxa0 : x_a 0 = 1) (hxa_add : ∀ a₁ a₂, x_a (a₁ + a₂) = x_a a₁ * x_a a₂)
    (hxb0 : x_b 0 = 1) (hxb_add : ∀ b₁ b₂, x_b (b₁ + b₂) = x_b b₁ * x_b b₂)
    (hz0 : z 0 = 1) (hz_add : ∀ c₁ c₂, z (c₁ + c₂) = z c₁ * z c₂)
    (hza : ∀ a c, z c * x_a a = x_a a * z c)
    (hzb : ∀ b c, z c * x_b b = x_b b * z c)
    (hba : ∀ a b, x_b b * x_a a = x_a a * x_b b * z (-(a * b)))
    (hwa : w⁻¹ * x_a 1 * w = x_b (-1))
    (hwb : w⁻¹ * x_b 1 * w = x_a 1)
    (hwz : w⁻¹ * z 1 * w = z 1)
    (hnt : π (z 1) ≠ 1) :
    18 ≤ Nat.card {x : Λ // π (z 1) x ≠ x} := by
  have hwa_all : ∀ a, w⁻¹ * x_a a * w = x_b (-a) := fun a => by
    rw [zmod3_conj_all x_a x_b w (-1) hxa0 hxa_add hxb0 hxb_add hwa a]
    exact congrArg x_b (by revert a; decide)
  have hwb_all : ∀ b, w⁻¹ * x_b b * w = x_a b := fun b => by
    rw [zmod3_conj_all x_b x_a w 1 hxb0 hxb_add hxa0 hxa_add hwb b]
    exact congrArg x_a (by revert b; decide)
  have hwz_all : ∀ c, w⁻¹ * z c * w = z c := fun c => by
    rw [zmod3_conj_all z z w 1 hz0 hz_add hz0 hz_add hwz c]
    exact congrArg z (by revert c; decide)
  let q : ZMod 3 → ZMod 3 → ZMod 3 → S := fun a b c => x_a a * x_b b * z c
  have hq0 : q 0 0 0 = 1 := by simp [q, hxa0, hxb0, hz0]
  have hq_mul : ∀ a₁ b₁ c₁ a₂ b₂ c₂ : ZMod 3,
      q a₁ b₁ c₁ * q a₂ b₂ c₂ = q (a₁ + a₂) (b₁ + b₂) (c₁ + c₂ - a₂ * b₁) := by
    intro a₁ b₁ c₁ a₂ b₂ c₂
    calc x_a a₁ * x_b b₁ * z c₁ * (x_a a₂ * x_b b₂ * z c₂)
        = x_a a₁ * x_b b₁ * (z c₁ * x_a a₂) * x_b b₂ * z c₂ := by group
      _ = x_a a₁ * (x_b b₁ * x_a a₂) * (z c₁ * x_b b₂) * z c₂ := by rw [hza]; group
      _ = x_a a₁ * (x_a a₂ * x_b b₁ * z (-(a₂ * b₁))) * (x_b b₂ * z c₁) * z c₂ := by
        rw [hba, hzb]
      _ = (x_a a₁ * x_a a₂) * (x_b b₁ * (z (-(a₂ * b₁)) * x_b b₂)) * (z c₁ * z c₂) := by group
      _ = (x_a a₁ * x_a a₂) * (x_b b₁ * x_b b₂) * (z (-(a₂ * b₁)) * (z c₁ * z c₂)) := by
        rw [hzb]; group
      _ = q (a₁ + a₂) (b₁ + b₂) (c₁ + c₂ - a₂ * b₁) := by
        simp only [q, ← hxa_add, ← hxb_add, ← hz_add]
        congr 1
        exact congrArg z (by revert a₂ b₁ c₁ c₂; decide)
  have hq_inv : ∀ a b c : ZMod 3, (q a b c)⁻¹ = q (-a) (-b) (-c - a * b) := by
    intro a b c
    refine inv_eq_of_mul_eq_one_right ?_
    rw [hq_mul]
    have ha : a + -a = 0 := by revert a; decide
    have hb : b + -b = 0 := by revert b; decide
    have hc : c + (-c - a * b) - -a * b = 0 := by revert a b c; decide
    rw [ha, hb, hc, hq0]
  have hq_comm_z : ∀ a b c d : ZMod 3, z d * q a b c = q a b c * z d := by
    intro a b c d
    have hzc : z d * z c = z c * z d := by
      rw [← hz_add, ← hz_add]
      exact congrArg z (by revert c d; decide)
    calc z d * (x_a a * x_b b * z c)
        = (z d * x_a a) * x_b b * z c := by group
      _ = x_a a * (z d * x_b b) * z c := by rw [hza]; group
      _ = x_a a * x_b b * (z d * z c) := by rw [hzb]; group
      _ = x_a a * x_b b * z c * z d := by rw [hzc]; group
  have hw_conj_q : ∀ a b c : ZMod 3, w⁻¹ * q a b c * w = q b (-a) (c + a * b) := by
    intro a b c
    calc w⁻¹ * (x_a a * x_b b * z c) * w
        = (w⁻¹ * x_a a * w) * (w⁻¹ * x_b b * w) * (w⁻¹ * z c * w) := by group
      _ = (x_b (-a) * x_a b) * z c := by rw [hwa_all, hwb_all, hwz_all]
      _ = x_a b * x_b (-a) * (z (-(b * -a)) * z c) := by rw [hba]; group
      _ = q b (-a) (c + a * b) := by
        simp only [q, ← hz_add]
        congr 1
        exact congrArg z (by revert a b c; decide)
  obtain ⟨x₀, hx₀⟩ : ∃ x₀ : Λ, π (z 1) x₀ ≠ x₀ := by
    by_contra! h
    exact hnt (Equiv.ext h)
  have hz_fix : ∀ c : ZMod 3, π (z c) x₀ = x₀ → c = 0 := by
    intro c hc
    rcases zmod3_cases c with rfl | rfl | rfl
    · rfl
    · exact False.elim (hx₀ hc)
    · exfalso
      apply hx₀
      have h21 : (1 : ZMod 3) + 2 = 0 := rfl
      have h1 : z 1 * z 2 = 1 := by rw [← hz_add, h21, hz0]
      have h2 : π (z 1) (π (z 2) x₀) = x₀ := by
        rw [← Equiv.Perm.mul_apply, ← map_mul, h1, map_one, Equiv.Perm.one_apply]
      rwa [hc] at h2
  have hdet_zero : ∀ a₁ b₁ c₁ a₂ b₂ c₂ : ZMod 3,
      π (q a₁ b₁ c₁) x₀ = x₀ → π (q a₂ b₂ c₂) x₀ = x₀ → a₁ * b₂ - a₂ * b₁ = 0 := by
    intro a₁ b₁ c₁ a₂ b₂ c₂ hp₁ hp₂
    set d : ZMod 3 := a₂ * b₁ - a₁ * b₂
    have hcomm : z d * (q a₁ b₁ c₁ * q a₂ b₂ c₂) = q a₂ b₂ c₂ * q a₁ b₁ c₁ := by
      calc z d * (q a₁ b₁ c₁ * q a₂ b₂ c₂)
          = q a₁ b₁ c₁ * (q a₂ b₂ c₂ * z d) := by
            rw [← mul_assoc, hq_comm_z, mul_assoc, hq_comm_z]
        _ = q a₁ b₁ c₁ * q a₂ b₂ (c₂ + d) := by simp only [q, mul_assoc, ← hz_add]
        _ = q (a₂ + a₁) (b₂ + b₁) (c₂ + c₁ - a₁ * b₂) := by
          rw [hq_mul]
          have ha : a₁ + a₂ = a₂ + a₁ :=
            (by decide : ∀ x y : ZMod 3, x + y = y + x) a₁ a₂
          have hb : b₁ + b₂ = b₂ + b₁ :=
            (by decide : ∀ x y : ZMod 3, x + y = y + x) b₁ b₂
          have hc : c₁ + (c₂ + d) - a₂ * b₁ = c₂ + c₁ - a₁ * b₂ :=
            (by decide : ∀ a₁ b₁ c₁ a₂ b₂ c₂ : ZMod 3,
              c₁ + (c₂ + (a₂ * b₁ - a₁ * b₂)) - a₂ * b₁ = c₂ + c₁ - a₁ * b₂)
              a₁ b₁ c₁ a₂ b₂ c₂
          rw [ha, hb, hc]
        _ = q a₂ b₂ c₂ * q a₁ b₁ c₁ := (hq_mul a₂ b₂ c₂ a₁ b₁ c₁).symm
    have hd0 : d = 0 := by
      apply hz_fix d
      have h1 : π (z d * (q a₁ b₁ c₁ * q a₂ b₂ c₂)) x₀ = π (q a₂ b₂ c₂ * q a₁ b₁ c₁) x₀ := by
        rw [hcomm]
      simpa [hp₁, hp₂] using h1
    exact (by decide : ∀ x y : ZMod 3, y - x = 0 → x - y = 0) (a₁ * b₂) (a₂ * b₁) hd0
  have hq_moved : ∀ a b c : ZMod 3, π (z 1) (π (q a b c) x₀) ≠ π (q a b c) x₀ := by
    intro a b c h
    apply hx₀
    have h1 : π (q a b c) (π (z 1) x₀) = π (q a b c) x₀ := by
      rw [← Equiv.Perm.mul_apply, ← map_mul, ← hq_comm_z a b c 1, map_mul, Equiv.Perm.mul_apply, h]
    exact (π (q a b c)).injective h1
  have hwq_moved : ∀ a b c : ZMod 3, π (z 1) (π (w * q a b c) x₀) ≠ π (w * q a b c) x₀ := by
    intro a b c h
    apply hx₀
    have hwz' : z 1 * w = w * z 1 := by
      calc z 1 * w = w * (w⁻¹ * z 1 * w) := by group
        _ = w * z 1 := by rw [hwz]
    have hcomm : z 1 * (w * q a b c) = (w * q a b c) * z 1 := by
      rw [← mul_assoc, hwz', mul_assoc, hq_comm_z, ← mul_assoc]
    have h1 : π (w * q a b c) (π (z 1) x₀) = π (w * q a b c) x₀ := by
      rw [← Equiv.Perm.mul_apply, ← map_mul, ← hcomm, map_mul, Equiv.Perm.mul_apply, h]
    exact (π (w * q a b c)).injective h1
  let Φ : ZMod 3 × ZMod 3 × ZMod 3 → {x : Λ // π (z 1) x ≠ x} :=
    fun p => ⟨π (q p.1 p.2.1 p.2.2) x₀, hq_moved p.1 p.2.1 p.2.2⟩
  by_cases hΦ : Function.Injective Φ
  · have hcard := Nat.card_le_card_of_injective Φ hΦ
    simp only [Nat.card_prod, Nat.card_zmod] at hcard
    omega
  · obtain ⟨p₁, p₂, hp12, hne12⟩ : ∃ p₁ p₂, Φ p₁ = Φ p₂ ∧ p₁ ≠ p₂ := by
      by_contra! h
      exact hΦ fun x y hxy => h x y hxy
    let a₀ : ZMod 3 := -p₂.1 + p₁.1
    let b₀ : ZMod 3 := -p₂.2.1 + p₁.2.1
    let c₀ : ZMod 3 := -p₂.2.2 - p₂.1 * p₂.2.1 + p₁.2.2 - p₁.1 * (-p₂.2.1)
    have hqp₀ : (q p₂.1 p₂.2.1 p₂.2.2)⁻¹ * q p₁.1 p₁.2.1 p₁.2.2 = q a₀ b₀ c₀ := by
      rw [hq_inv, hq_mul]
    have hp₀_fix : π (q a₀ b₀ c₀) x₀ = x₀ := by
      have hp12_val : π (q p₁.1 p₁.2.1 p₁.2.2) x₀ = π (q p₂.1 p₂.2.1 p₂.2.2) x₀ :=
        congrArg Subtype.val hp12
      rw [← hqp₀, map_mul, map_inv, Equiv.Perm.mul_apply, Equiv.Perm.inv_eq_iff_eq, hp12_val]
    have hp₀_ab_ne : a₀ ≠ 0 ∨ b₀ ≠ 0 := by
      by_contra! hab
      apply hne12
      have ha : p₁.1 = p₂.1 :=
        (by decide : ∀ x y : ZMod 3, -y + x = 0 → x = y) p₁.1 p₂.1 hab.1
      have hb : p₁.2.1 = p₂.2.1 :=
        (by decide : ∀ x y : ZMod 3, -y + x = 0 → x = y) p₁.2.1 p₂.2.1 hab.2
      have hzp₀ : q a₀ b₀ c₀ = z c₀ := by
        show x_a a₀ * x_b b₀ * z c₀ = z c₀
        rw [hab.1, hab.2, hxa0, hxb0, mul_one, one_mul]
      have hc0 : c₀ = 0 := hz_fix c₀ (hzp₀ ▸ hp₀_fix)
      have hc : p₁.2.2 = p₂.2.2 :=
        (by decide : ∀ a₁ a₂ b₂ c₁ c₂ : ZMod 3,
          a₁ = a₂ → -c₂ - a₂ * b₂ + c₁ - a₁ * -b₂ = 0 → c₁ = c₂)
          p₁.1 p₂.1 p₂.2.1 p₁.2.2 p₂.2.2 ha hc0
      exact Prod.ext ha (Prod.ext hb hc)
    have hdisj : ∀ a₁ b₁ c₁ a₂ b₂ c₂ : ZMod 3,
        π (q a₁ b₁ c₁) x₀ ≠ π (w * q a₂ b₂ c₂) x₀ := by
      intro a₁ b₁ c₁ a₂ b₂ c₂ h
      let g₁ : S := (q a₁ b₁ c₁)⁻¹ * (w * q a₂ b₂ c₂)
      have hg₁_fix : π g₁ x₀ = x₀ := by
        change π ((q a₁ b₁ c₁)⁻¹ * (w * q a₂ b₂ c₂)) x₀ = x₀
        rw [map_mul, map_inv, Equiv.Perm.mul_apply, Equiv.Perm.inv_eq_iff_eq, ← h]
      have hconj_fix : π (g₁⁻¹ * q a₀ b₀ c₀ * g₁) x₀ = x₀ := by
        rw [map_mul, map_mul, map_inv, Equiv.Perm.mul_apply, Equiv.Perm.mul_apply, hg₁_fix,
          hp₀_fix, Equiv.Perm.inv_eq_iff_eq, hg₁_fix]
      have hq_conj : ∀ u₁ v₁ t₁ u₂ v₂ t₂ : ZMod 3,
          ∃ t₃ : ZMod 3, q u₁ v₁ t₁ * q u₂ v₂ t₂ * (q u₁ v₁ t₁)⁻¹ = q u₂ v₂ t₃ := by
        intro u₁ v₁ t₁ u₂ v₂ t₂
        have hu : u₁ + u₂ + -u₁ = u₂ :=
          (by decide : ∀ x y : ZMod 3, x + y + -x = y) u₁ u₂
        have hv : v₁ + v₂ + -v₁ = v₂ :=
          (by decide : ∀ x y : ZMod 3, x + y + -x = y) v₁ v₂
        refine ⟨t₁ + t₂ - u₂ * v₁ + (-t₁ - u₁ * v₁) - -u₁ * (v₁ + v₂), ?_⟩
        rw [hq_inv, hq_mul, hq_mul, hu, hv]
      obtain ⟨t₁, ht₁⟩ := hq_conj a₁ b₁ c₁ a₀ b₀ c₀
      obtain ⟨t₃, ht₃⟩ := hq_conj (-a₂) (-b₂) (-c₂ - a₂ * b₂) b₀ (-a₀) (t₁ + a₀ * b₀)
      have hg₁_eq : g₁⁻¹ * q a₀ b₀ c₀ * g₁ = q b₀ (-a₀) t₃ := by
        have hstep : g₁⁻¹ * q a₀ b₀ c₀ * g₁ =
            (q a₂ b₂ c₂)⁻¹ * (w⁻¹ * (q a₁ b₁ c₁ * q a₀ b₀ c₀ * (q a₁ b₁ c₁)⁻¹) * w) *
              ((q a₂ b₂ c₂)⁻¹)⁻¹ := by
          simp only [g₁]; group
        rw [hstep, ht₁, hw_conj_q, hq_inv a₂ b₂ c₂, ht₃]
      rw [hg₁_eq] at hconj_fix
      have hdet := hdet_zero a₀ b₀ c₀ b₀ (-a₀) t₃ hp₀_fix hconj_fix
      have hab0 := zmod3_sq_add_sq_eq_zero a₀ b₀ hdet
      rcases hp₀_ab_ne with ha | hb
      · exact ha hab0.1
      · exact hb hab0.2
    obtain ⟨ιa, ιb, hι_inj⟩ : ∃ ιa ιb : ZMod 3 × ZMod 3 → ZMod 3,
        Function.Injective (fun u : ZMod 3 × ZMod 3 => π (q (ιa u) (ιb u) u.2) x₀) := by
      by_cases hinj_a : Function.Injective (fun u : ZMod 3 × ZMod 3 => π (q u.1 0 u.2) x₀)
      · exact ⟨Prod.fst, fun _ => 0, hinj_a⟩
      · obtain ⟨u₁, u₂, hu12, hne_u⟩ : ∃ u₁ u₂ : ZMod 3 × ZMod 3,
            π (q u₁.1 0 u₁.2) x₀ = π (q u₂.1 0 u₂.2) x₀ ∧ u₁ ≠ u₂ := by
          by_contra! h
          exact hinj_a fun x y hxy => h x y hxy
        have hu_fix : π (q (-u₂.1 + u₁.1) 0 (-u₂.2 + u₁.2)) x₀ = x₀ := by
          have hmul : (q u₂.1 0 u₂.2)⁻¹ * q u₁.1 0 u₁.2 =
              q (-u₂.1 + u₁.1) 0 (-u₂.2 + u₁.2) := by
            rw [hq_inv, hq_mul]
            have hb : (-0 : ZMod 3) + 0 = 0 := rfl
            have hc : -u₂.2 - u₂.1 * 0 + u₁.2 - u₁.1 * -0 = -u₂.2 + u₁.2 :=
              (by decide : ∀ a₁ a₂ c₁ c₂ : ZMod 3,
                -c₂ - a₂ * 0 + c₁ - a₁ * -0 = -c₂ + c₁) u₁.1 u₂.1 u₁.2 u₂.2
            rw [hb, hc]
          rw [← hmul, map_mul, map_inv, Equiv.Perm.mul_apply, Equiv.Perm.inv_eq_iff_eq]
          exact hu12
        have ha_ne : -u₂.1 + u₁.1 ≠ 0 := by
          intro ha0
          apply hne_u
          have hc0 : -u₂.2 + u₁.2 = 0 := by
            apply hz_fix (-u₂.2 + u₁.2)
            have hzq : q (-u₂.1 + u₁.1) 0 (-u₂.2 + u₁.2) = z (-u₂.2 + u₁.2) := by
              show x_a (-u₂.1 + u₁.1) * x_b 0 * z (-u₂.2 + u₁.2) = z (-u₂.2 + u₁.2)
              rw [ha0, hxa0, hxb0, mul_one, one_mul]
            rwa [← hzq]
          have h1 : u₁.1 = u₂.1 :=
            (by decide : ∀ x y : ZMod 3, -y + x = 0 → x = y) u₁.1 u₂.1 ha0
          have h2 : u₁.2 = u₂.2 :=
            (by decide : ∀ x y : ZMod 3, -y + x = 0 → x = y) u₁.2 u₂.2 hc0
          exact Prod.ext h1 h2
        refine ⟨fun _ => 0, Prod.fst, fun v₁ v₂ hv12 => ?_⟩
        have hv12' : π (q 0 v₁.1 v₁.2) x₀ = π (q 0 v₂.1 v₂.2) x₀ := hv12
        have hv_fix : π (q 0 (-v₂.1 + v₁.1) (-v₂.2 + v₁.2)) x₀ = x₀ := by
          have hmul : (q 0 v₂.1 v₂.2)⁻¹ * q 0 v₁.1 v₁.2 =
              q 0 (-v₂.1 + v₁.1) (-v₂.2 + v₁.2) := by
            rw [hq_inv, hq_mul]
            have ha : (-0 : ZMod 3) + 0 = 0 := rfl
            have hc : -v₂.2 - 0 * v₂.1 + v₁.2 - 0 * -v₂.1 = -v₂.2 + v₁.2 :=
              (by decide : ∀ b₁ b₂ c₁ c₂ : ZMod 3,
                -c₂ - 0 * b₂ + c₁ - 0 * -b₂ = -c₂ + c₁) v₁.1 v₂.1 v₁.2 v₂.2
            rw [ha, hc]
          rw [← hmul, map_mul, map_inv, Equiv.Perm.mul_apply, Equiv.Perm.inv_eq_iff_eq]
          exact hv12'
        have hdet := hdet_zero (-u₂.1 + u₁.1) 0 (-u₂.2 + u₁.2)
          0 (-v₂.1 + v₁.1) (-v₂.2 + v₁.2) hu_fix hv_fix
        have hb0 : -v₂.1 + v₁.1 = 0 :=
          (by decide : ∀ a b : ZMod 3, a ≠ 0 → a * b - 0 * 0 = 0 → b = 0)
            (-u₂.1 + u₁.1) (-v₂.1 + v₁.1) ha_ne hdet
        have hc0 : -v₂.2 + v₁.2 = 0 := by
          apply hz_fix (-v₂.2 + v₁.2)
          have hzq : q 0 (-v₂.1 + v₁.1) (-v₂.2 + v₁.2) = z (-v₂.2 + v₁.2) := by
            show x_a 0 * x_b (-v₂.1 + v₁.1) * z (-v₂.2 + v₁.2) = z (-v₂.2 + v₁.2)
            rw [hb0, hxa0, hxb0, mul_one, one_mul]
          rwa [← hzq]
        have h1 : v₁.1 = v₂.1 :=
          (by decide : ∀ x y : ZMod 3, -y + x = 0 → x = y) v₁.1 v₂.1 hb0
        have h2 : v₁.2 = v₂.2 :=
          (by decide : ∀ x y : ZMod 3, -y + x = 0 → x = y) v₁.2 v₂.2 hc0
        exact Prod.ext h1 h2
    let Ψ : (ZMod 3 × ZMod 3) ⊕ (ZMod 3 × ZMod 3) → {x : Λ // π (z 1) x ≠ x}
      | Sum.inl u => ⟨π (q (ιa u) (ιb u) u.2) x₀, hq_moved (ιa u) (ιb u) u.2⟩
      | Sum.inr u => ⟨π (w * q (ιa u) (ιb u) u.2) x₀, hwq_moved (ιa u) (ιb u) u.2⟩
    have hΨ : Function.Injective Ψ := by
      rintro (u₁ | u₁) (u₂ | u₂) h
      · exact congrArg Sum.inl (hι_inj (congrArg Subtype.val h))
      · exact False.elim (hdisj (ιa u₁) (ιb u₁) u₁.2 (ιa u₂) (ιb u₂) u₂.2 (congrArg Subtype.val h))
      · exact False.elim (hdisj (ιa u₂) (ιb u₂) u₂.2 (ιa u₁) (ιb u₁) u₁.2
          (congrArg Subtype.val h).symm)
      · congr 1
        apply hι_inj
        have hval : π (w * q (ιa u₁) (ιb u₁) u₁.2) x₀ = π (w * q (ιa u₂) (ιb u₂) u₂.2) x₀ :=
          congrArg Subtype.val h
        have h1 : π w (π (q (ιa u₁) (ιb u₁) u₁.2) x₀) = π w (π (q (ιa u₂) (ιb u₂) u₂.2) x₀) := by
          simpa [map_mul, Equiv.Perm.mul_apply] using hval
        exact (π w).injective h1
    have hcard := Nat.card_le_card_of_injective Ψ hΨ
    simp only [Nat.card_sum, Nat.card_prod, Nat.card_zmod] at hcard
    omega

private noncomputable def g2Weyl {K : Type} [Field K] (r : Fin G2.tag.rank) :
    ↥(adjointGroup Tag.G2 K) :=
  ⟨weylElt G2.tag K r 1, weylElt_mem_adjointGroup r 1⟩

private theorem weylElt_one_inv {K : Type} [Field K] (r : Fin G2.tag.rank) :
    (weylElt G2.tag K r 1)⁻¹ = weylElt G2.tag K r (-1) := by
  apply Units.ext
  rw [coe_weylElt_inv, coe_weylElt]
  simp

private theorem constPinned_singleton_smallReePos {K : Type} [Field K] (i : Fin 6) (s : ℤ) :
    constPinned G2.tag K [(smallReePos i, s)] = smallReeX K i (s : K) := by
  rw [constPinned_cons, constPinned_nil, mul_one]
  change pinnedX Tag.G2 K (Tag.G2.rootCertificate.root (smallReePos i)) (s : K) =
    smallReeX K i (s : K)
  rw [root_smallReePos i]
  rfl

private theorem g2Weyl_conj_of_check {K : Type} [Field K] (r : Fin G2.tag.rank)
    (i j : Fin 6) (s : ℤ)
    (h : constCheck G2.tag 0
      (g2WeylWordInv r ++ [(smallReePos i, 1)] ++ g2WeylWord r) [(smallReePos j, s)] = true) :
    (g2Weyl (K := K) r)⁻¹ * g2X i 1 * g2Weyl r = g2X j (s : K) := by
  apply Subtype.ext
  have h1 := constPinned_eq_of_constCheck h K Nat.cast_zero
  rw [constPinned_append, constPinned_append, ← weylElt_neg_one_eq_constPinned,
    ← weylElt_eq_constPinned, ← weylElt_one_inv,
    constPinned_singleton_smallReePos i 1, constPinned_singleton_smallReePos j s,
    Int.cast_one] at h1
  exact h1

private def zmod3ToK {K : Type} [Field K] (a : ZMod 3) : K :=
  (a.val : K)

private theorem zmod3_add_val :
    ∀ a b : ZMod 3, (a + b).val = a.val + b.val ∨ (a + b).val + 3 = a.val + b.val := by
  decide

private theorem zmod3_mul_val :
    ∀ a b : ZMod 3, (a * b).val = a.val * b.val ∨ (a * b).val + 3 = a.val * b.val := by
  decide

private theorem zmod3_neg_val :
    ∀ a : ZMod 3, (-a).val + a.val = 0 ∨ (-a).val + a.val = 3 := by
  decide

private theorem zmod3ToK_add {K : Type} [Field K] (h3 : (3 : K) = 0) (a b : ZMod 3) :
    zmod3ToK (K := K) (a + b) = zmod3ToK a + zmod3ToK b := by
  unfold zmod3ToK
  rcases zmod3_add_val a b with h | h
  · rw [h, Nat.cast_add]
  · have h' : (((a + b).val + 3 : ℕ) : K) = ((a.val + b.val : ℕ) : K) := congrArg Nat.cast h
    push_cast at h'
    linear_combination h' - h3

private theorem zmod3ToK_mul {K : Type} [Field K] (h3 : (3 : K) = 0) (a b : ZMod 3) :
    zmod3ToK (K := K) (a * b) = zmod3ToK a * zmod3ToK b := by
  unfold zmod3ToK
  rcases zmod3_mul_val a b with h | h
  · rw [h, Nat.cast_mul]
  · have h' : (((a * b).val + 3 : ℕ) : K) = ((a.val * b.val : ℕ) : K) := congrArg Nat.cast h
    push_cast at h'
    linear_combination h' - h3

private theorem zmod3ToK_neg {K : Type} [Field K] (h3 : (3 : K) = 0) (a : ZMod 3) :
    zmod3ToK (K := K) (-a) = -zmod3ToK a := by
  unfold zmod3ToK
  rcases zmod3_neg_val a with h | h
  · have h' : (((-a).val + a.val : ℕ) : K) = ((0 : ℕ) : K) := congrArg Nat.cast h
    push_cast at h'
    linear_combination h'
  · have h' : (((-a).val + a.val : ℕ) : K) = ((3 : ℕ) : K) := congrArg Nat.cast h
    push_cast at h'
    linear_combination h' + h3

private noncomputable def g2X_zmod3 {K : Type} [Field K] (i : Fin 6) (a : ZMod 3) :
    ↥(adjointGroup Tag.G2 K) :=
  g2X i (zmod3ToK a)

private theorem g2X_zmod3_zero {K : Type} [Field K] (i : Fin 6) :
    g2X_zmod3 (K := K) i 0 = 1 := by
  unfold g2X_zmod3 zmod3ToK
  rw [(by decide : (0 : ZMod 3).val = 0), Nat.cast_zero, g2X_zero]

private theorem g2X_zmod3_one {K : Type} [Field K] (i : Fin 6) :
    g2X_zmod3 (K := K) i 1 = g2X i 1 := by
  unfold g2X_zmod3 zmod3ToK
  rw [(by decide : (1 : ZMod 3).val = 1), Nat.cast_one]

private theorem g2X_zmod3_neg_one {K : Type} [Field K] (h3 : (3 : K) = 0) (i : Fin 6) :
    g2X_zmod3 (K := K) i (-1) = g2X i (-1) := by
  unfold g2X_zmod3 zmod3ToK
  rw [(by decide : (-1 : ZMod 3).val = 2)]
  congr 1
  push_cast
  linear_combination h3

private theorem g2X_zmod3_add {K : Type} [Field K] (h3 : (3 : K) = 0) (i : Fin 6)
    (a b : ZMod 3) :
    g2X_zmod3 (K := K) i (a + b) = g2X_zmod3 i a * g2X_zmod3 i b := by
  simp only [g2X_zmod3, zmod3ToK_add h3, g2X_add]

private theorem g2X_zmod3_swap_0_2 {K : Type} [Field K] (h3 : (3 : K) = 0) (a b : ZMod 3) :
    g2X_zmod3 (K := K) 2 b * g2X_zmod3 0 a =
      g2X_zmod3 0 a * g2X_zmod3 2 b * g2X_zmod3 3 (-(a * b)) := by
  simp only [g2X_zmod3, zmod3ToK_neg h3, zmod3ToK_mul h3]
  exact Subtype.ext (show smallReeX K 2 (zmod3ToK b) * smallReeX K 0 (zmod3ToK a) =
      smallReeX K 0 (zmod3ToK a) * smallReeX K 2 (zmod3ToK b) *
        smallReeX K 3 (-(zmod3ToK a * zmod3ToK b)) by
    simpa [mul_assoc] using smallRee_swap02_mul h3 (zmod3ToK a) (zmod3ToK b) 1)

private theorem g2X_zmod3_swap_1_4 {K : Type} [Field K] (h3 : (3 : K) = 0) (a b : ZMod 3) :
    g2X_zmod3 (K := K) 4 b * g2X_zmod3 1 a =
      g2X_zmod3 1 a * g2X_zmod3 4 b * g2X_zmod3 5 (-(a * b)) := by
  simp only [g2X_zmod3, zmod3ToK_neg h3, zmod3ToK_mul h3]
  exact g2X_swap_1_4 (zmod3ToK a) (zmod3ToK b)

private theorem g2Weyl0_conj_0 {K : Type} [Field K] (h3 : (3 : K) = 0) :
    (g2Weyl (K := K) ⟨0, by decide⟩)⁻¹ * g2X_zmod3 0 1 * g2Weyl ⟨0, by decide⟩ =
      g2X_zmod3 2 (-1) := by
  rw [g2X_zmod3_one, g2X_zmod3_neg_one h3]
  simpa using g2Weyl_conj_of_check ⟨0, by decide⟩ 0 2 (-1) g2Check_w0_conj_0

private theorem g2Weyl0_conj_2 {K : Type} [Field K] :
    (g2Weyl (K := K) ⟨0, by decide⟩)⁻¹ * g2X_zmod3 2 1 * g2Weyl ⟨0, by decide⟩ =
      g2X_zmod3 0 1 := by
  rw [g2X_zmod3_one, g2X_zmod3_one]
  simpa using g2Weyl_conj_of_check ⟨0, by decide⟩ 2 0 1 g2Check_w0_conj_2

private theorem g2Weyl0_conj_3 {K : Type} [Field K] :
    (g2Weyl (K := K) ⟨0, by decide⟩)⁻¹ * g2X_zmod3 3 1 * g2Weyl ⟨0, by decide⟩ =
      g2X_zmod3 3 1 := by
  rw [g2X_zmod3_one]
  simpa using g2Weyl_conj_of_check ⟨0, by decide⟩ 3 3 1 g2Check_w0_conj_3

private theorem g2Weyl1_conj_1 {K : Type} [Field K] (h3 : (3 : K) = 0) :
    (g2Weyl (K := K) ⟨1, by decide⟩)⁻¹ * g2X_zmod3 1 1 * g2Weyl ⟨1, by decide⟩ =
      g2X_zmod3 4 (-1) := by
  rw [g2X_zmod3_one, g2X_zmod3_neg_one h3]
  simpa using g2Weyl_conj_of_check ⟨1, by decide⟩ 1 4 (-1) g2Check_w1_conj_1

private theorem g2Weyl1_conj_4 {K : Type} [Field K] :
    (g2Weyl (K := K) ⟨1, by decide⟩)⁻¹ * g2X_zmod3 4 1 * g2Weyl ⟨1, by decide⟩ =
      g2X_zmod3 1 1 := by
  rw [g2X_zmod3_one, g2X_zmod3_one]
  simpa using g2Weyl_conj_of_check ⟨1, by decide⟩ 4 1 1 g2Check_w1_conj_4

private theorem g2Weyl1_conj_5 {K : Type} [Field K] :
    (g2Weyl (K := K) ⟨1, by decide⟩)⁻¹ * g2X_zmod3 5 1 * g2Weyl ⟨1, by decide⟩ =
      g2X_zmod3 5 1 := by
  rw [g2X_zmod3_one]
  simpa using g2Weyl_conj_of_check ⟨1, by decide⟩ 5 5 1 g2Check_w1_conj_5

/-- In characteristic `3` (`(3 : K) = 0`), every proper subgroup `M` of `adjointGroup .G2 K` has
index at least `36`. -/
theorem thirty_six_le_index_g2_of_char_three
    {K : Type} [Field K] [Finite K] [Finite ↥(adjointGroup Tag.G2 K)]
    [IsSimpleGroup ↥(adjointGroup Tag.G2 K)]
    (h3 : (3 : K) = 0) {M : Subgroup ↥(adjointGroup Tag.G2 K)} (hM : M ≠ ⊤) :
    36 ≤ M.index := by
  let Λ := ↥(adjointGroup Tag.G2 K) ⧸ M
  let π := MulAction.toPermHom ↥(adjointGroup Tag.G2 K) Λ
  rw [Subgroup.index_eq_card]
  change 36 ≤ Nat.card Λ
  by_cases hjoint : ∃ x₀ : Λ, π (g2X 3 1) x₀ ≠ x₀ ∧ π (g2X 5 1) x₀ ≠ x₀
  · rcases hjoint with ⟨x₀, hx3, hx5⟩
    rw [← g2Hom3254_inl_eq h3] at hx3
    rw [← g2Hom3254_inr_eq h3] at hx5
    have hsq := sq_card_sub_one_mul_card_add_one_le_card_of_two_heis_of_moved π
      (g2Hom3254 K h3) g2TwoHeisG g2TwoHeisR1 g2TwoHeisR2 (g2TwoHeis_conj h3) hx3 hx5
    have hK := three_le_card_of_three_eq_zero h3
    have hge6 : 6 ≤ (Nat.card K - 1) * Nat.card K := by
      have : 2 ≤ Nat.card K - 1 := by omega
      nlinarith
    nlinarith [sq ((Nat.card K - 1) * Nat.card K)]
  · push Not at hjoint
    have hz3 : g2X_zmod3 (K := K) 3 1 ≠ 1 := by
      rw [g2X_zmod3_one]
      exact fun h => one_ne_zero (g2X_injective 3 (h.trans (g2X_zero 3).symm))
    have hz5 : g2X_zmod3 (K := K) 5 1 ≠ 1 := by
      rw [g2X_zmod3_one]
      exact fun h => one_ne_zero (g2X_injective 5 (h.trans (g2X_zero 5).symm))
    have h18_3 : 18 ≤ Nat.card {x : Λ // π (g2X_zmod3 3 1) x ≠ x} :=
      eighteen_le_card_moved_of_heis_zmod3 π (g2X_zmod3 0) (g2X_zmod3 2) (g2X_zmod3 3)
        (g2Weyl ⟨0, by decide⟩)
        (g2X_zmod3_zero 0) (g2X_zmod3_add h3 0)
        (g2X_zmod3_zero 2) (g2X_zmod3_add h3 2)
        (g2X_zmod3_zero 3) (g2X_zmod3_add h3 3)
        (fun a c => g2X_comm_0_3 h3 (zmod3ToK a) (zmod3ToK c))
        (fun b c => g2X_comm_2_3 h3 (zmod3ToK b) (zmod3ToK c))
        (g2X_zmod3_swap_0_2 h3)
        (g2Weyl0_conj_0 h3) g2Weyl0_conj_2 g2Weyl0_conj_3
        (toPermHom_quotient_ne_one_of_ne_one hM hz3)
    have h18_5 : 18 ≤ Nat.card {x : Λ // π (g2X_zmod3 5 1) x ≠ x} :=
      eighteen_le_card_moved_of_heis_zmod3 π (g2X_zmod3 1) (g2X_zmod3 4) (g2X_zmod3 5)
        (g2Weyl ⟨1, by decide⟩)
        (g2X_zmod3_zero 1) (g2X_zmod3_add h3 1)
        (g2X_zmod3_zero 4) (g2X_zmod3_add h3 4)
        (g2X_zmod3_zero 5) (g2X_zmod3_add h3 5)
        (fun a c => g2X_comm_1_5 (zmod3ToK a) (zmod3ToK c))
        (fun b c => g2X_comm_4_5 (zmod3ToK b) (zmod3ToK c))
        (g2X_zmod3_swap_1_4 h3)
        (g2Weyl1_conj_1 h3) g2Weyl1_conj_4 g2Weyl1_conj_5
        (toPermHom_quotient_ne_one_of_ne_one hM hz5)
    rw [g2X_zmod3_one] at h18_3 h18_5
    let S₃ := {x : Λ // π (g2X 3 1) x ≠ x}
    let S₅ := {x : Λ // π (g2X 5 1) x ≠ x}
    have hinj : Function.Injective (Sum.elim (Subtype.val : S₃ → Λ) (Subtype.val : S₅ → Λ)) := by
      rintro (x | x) (y | y) hxy
      · exact congrArg Sum.inl (Subtype.ext hxy)
      · change x.1 = y.1 at hxy
        exact False.elim (y.2 (hxy ▸ hjoint x.1 x.2))
      · change x.1 = y.1 at hxy
        exact False.elim (x.2 (hxy.symm ▸ hjoint y.1 y.2))
      · exact congrArg Sum.inr (Subtype.ext hxy)
    have hcard := Nat.card_le_card_of_injective _ hinj
    rw [Nat.card_sum] at hcard
    omega

/-! ### `G₂(q)` case of Maróti's theorem -/

private theorem cast_eq_zero_of_card_eq_pow {K : Type} [Field K] [Finite K] {p f : ℕ}
    (hK : Nat.card K = p ^ f) : (p : K) = 0 := by
  have : Fintype (Multiplicative K) := Fintype.ofFinite _
  have h := pow_card_eq_one (x := Multiplicative.ofAdd (1 : K))
  have h1 : Multiplicative.toAdd (Multiplicative.ofAdd (1 : K) ^ Fintype.card (Multiplicative K)) =
      0 := congrArg Multiplicative.toAdd h
  rw [toAdd_pow, toAdd_ofAdd, nsmul_one, ← Nat.card_eq_fintype_card,
    Nat.card_congr Multiplicative.toAdd, hK, Nat.cast_pow] at h1
  by_contra hp0
  exact pow_ne_zero f hp0 h1

private theorem three_ne_zero_of_card_eq_pow {K : Type} [Field K] [Finite K] {p f : ℕ}
    (hp : p.Prime) (hp3 : p ≠ 3) (hK : Nat.card K = p ^ f) (h3 : (3 : K) = 0) : False := by
  have hp0 : (p : K) = 0 := cast_eq_zero_of_card_eq_pow hK
  have hcop : Nat.Coprime 3 p :=
    (Nat.Prime.coprime_iff_not_dvd Nat.prime_three).mpr fun hdvd =>
      hp3 ((hp.dvd_iff_eq (by decide : 3 ≠ 1)).mp hdvd)
  have hbez := Nat.gcd_eq_gcd_ab 3 p
  rw [hcop.gcd_eq_one] at hbez
  have hcast : ((1 : ℤ) : K) = ((3 : ℤ) * Nat.gcdA 3 p + (p : ℤ) * Nat.gcdB 3 p : ℤ) :=
    congrArg Int.cast hbez
  push_cast at hcast
  rw [h3, hp0, zero_mul, zero_mul, add_zero] at hcast
  exact one_ne_zero hcast

private theorem ordG2_mul_two_le_bound_cube {q : ℕ} (hq : 5 ≤ q) :
    ordG2 q * (2 * q) ≤ bound ((q - 1) * q ^ 2 + 1) := by
  set n := (q - 1) * q ^ 2 + 1
  have hq1 : q ≤ 2 * (q - 1) := by omega
  have hq3 : 2 * q ^ 3 ≤ (q - 1) ^ 6 := by
    have h1 : q ^ 3 ≤ (2 * (q - 1)) ^ 3 := Nat.pow_le_pow_left hq1 3
    have h2 : 16 ≤ (q - 1) ^ 3 :=
      (by decide : 16 ≤ 4 ^ 3).trans (Nat.pow_le_pow_left (by omega : 4 ≤ q - 1) 3)
    calc 2 * q ^ 3 ≤ 2 * (2 * (q - 1)) ^ 3 := Nat.mul_le_mul_left 2 h1
      _ = 16 * (q - 1) ^ 3 := by ring
      _ ≤ (q - 1) ^ 3 * (q - 1) ^ 3 := Nat.mul_le_mul_right _ h2
      _ = (q - 1) ^ 6 := by ring
  have hq15 : 2 * q ^ 15 ≤ n ^ 6 := by
    have hle : (q - 1) * q ^ 2 ≤ n := Nat.le_succ _
    calc 2 * q ^ 15 = (2 * q ^ 3) * q ^ 12 := by ring
      _ ≤ (q - 1) ^ 6 * q ^ 12 := Nat.mul_le_mul_right _ hq3
      _ = ((q - 1) * q ^ 2) ^ 6 := by ring
      _ ≤ n ^ 6 := Nat.pow_le_pow_left hle 6
  have hn64 : 2 ^ 6 ≤ n := by
    have : 4 * 5 ^ 2 ≤ (q - 1) * q ^ 2 :=
      Nat.mul_le_mul (by omega) (Nat.pow_le_pow_left hq 2)
    omega
  have hn0 : 0 < n := by omega
  have hlog : 6 ≤ Nat.log 2 n := Nat.le_log_of_pow_le (by decide) hn64
  calc ordG2 q * (2 * q)
      ≤ q ^ 14 * (2 * q) := Nat.mul_le_mul_right _ (ordG2_le_pow q)
    _ = 2 * q ^ 15 := by ring
    _ ≤ n ^ 6 := hq15
    _ ≤ n ^ Nat.log 2 n := Nat.pow_le_pow_right hn0 hlog
    _ ≤ bound n := pow_log_le_bound hn0

private theorem ordG2_mul_two_le_bound_sq {q : ℕ} (hq : 27 ≤ q) :
    ordG2 q * (2 * q) ≤ bound ((q - 1) * q + 1) := by
  set n := (q - 1) * q + 1
  have hq1 : q ≤ 2 * (q - 1) := by omega
  have hq6 : 2 * q ^ 6 ≤ (q - 1) ^ 9 := by
    have h1 : q ^ 6 ≤ (2 * (q - 1)) ^ 6 := Nat.pow_le_pow_left hq1 6
    have h2 : 128 ≤ (q - 1) ^ 3 :=
      (by decide : 128 ≤ 26 ^ 3).trans (Nat.pow_le_pow_left (by omega : 26 ≤ q - 1) 3)
    calc 2 * q ^ 6 ≤ 2 * (2 * (q - 1)) ^ 6 := Nat.mul_le_mul_left 2 h1
      _ = 128 * (q - 1) ^ 6 := by ring
      _ ≤ (q - 1) ^ 3 * (q - 1) ^ 6 := Nat.mul_le_mul_right _ h2
      _ = (q - 1) ^ 9 := by ring
  have hq15 : 2 * q ^ 15 ≤ n ^ 9 := by
    have hle : (q - 1) * q ≤ n := Nat.le_succ _
    calc 2 * q ^ 15 = (2 * q ^ 6) * q ^ 9 := by ring
      _ ≤ (q - 1) ^ 9 * q ^ 9 := Nat.mul_le_mul_right _ hq6
      _ = ((q - 1) * q) ^ 9 := by ring
      _ ≤ n ^ 9 := Nat.pow_le_pow_left hle 9
  have hn512 : 2 ^ 9 ≤ n := by
    have : 26 * 27 ≤ (q - 1) * q := Nat.mul_le_mul (by omega) hq
    omega
  have hn0 : 0 < n := by omega
  have hlog : 9 ≤ Nat.log 2 n := Nat.le_log_of_pow_le (by decide) hn512
  calc ordG2 q * (2 * q)
      ≤ q ^ 14 * (2 * q) := Nat.mul_le_mul_right _ (ordG2_le_pow q)
    _ = 2 * q ^ 15 := by ring
    _ ≤ n ^ 9 := hq15
    _ ≤ n ^ Nat.log 2 n := Nat.pow_le_pow_right hn0 hlog
    _ ≤ bound n := pow_log_le_bound hn0

/-- Any primitive almost simple group `G ≤ Perm α` with socle `G₂(p^f)` satisfies
`|G| ≤ bound |α|`. -/
theorem card_le_bound_of_chevalley_G2 {α : Type} [Finite α]
    {G : Subgroup (Equiv.Perm α)} [MulAction.IsPreprimitive G α]
    {S : Type} [Group S] {p f : ℕ} (hAS : IsAlmostSimpleWith G S)
    (h : ChevalleyExceptionalModel S .G2 p f) :
    Nat.card G ≤ bound (Nat.card α) := by
  have : IsSimpleGroup S := hAS.isSimpleGroup
  have : Finite S := hAS.finite
  have hcard : Nat.card S = ordG2 (p ^ f) := card_chevalleyExceptionalModel h
  have hout := (card_outerAut_G2 h).2
  obtain ⟨⟨hp, hf, -, hq3⟩, hm⟩ := h
  obtain ⟨K, _, _, hK, ⟨e₀⟩⟩ := hm
  have e : S ≃* ↥(adjointGroup .G2 K) :=
    e₀.trans ((QuotientGroup.quotientMulEquivOfEq
      (center_adjointGroup_eq_bot (τ := .G2) (K := K))).trans QuotientGroup.quotientBot)
  have : Finite ↥(adjointGroup .G2 K) := Finite.of_equiv S e.toEquiv
  have : IsSimpleGroup ↥(adjointGroup .G2 K) := e.symm.isSimpleGroup
  have hmap_ne_top : ∀ H : Subgroup S, H ≠ ⊤ → H.map (e : S →* ↥(adjointGroup .G2 K)) ≠ ⊤ := by
    intro H hH htop
    apply hH
    apply Subgroup.map_injective (f := (e : S →* ↥(adjointGroup .G2 K))) e.injective
    rw [htop, Subgroup.map_top_of_surjective _ e.surjective]
  have hfq : f ≤ p ^ f := (Nat.lt_pow_self hp.one_lt).le
  rcases eq_or_ne p 3 with rfl | hp3
  · have h3 : (3 : K) = 0 := cast_eq_zero_of_card_eq_pow hK
    rcases (by omega : f = 1 ∨ f = 2 ∨ 3 ≤ f) with rfl | rfl | hf3
    · have hidx : ∀ H : Subgroup S, H ≠ ⊤ → 36 ≤ H.index := by
        intro H hH
        have hle := thirty_six_le_index_g2_of_char_three h3 (hmap_ne_top H hH)
        rwa [Subgroup.index_map_equiv] at hle
      refine hAS.card_le_bound_of_outerAut_le hidx hout ?_
      rw [hcard]
      decide
    · have hidx : ∀ H : Subgroup S, H ≠ ⊤ → 145 ≤ H.index := by
        intro H hH
        have hle := two_mul_card_sub_one_mul_card_add_one_le_index_g2_of_char_three
          h3 (hmap_ne_top H hH)
        rw [Subgroup.index_map_equiv, hK] at hle
        exact hle
      refine hAS.card_le_bound_of_outerAut_le hidx hout ?_
      rw [hcard]
      decide
    · have hidx : ∀ H : Subgroup S, H ≠ ⊤ → (3 ^ f - 1) * 3 ^ f + 1 ≤ H.index := by
        intro H hH
        have hle := card_sub_one_mul_card_add_one_le_index_g2 (hmap_ne_top H hH)
        rwa [Subgroup.index_map_equiv, hK] at hle
      have hq27 : 27 ≤ 3 ^ f :=
        (by decide : 27 ≤ 3 ^ 3).trans (Nat.pow_le_pow_right (by decide) hf3)
      refine hAS.card_le_bound_of_outerAut_le hidx hout ?_
      rw [hcard]
      exact (Nat.mul_le_mul_left _ (Nat.mul_le_mul_left 2 hfq)).trans
        (ordG2_mul_two_le_bound_sq hq27)
  · have h3 : (3 : K) ≠ 0 := three_ne_zero_of_card_eq_pow hp hp3 hK
    have hidx : ∀ H : Subgroup S, H ≠ ⊤ → (p ^ f - 1) * (p ^ f) ^ 2 + 1 ≤ H.index := by
      intro H hH
      have hle := card_sub_one_mul_sq_add_one_le_index_g2_of_ne_three h3 (hmap_ne_top H hH)
      rwa [Subgroup.index_map_equiv, hK] at hle
    have hq4 : 4 ≤ p ^ f := by
      rcases eq_or_lt_of_le hq3 with hq_eq | hq4
      · exfalso
        have hdvd : p ∣ 3 := by
          rw [hq_eq]
          exact dvd_pow_self p (by omega : f ≠ 0)
        have hp_le : p ≤ 3 := Nat.le_of_dvd (by decide) hdvd
        have hp2 : 2 ≤ p := hp.two_le
        have hp_eq : p = 2 := by omega
        rw [hp_eq] at hdvd
        exact absurd hdvd (by decide)
      · exact hq4
    refine hAS.card_le_bound_of_outerAut_le hidx hout ?_
    rw [hcard]
    rcases eq_or_lt_of_le hq4 with hq_eq | hq5
    · refine (Nat.mul_le_mul_left _ (Nat.mul_le_mul_left 2 hfq)).trans ?_
      rw [← hq_eq]
      decide
    · exact (Nat.mul_le_mul_left _ (Nat.mul_le_mul_left 2 hfq)).trans
        (ordG2_mul_two_le_bound_cube hq5)

end Maroti
