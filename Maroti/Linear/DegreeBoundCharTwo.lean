module

public import Maroti.Linear.DegreeBoundCharTwoParabolics

/-!
# Degree lower bounds for `PSL(t, 2)` (`t ≥ 3`)

This file proves the inductive degree lower bound `2 ^ t - 1 ≤ H.index` for all proper subgroups
`H < projectiveSL t K` when `t ≥ 3` and `Nat.card K = 2` (away from the exceptional isomorphism
`PSL(4, 2) ≃ A₈` at `t = 4, H.index = 8`), and deduces the order bound for primitive almost simple
groups with socle `PSL(t, 2)`:

* The theorems `Maroti.card_vZeroSubgroup` and `Maroti.card_vOneSubgroup` show that
  `|V₀| = |V₁| = (Nat.card K) ^ (t - 1)`.
* The theorems `Maroti.vZeroSubgroup_le_of_mem` and `Maroti.vOneSubgroup_le_of_mem` show that over
  `GF(2)`, `V₀` (or `V₁`) is generated by `qMat ht 0 0 1` and
  `{qMat ht (Pi.single k 1) 0 1 | k : Mid t}` (or `{qMat ht 0 (Pi.single k 1) 1 | k : Mid t}`).
* The theorem `Maroti.smul_eq_self_of_notMem_orbit_of_conj_zMat` shows that when `H₀ ⊓ V = ⊥`
  (`|V| = 2 ^ (t - 1)`) and `H₀.index < 2 ^ t`, every element of `V` conjugate in `SL(t, 2)` to
  `qMat ht 0 0 1` fixes every point of `SL(t, 2) ⧸ H₀` outside the `V`-orbit of `1`.
* The theorem `Maroti.two_pow_sub_one_le_index_sl_succ` proves the inductive step `m ↦ m + 1`
  (`m ≥ 3`, `Nat.card K = 2`) from `SL(m, K)` to `SL(m + 1, K)` via the Levi projections
  `parabolicFirstProj` and `parabolicLastProj`.
* The theorem `Maroti.index_eq_eight_or_fifteen_le_of_four_two` shows that for `t = 4` and
  `Nat.card K = 2`, every proper subgroup `H < projectiveSL 4 K` has `H.index = 8 ∨ 15 ≤ H.index`.
* The theorem `Maroti.index_eq_eight_or_two_pow_sub_one_le_of_card_two` shows that for `t ≥ 3` and
  `Nat.card K = 2`, every proper subgroup `H < projectiveSL t K` has
  `(t = 4 ∧ H.index = 8) ∨ 2 ^ t - 1 ≤ H.index`.
-/

public section

attribute [-instance] instAddCommGroupOfIsSimpleAddGroupOfIsNilpotent
  instCommGroupOfIsSimpleGroupOfIsNilpotent

namespace Maroti

open Subgroup Equiv Matrix
open CFSG.LocalAnalysis.ComponentInitial
open CFSG.LocalAnalysis.ComponentInitial.LinearFlag

/-- Explicit equivalence between `(Mid t → K) × K` and `vZeroSubgroup ht K`. -/
@[expose]
def vZeroSubgroupEquiv {t : ℕ} [NeZero t] (ht : 2 ≤ t) (K : Type*) [Field K] :
    (Mid t → K) × K ≃ vZeroSubgroup ht K where
  toFun p := ⟨qMat ht p.1 0 p.2, p.1, p.2, rfl⟩
  invFun g :=
    (fun m => (g.1 : Matrix (Fin t) (Fin t) K) (firstIdx t) m.1,
     (g.1 : Matrix (Fin t) (Fin t) K) (firstIdx t) (lastIdx t))
  left_inv p := by
    ext m
    · exact qMat_apply_firstIdx_mid ht p.1 0 p.2 m
    · exact qMat_apply_firstIdx_lastIdx ht p.1 0 p.2
  right_inv g := by
    obtain ⟨_, u, z, rfl⟩ := g
    apply Subtype.ext
    change qMat ht _ 0 _ = qMat ht u 0 z
    congr 1
    · funext m; exact qMat_apply_firstIdx_mid ht u 0 z m
    · exact qMat_apply_firstIdx_lastIdx ht u 0 z

/-- Explicit equivalence between `(Mid t → K) × K` and `vOneSubgroup ht K`. -/
@[expose]
def vOneSubgroupEquiv {t : ℕ} [NeZero t] (ht : 2 ≤ t) (K : Type*) [Field K] :
    (Mid t → K) × K ≃ vOneSubgroup ht K where
  toFun p := ⟨qMat ht 0 p.1 p.2, p.1, p.2, rfl⟩
  invFun g :=
    (fun m => (g.1 : Matrix (Fin t) (Fin t) K) m.1 (lastIdx t),
     (g.1 : Matrix (Fin t) (Fin t) K) (firstIdx t) (lastIdx t))
  left_inv p := by
    ext m
    · exact qMat_apply_mid_lastIdx ht 0 p.1 p.2 m
    · exact qMat_apply_firstIdx_lastIdx ht 0 p.1 p.2
  right_inv g := by
    obtain ⟨_, v, z, rfl⟩ := g
    apply Subtype.ext
    change qMat ht 0 _ _ = qMat ht 0 v z
    congr 1
    · funext m; exact qMat_apply_mid_lastIdx ht 0 v z m
    · exact qMat_apply_firstIdx_lastIdx ht 0 v z

theorem card_vZeroSubgroup {t : ℕ} [NeZero t] (ht : 2 ≤ t) (K : Type*) [Field K] [Finite K] :
    Nat.card (vZeroSubgroup ht K) = Nat.card K ^ (t - 1) := by
  rw [← Nat.card_congr (vZeroSubgroupEquiv ht K), Nat.card_prod, card_mid_fun ht,
    ← pow_succ, show t - 2 + 1 = t - 1 by omega]

theorem card_vOneSubgroup {t : ℕ} [NeZero t] (ht : 2 ≤ t) (K : Type*) [Field K] [Finite K] :
    Nat.card (vOneSubgroup ht K) = Nat.card K ^ (t - 1) := by
  rw [← Nat.card_congr (vOneSubgroupEquiv ht K), Nat.card_prod, card_mid_fun ht,
    ← pow_succ, show t - 2 + 1 = t - 1 by omega]

/-- Over a field `K` of order `2`, any subgroup `S` containing `qMat ht 0 0 1` and
`qMat ht (Pi.single k 1) 0 1` for all `k : Mid t` contains `vZeroSubgroup ht K`. -/
theorem vZeroSubgroup_le_of_mem {t : ℕ} [NeZero t] (ht : 2 ≤ t)
    {K : Type*} [Field K] [Finite K] (hK : Nat.card K = 2)
    {S : Subgroup (SpecialLinearGroup (Fin t) K)}
    (hz : qMat ht 0 0 1 ∈ S)
    (hk : ∀ k : Mid t, qMat ht (Pi.single k 1) 0 1 ∈ S) :
    vZeroSubgroup ht K ≤ S := by
  have _ : Fintype K := Fintype.ofFinite K
  have hz_all : ∀ z : K, qMat ht 0 0 z ∈ S := by
    intro z
    rcases field_eq_zero_or_eq_one_of_card_two hK z with rfl | rfl
    · rw [qMat_zero]; exact S.one_mem
    · exact hz
  have hsingle : ∀ (k : Mid t) (a : K), qMat ht (Pi.single k a) 0 0 ∈ S := by
    intro k a
    rcases field_eq_zero_or_eq_one_of_card_two hK a with rfl | rfl
    · rw [Pi.single_zero, qMat_zero]; exact S.one_mem
    · have hmul : qMat (K := K) ht (Pi.single k 1) 0 0 =
          qMat ht (Pi.single k 1) 0 1 * (qMat ht 0 0 1)⁻¹ := by
        rw [qMat_inv, qMat_mul]
        simp
      rw [hmul]
      exact S.mul_mem (hk k) (S.inv_mem hz)
  let U : AddSubgroup (Mid t → K) :=
    { carrier := {u : Mid t → K | qMat ht u 0 0 ∈ S}
      zero_mem' := by
        change qMat ht 0 0 0 ∈ S
        rw [qMat_zero]
        exact S.one_mem
      add_mem' := fun {u₁ u₂} hu₁ hu₂ => by
        change qMat ht (u₁ + u₂) 0 0 ∈ S
        have h : qMat (K := K) ht (u₁ + u₂) 0 0 = qMat ht u₁ 0 0 * qMat ht u₂ 0 0 := by
          rw [qMat_mul]
          simp
        rw [h]
        exact S.mul_mem hu₁ hu₂
      neg_mem' := fun {u} hu => by
        change qMat ht (-u) 0 0 ∈ S
        have h : qMat (K := K) ht (-u) 0 0 = (qMat ht u 0 0)⁻¹ := by
          rw [qMat_inv]
          simp
        rw [h]
        exact S.inv_mem hu }
  have hu_all : ∀ u : Mid t → K, qMat ht u 0 0 ∈ S := by
    intro u
    have hsum : u = ∑ k : Mid t, Pi.single k (u k) := by
      ext k; simp
    change u ∈ U
    rw [hsum]
    exact U.sum_mem fun k _ => hsingle k (u k)
  rintro _ ⟨u, z, rfl⟩
  have hmul : qMat ht u 0 z = qMat ht u 0 0 * qMat ht 0 0 z := by
    rw [qMat_mul]
    simp
  rw [hmul]
  exact S.mul_mem (hu_all u) (hz_all z)

/-- Over a field `K` of order `2`, any subgroup `S` containing `qMat ht 0 0 1` and
`qMat ht 0 (Pi.single k 1) 1` for all `k : Mid t` contains `vOneSubgroup ht K`. -/
theorem vOneSubgroup_le_of_mem {t : ℕ} [NeZero t] (ht : 2 ≤ t)
    {K : Type*} [Field K] [Finite K] (hK : Nat.card K = 2)
    {S : Subgroup (SpecialLinearGroup (Fin t) K)}
    (hz : qMat ht 0 0 1 ∈ S)
    (hk : ∀ k : Mid t, qMat ht 0 (Pi.single k 1) 1 ∈ S) :
    vOneSubgroup ht K ≤ S := by
  have _ : Fintype K := Fintype.ofFinite K
  have hz_all : ∀ z : K, qMat ht 0 0 z ∈ S := by
    intro z
    rcases field_eq_zero_or_eq_one_of_card_two hK z with rfl | rfl
    · rw [qMat_zero]; exact S.one_mem
    · exact hz
  have hsingle : ∀ (k : Mid t) (a : K), qMat ht 0 (Pi.single k a) 0 ∈ S := by
    intro k a
    rcases field_eq_zero_or_eq_one_of_card_two hK a with rfl | rfl
    · rw [Pi.single_zero, qMat_zero]; exact S.one_mem
    · have hmul : qMat (K := K) ht 0 (Pi.single k 1) 0 =
          qMat ht 0 (Pi.single k 1) 1 * (qMat ht 0 0 1)⁻¹ := by
        rw [qMat_inv, qMat_mul]
        simp
      rw [hmul]
      exact S.mul_mem (hk k) (S.inv_mem hz)
  let V_add : AddSubgroup (Mid t → K) :=
    { carrier := {v : Mid t → K | qMat ht 0 v 0 ∈ S}
      zero_mem' := by
        change qMat ht 0 0 0 ∈ S
        rw [qMat_zero]
        exact S.one_mem
      add_mem' := fun {v₁ v₂} hv₁ hv₂ => by
        change qMat ht 0 (v₁ + v₂) 0 ∈ S
        have h : qMat (K := K) ht 0 (v₁ + v₂) 0 = qMat ht 0 v₁ 0 * qMat ht 0 v₂ 0 := by
          rw [qMat_mul]
          simp
        rw [h]
        exact S.mul_mem hv₁ hv₂
      neg_mem' := fun {v} hv => by
        change qMat ht 0 (-v) 0 ∈ S
        have h : qMat (K := K) ht 0 (-v) 0 = (qMat ht 0 v 0)⁻¹ := by
          rw [qMat_inv]
          simp
        rw [h]
        exact S.inv_mem hv }
  have hv_all : ∀ v : Mid t → K, qMat ht 0 v 0 ∈ S := by
    intro v
    have hsum : v = ∑ k : Mid t, Pi.single k (v k) := by
      ext k; simp
    change v ∈ V_add
    rw [hsum]
    exact V_add.sum_mem fun k _ => hsingle k (v k)
  rintro _ ⟨v, z, rfl⟩
  have hmul : qMat ht 0 v z = qMat ht 0 v 0 * qMat ht 0 0 z := by
    rw [qMat_mul]
    simp
  rw [hmul]
  exact S.mul_mem (hv_all v) (hz_all z)

/-- When `H₀ ⊓ V = ⊥`, `H₀.relIndex V = Nat.card V`. -/
theorem relIndex_eq_card_of_inf_eq_bot {G : Type*} [Group G] [Finite G]
    {H₀ V : Subgroup G} (hbot : H₀ ⊓ V = ⊥) :
    H₀.relIndex V = Nat.card V := by
  have hmul : Nat.card ↥(H₀ ⊓ V) * H₀.relIndex V = Nat.card V := by
    rw [← card_subgroupOf, Subgroup.relIndex, Subgroup.card_mul_index]
  have h1 : Nat.card ↥(H₀ ⊓ V) = 1 := by
    rw [hbot, Subgroup.card_bot]
  rw [h1, one_mul] at hmul
  exact hmul

/-- When `4 ≤ t`, `Nat.card K = 2`, `¬ (zSubgroup ht K ≤ H₀)`, and `H₀.index < 2 * 2 ^ (t - 1)`,
either `H₀ ⊓ vZeroSubgroup ht K = ⊥` or `H₀ ⊓ vOneSubgroup ht K = ⊥`. -/
theorem inf_vZeroSubgroup_eq_bot_or_inf_vOneSubgroup_eq_bot {t : ℕ} [NeZero t] (ht4 : 4 ≤ t)
    {K : Type*} [Field K] [Finite K] (hK : Nat.card K = 2)
    {H₀ : Subgroup (SpecialLinearGroup (Fin t) K)}
    (hZ : ¬ (zSubgroup (by omega : 2 ≤ t) K ≤ H₀))
    (hidx : H₀.index < 2 * 2 ^ (t - 1)) :
    H₀ ⊓ vZeroSubgroup (by omega : 2 ≤ t) K = ⊥ ∨
      H₀ ⊓ vOneSubgroup (by omega : 2 ≤ t) K = ⊥ := by
  have ht2 : 2 ≤ t := by omega
  have _ : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have _ : CharP K 2 := charP_two_of_card_two hK
  have hW₀_bot := (prime_field_qSubgroup_bounds ht2 hK hZ).1
  by_cases hu : ∃ u₀ : Mid t → K, u₀ ≠ 0 ∧ (u₀, 0) ∈ eAddSubgroup ht2 H₀
  · obtain ⟨u₀, hu₀_ne, hu₀_mem⟩ := hu
    have hv_zero := (eAddSubgroup_eq_fst_of_exists_ne_zero ht4 hK hZ hidx hu₀_ne hu₀_mem).2
    refine Or.inr (eq_bot_iff.mpr ?_)
    rintro g ⟨hgH, v, z, rfl⟩
    rw [Subgroup.mem_bot]
    have hv0 : v = 0 := hv_zero 0 v ⟨z, hgH⟩
    subst hv0
    have hz_mem : z ∈ zAddSubgroup ht2 H₀ := hgH
    rw [hW₀_bot, AddSubgroup.mem_bot] at hz_mem
    subst hz_mem
    exact qMat_zero ht2
  · refine Or.inl (eq_bot_iff.mpr ?_)
    rintro g ⟨hgH, u, z, rfl⟩
    rw [Subgroup.mem_bot]
    have hu0 : u = 0 := by_contra fun hne => hu ⟨u, hne, ⟨z, hgH⟩⟩
    subst hu0
    have hz_mem : z ∈ zAddSubgroup ht2 H₀ := hgH
    rw [hW₀_bot, AddSubgroup.mem_bot] at hz_mem
    subst hz_mem
    exact qMat_zero ht2

/-- When `Nat.card K = 2`, `¬ (zSubgroup ht K ≤ H₀)`, `H₀.index < 2 * 2 ^ (t - 1)`, and `V` is an
abelian subgroup of `SL(t, K)` with `H₀ ⊓ V = ⊥` and `H₀.relIndex V = 2 ^ (t - 1)`, any `v ∈ V`
conjugate in `SL(t, K)` to `qMat ht 0 0 1` fixes every `y : SL(t, K) ⧸ H₀` outside
`MulAction.orbit V (QuotientGroup.mk 1)`. -/
theorem smul_eq_self_of_notMem_orbit_of_conj_zMat {t : ℕ} [NeZero t] (ht : 2 ≤ t)
    {K : Type*} [Field K] [Finite K] [Fact (Nat.Prime 2)] [CharP K 2] (hK : Nat.card K = 2)
    {H₀ V : Subgroup (SpecialLinearGroup (Fin t) K)}
    (hZ : ¬ (zSubgroup ht K ≤ H₀)) (hidx : H₀.index < 2 * 2 ^ (t - 1))
    (hV_comm : ∀ a ∈ V, ∀ b ∈ V, a * b = b * a)
    (hV_bot : H₀ ⊓ V = ⊥) (hV_rel : H₀.relIndex V = 2 ^ (t - 1))
    {v s : SpecialLinearGroup (Fin t) K} (hv : v ∈ V)
    (hs : s * v * s⁻¹ = qMat ht 0 0 1)
    {y : SpecialLinearGroup (Fin t) K ⧸ H₀}
    (hy : y ∉ MulAction.orbit V (QuotientGroup.mk 1 : SpecialLinearGroup (Fin t) K ⧸ H₀)) :
    v • y = y := by
  let Q := qSubgroup ht K
  let X := SpecialLinearGroup (Fin t) K ⧸ H₀
  let x₀ : X := QuotientGroup.mk 1
  let z₀ : SpecialLinearGroup (Fin t) K := qMat ht 0 0 1
  have hrel_Q := (exists_qSubgroup_mul_mem_of_comm_zMat ht hK hZ hidx).1
  have hz₀_move_mem : ∀ x : X, z₀ • x ≠ x → x ∈ MulAction.orbit Q x₀ := by
    intro x hmove
    by_contra hnot
    obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective x
    let H_g := H₀.map (MulAut.conj g : SpecialLinearGroup (Fin t) K →* SpecialLinearGroup (Fin t) K)
    have hZ_g : ¬ (zSubgroup ht K ≤ H_g) := by
      rw [zSubgroup_le_iff_qMat_one_mem ht hK]
      rintro ⟨h, hh, hgh⟩
      apply hmove
      change QuotientGroup.mk (z₀ * g) = QuotientGroup.mk g
      rw [QuotientGroup.eq]
      have heq : (z₀ * g)⁻¹ * g = h⁻¹ := by
        change g * h * g⁻¹ = z₀ at hgh
        rw [← hgh]
        group
      rw [heq]
      exact H₀.inv_mem hh
    have hrel_g : 2 ^ (t - 1) ≤ H_g.relIndex Q :=
      (prime_field_qSubgroup_bounds ht hK hZ_g).2.2.2.1
    let f : MulAction.orbit Q x₀ ⊕ MulAction.orbit Q (QuotientGroup.mk g : X) → X :=
      Sum.elim Subtype.val Subtype.val
    have hf_inj : Function.Injective f := by
      rintro (⟨y₁, hy₁⟩ | ⟨y₁, hy₁⟩) (⟨y₂, hy₂⟩ | ⟨y₂, hy₂⟩) h
      · exact congrArg Sum.inl (Subtype.ext h)
      · exfalso
        change y₁ = y₂ at h
        subst h
        have horb1 := MulAction.orbit_eq_iff.mpr hy₁
        have horb2 := MulAction.orbit_eq_iff.mpr hy₂
        apply hnot
        rw [← horb1, horb2]
        exact MulAction.mem_orbit_self _
      · exfalso
        change y₁ = y₂ at h
        subst h
        have horb1 := MulAction.orbit_eq_iff.mpr hy₂
        have horb2 := MulAction.orbit_eq_iff.mpr hy₁
        apply hnot
        rw [← horb1, horb2]
        exact MulAction.mem_orbit_self _
      · exact congrArg Sum.inr (Subtype.ext h)
    have hcard_sum : Nat.card (MulAction.orbit Q x₀) +
        Nat.card (MulAction.orbit Q (QuotientGroup.mk g : X)) ≤ H₀.index := by
      rw [← Nat.card_sum, Subgroup.index]
      exact Nat.card_le_card_of_injective f hf_inj
    rw [card_orbit_quotient_one_eq_relIndex, card_orbit_quotient_eq_relIndex, hrel_Q] at hcard_sum
    change 2 ^ (t - 1) + H_g.relIndex Q ≤ H₀.index at hcard_sum
    omega
  have hv_notMem : v ∉ H₀ := by
    intro hvH
    have hv1 : v = 1 := Subgroup.mem_bot.mp (hV_bot ▸ ⟨hvH, hv⟩)
    rw [hv1, mul_one, mul_inv_cancel, ← qMat_zero ht] at hs
    exact zero_ne_one (qMat_injective ht hs).2.2
  have hzs : z₀ * s = s * v := by
    change qMat ht 0 0 1 * s = s * v
    rw [← hs, inv_mul_cancel_right]
  have hw_mem : ∀ w : MulAction.orbit V x₀, s • w.1 ∈ MulAction.orbit Q x₀ := by
    rintro ⟨_, ⟨a, haV⟩, rfl⟩
    apply hz₀_move_mem
    intro hfix
    apply hv_notMem
    have h1 : s • (a • (v • x₀)) = s • (a • x₀) := by
      calc s • (a • (v • x₀))
        _ = (s * (a * v)) • x₀ := by rw [mul_smul, mul_smul]
        _ = (s * (v * a)) • x₀ := by rw [hV_comm a haV v hv]
        _ = ((s * v) * a) • x₀ := by rw [mul_assoc]
        _ = ((z₀ * s) * a) • x₀ := by rw [hzs]
        _ = z₀ • (s • (a • x₀)) := by rw [mul_assoc, mul_smul, mul_smul]
        _ = s • (a • x₀) := hfix
    have h2 : a • (v • x₀) = a • x₀ := by
      have := congrArg (s⁻¹ • ·) h1
      rwa [inv_smul_smul, inv_smul_smul] at this
    have h3 : v • x₀ = x₀ := by
      have := congrArg (a⁻¹ • ·) h2
      rwa [inv_smul_smul, inv_smul_smul] at this
    have h4 : QuotientGroup.mk (v * 1) = (QuotientGroup.mk 1 : X) := h3
    rw [mul_one, QuotientGroup.eq, mul_one, inv_mem_iff] at h4
    exact h4
  let φ : MulAction.orbit V x₀ → MulAction.orbit Q x₀ := fun w => ⟨s • w.1, hw_mem w⟩
  have hφ_inj : Function.Injective φ := by
    intro w₁ w₂ h
    refine Subtype.ext ?_
    have h' : s • w₁.1 = s • w₂.1 := congrArg Subtype.val h
    have := congrArg (s⁻¹ • ·) h'
    rwa [inv_smul_smul, inv_smul_smul] at this
  have _ : Fintype (MulAction.orbit V x₀) := Fintype.ofFinite _
  have _ : Fintype (MulAction.orbit Q x₀) := Fintype.ofFinite _
  have hcard_eq : Fintype.card (MulAction.orbit V x₀) = Fintype.card (MulAction.orbit Q x₀) := by
    rw [← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card,
      card_orbit_quotient_one_eq_relIndex, card_orbit_quotient_one_eq_relIndex, hV_rel, hrel_Q]
  have hφ_surj : Function.Surjective φ :=
    ((Fintype.bijective_iff_injective_and_card φ).mpr ⟨hφ_inj, hcard_eq⟩).2
  by_contra hvy
  have hsy_move : z₀ • (s • y) ≠ s • y := by
    intro hfix
    apply hvy
    have h1 : s • (v • y) = s • y := by
      calc s • (v • y) = (s * v) • y := (mul_smul s v y).symm
        _ = (z₀ * s) • y := by rw [← hzs]
        _ = z₀ • (s • y) := mul_smul z₀ s y
        _ = s • y := hfix
    have := congrArg (s⁻¹ • ·) h1
    rwa [inv_smul_smul, inv_smul_smul] at this
  obtain ⟨w, hw⟩ := hφ_surj ⟨s • y, hz₀_move_mem (s • y) hsy_move⟩
  have hwy : w.1 = y := by
    have h' : s • w.1 = s • y := congrArg Subtype.val hw
    have := congrArg (s⁻¹ • ·) h'
    rwa [inv_smul_smul, inv_smul_smul] at this
  exact hy (hwy ▸ w.2)

/-- When `H₀ ⊓ vZeroSubgroup ht K = ⊥`, `vZeroSubgroup ht K` fixes every `y` outside
`MulAction.orbit (vZeroSubgroup ht K) (QuotientGroup.mk 1)`. -/
theorem vZeroSubgroup_smul_eq_self_of_notMem_orbit {t : ℕ} [NeZero t] (ht : 2 ≤ t)
    {K : Type*} [Field K] [Finite K] (hK : Nat.card K = 2)
    {H₀ : Subgroup (SpecialLinearGroup (Fin t) K)}
    (hZ : ¬ (zSubgroup ht K ≤ H₀)) (hidx : H₀.index < 2 * 2 ^ (t - 1))
    (hV_bot : H₀ ⊓ vZeroSubgroup ht K = ⊥)
    {y : SpecialLinearGroup (Fin t) K ⧸ H₀}
    (hy : y ∉ MulAction.orbit (vZeroSubgroup ht K)
      (QuotientGroup.mk 1 : SpecialLinearGroup (Fin t) K ⧸ H₀))
    {v : SpecialLinearGroup (Fin t) K} (hv : v ∈ vZeroSubgroup ht K) :
    v • y = y := by
  have _ : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have _ : CharP K 2 := charP_two_of_card_two hK
  have hV_rel : H₀.relIndex (vZeroSubgroup ht K) = 2 ^ (t - 1) := by
    rw [relIndex_eq_card_of_inf_eq_bot hV_bot, card_vZeroSubgroup ht K, hK]
  let S := MulAction.stabilizer (SpecialLinearGroup (Fin t) K) y
  have hz : qMat ht 0 0 1 ∈ S := by
    refine smul_eq_self_of_notMem_orbit_of_conj_zMat ht hK hZ hidx
      (fun a ha b hb => vZeroSubgroup_mul_comm ht ha hb) hV_bot hV_rel
      ⟨0, 1, rfl⟩ (s := 1) (by group) hy
  have hk : ∀ k : Mid t, qMat ht (Pi.single k 1) 0 1 ∈ S := by
    intro k
    obtain ⟨s, hs⟩ := exists_conj_qMat_single_left ht k (1 : K)
    exact smul_eq_self_of_notMem_orbit_of_conj_zMat ht hK hZ hidx
      (fun a ha b hb => vZeroSubgroup_mul_comm ht ha hb) hV_bot hV_rel
      ⟨Pi.single k 1, 1, rfl⟩ hs hy
  exact vZeroSubgroup_le_of_mem ht hK hz hk hv

/-- When `H₀ ⊓ vOneSubgroup ht K = ⊥`, `vOneSubgroup ht K` fixes every `y` outside
`MulAction.orbit (vOneSubgroup ht K) (QuotientGroup.mk 1)`. -/
theorem vOneSubgroup_smul_eq_self_of_notMem_orbit {t : ℕ} [NeZero t] (ht : 2 ≤ t)
    {K : Type*} [Field K] [Finite K] (hK : Nat.card K = 2)
    {H₀ : Subgroup (SpecialLinearGroup (Fin t) K)}
    (hZ : ¬ (zSubgroup ht K ≤ H₀)) (hidx : H₀.index < 2 * 2 ^ (t - 1))
    (hV_bot : H₀ ⊓ vOneSubgroup ht K = ⊥)
    {y : SpecialLinearGroup (Fin t) K ⧸ H₀}
    (hy : y ∉ MulAction.orbit (vOneSubgroup ht K)
      (QuotientGroup.mk 1 : SpecialLinearGroup (Fin t) K ⧸ H₀))
    {v : SpecialLinearGroup (Fin t) K} (hv : v ∈ vOneSubgroup ht K) :
    v • y = y := by
  have _ : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have _ : CharP K 2 := charP_two_of_card_two hK
  have hV_rel : H₀.relIndex (vOneSubgroup ht K) = 2 ^ (t - 1) := by
    rw [relIndex_eq_card_of_inf_eq_bot hV_bot, card_vOneSubgroup ht K, hK]
  let S := MulAction.stabilizer (SpecialLinearGroup (Fin t) K) y
  have hz : qMat ht 0 0 1 ∈ S := by
    refine smul_eq_self_of_notMem_orbit_of_conj_zMat ht hK hZ hidx
      (fun a ha b hb => vOneSubgroup_mul_comm ht ha hb) hV_bot hV_rel
      ⟨0, 1, rfl⟩ (s := 1) (by group) hy
  have hk : ∀ k : Mid t, qMat ht 0 (Pi.single k 1) 1 ∈ S := by
    intro k
    obtain ⟨s, hs⟩ := exists_conj_qMat_single_right ht k (1 : K)
    exact smul_eq_self_of_notMem_orbit_of_conj_zMat ht hK hZ hidx
      (fun a ha b hb => vOneSubgroup_mul_comm ht ha hb) hV_bot hV_rel
      ⟨Pi.single k 1, 1, rfl⟩ hs hy
  exact vOneSubgroup_le_of_mem ht hK hz hk hv

/-- Abstract parabolic induction step: if `V` is normal in `P` with `P / V ≃* SL(m, K)`, `P` is a
maximal subgroup of `SL(m + 1, K)` of index `2 ^ (m + 1) - 1`, `H₀ ⊓ V = ⊥`, `|V| = 2 ^ m`, and
`V` fixes every point outside `MulAction.orbit V (QuotientGroup.mk 1)`, then `2 ^ m < H₀.index` and
the degree bound `2 ^ m - 1` for `SL(m, K)` imply `2 ^ (m + 1) - 1 ≤ H₀.index`. -/
theorem two_pow_succ_sub_one_le_index_of_parabolic_proj {m : ℕ} (hm : 2 ≤ m)
    {K : Type*} [Field K] [Finite K]
    (hIH : ∀ K₁ : Subgroup (SpecialLinearGroup (Fin m) K), K₁ ≠ ⊤ → 2 ^ m - 1 ≤ K₁.index)
    {H₀ V P : Subgroup (SpecialLinearGroup (Fin (m + 1)) K)}
    (π : P →* SpecialLinearGroup (Fin m) K)
    (_hH₀ : H₀ ≠ ⊤) (hgt : 2 ^ m < H₀.index)
    (hP_max : ∀ A : Subgroup (SpecialLinearGroup (Fin (m + 1)) K), P ≤ A → A = P ∨ A = ⊤)
    (hP_idx : P.index = 2 ^ (m + 1) - 1)
    (hπ_surj : Function.Surjective π)
    (hπ_ker : π.ker = V.subgroupOf P)
    (hV_norm : ∀ p ∈ P, ∀ v ∈ V, p * v * p⁻¹ ∈ V)
    (hV_comm : ∀ a ∈ V, ∀ b ∈ V, a * b = b * a)
    (hV_bot : H₀ ⊓ V = ⊥)
    (hV_rel : H₀.relIndex V = 2 ^ m)
    (hz_mem : qMat (by omega : 2 ≤ m + 1) 0 0 1 ∈ V)
    (hV_fix : ∀ y : SpecialLinearGroup (Fin (m + 1)) K ⧸ H₀,
      y ∉ MulAction.orbit V (QuotientGroup.mk 1) → ∀ v ∈ V, v • y = y) :
    2 ^ (m + 1) - 1 ≤ H₀.index := by
  have ht2 : 2 ≤ m + 1 := by omega
  let X := SpecialLinearGroup (Fin (m + 1)) K ⧸ H₀
  let x₀ : X := QuotientGroup.mk 1
  have hex_y₀ : ∃ y₀ : X, y₀ ∉ MulAction.orbit V x₀ := by
    by_contra! hall
    have hbij : Function.Bijective (Subtype.val : MulAction.orbit V x₀ → X) :=
      ⟨Subtype.val_injective, fun y => ⟨⟨y, hall y⟩, rfl⟩⟩
    have hcard_eq : H₀.relIndex V = H₀.index := by
      rw [← card_orbit_quotient_one_eq_relIndex, Subgroup.index]
      exact Nat.card_congr (Equiv.ofBijective _ hbij)
    omega
  obtain ⟨y₀, hy₀⟩ := hex_y₀
  obtain ⟨g₀, rfl⟩ := QuotientGroup.mk_surjective y₀
  let H₁ := H₀.map (MulAut.conj g₀ :
    SpecialLinearGroup (Fin (m + 1)) K →* SpecialLinearGroup (Fin (m + 1)) K)
  have hH₁_idx : H₁.index = H₀.index := Subgroup.index_map_equiv H₀ (MulAut.conj g₀)
  have hH₁_ne : H₁ ≠ ⊤ := by
    intro htop
    rw [htop, Subgroup.index_top] at hH₁_idx
    have : 1 ≤ 2 ^ m := Nat.one_le_pow m 2 (by decide)
    omega
  have hmem_H₁_iff : ∀ s : SpecialLinearGroup (Fin (m + 1)) K,
      s ∈ H₁ ↔ s • (QuotientGroup.mk g₀ : X) = QuotientGroup.mk g₀ := by
    intro s
    change (∃ h ∈ H₀, g₀ * h * g₀⁻¹ = s) ↔ QuotientGroup.mk (s * g₀) = QuotientGroup.mk g₀
    rw [QuotientGroup.eq]
    constructor
    · rintro ⟨h, hh, rfl⟩
      have heq : (g₀ * h * g₀⁻¹ * g₀)⁻¹ * g₀ = h⁻¹ := by group
      rw [heq]
      exact H₀.inv_mem hh
    · intro hmem
      refine ⟨g₀⁻¹ * s * g₀, ?_, by group⟩
      have heq : g₀⁻¹ * s * g₀ = ((s * g₀)⁻¹ * g₀)⁻¹ := by group
      rw [heq]
      exact H₀.inv_mem hmem
  have hVH₁ : V ≤ H₁ := fun v hv => (hmem_H₁_iff v).mpr (hV_fix _ hy₀ v hv)
  let z₀ : SpecialLinearGroup (Fin (m + 1)) K := qMat ht2 0 0 1
  have hz₀_notMem : z₀ ∉ H₀ := by
    intro hzH
    have hz1 : z₀ = 1 := Subgroup.mem_bot.mp (hV_bot ▸ ⟨hzH, hz_mem⟩)
    rw [← qMat_zero ht2] at hz1
    exact one_ne_zero (qMat_injective ht2 hz1).2.2
  have hmove_V : ∀ u : MulAction.orbit V x₀, z₀ • u.1 ≠ u.1 := by
    rintro ⟨_, ⟨a, haV⟩, rfl⟩ hfix
    apply hz₀_notMem
    have h1 : a • (z₀ • x₀) = a • x₀ := by
      rw [← mul_smul, ← hV_comm z₀ hz_mem a haV, mul_smul]
      exact hfix
    have h2 : z₀ • x₀ = x₀ := by
      have := congrArg (a⁻¹ • ·) h1
      rwa [inv_smul_smul, inv_smul_smul] at this
    have h3 : QuotientGroup.mk (z₀ * 1) = (QuotientGroup.mk 1 : X) := h2
    rw [mul_one, QuotientGroup.eq, mul_one, inv_mem_iff] at h3
    exact h3
  have hfix_P : ∀ w : MulAction.orbit P (QuotientGroup.mk g₀ : X), z₀ • w.1 = w.1 := by
    rintro ⟨_, ⟨p, hpP⟩, rfl⟩
    have hconj_V : p⁻¹ * z₀ * p ∈ V := by
      have := hV_norm p⁻¹ (P.inv_mem hpP) z₀ hz_mem
      simpa using this
    have hfix0 : (p⁻¹ * z₀ * p) • (QuotientGroup.mk g₀ : X) = QuotientGroup.mk g₀ :=
      (hmem_H₁_iff _).mp (hVH₁ hconj_V)
    change z₀ • (p • (QuotientGroup.mk g₀ : X)) = p • QuotientGroup.mk g₀
    have h1 := congrArg (p • ·) hfix0
    rwa [← mul_smul, show p * (p⁻¹ * z₀ * p) = z₀ * p by group, mul_smul] at h1
  let f : MulAction.orbit V x₀ ⊕ MulAction.orbit P (QuotientGroup.mk g₀ : X) → X :=
    Sum.elim Subtype.val Subtype.val
  have hf_inj : Function.Injective f := by
    rintro (u₁ | w₁) (u₂ | w₂) h
    · exact congrArg Sum.inl (Subtype.ext h)
    · exfalso
      change u₁.1 = w₂.1 at h
      have hm := hmove_V u₁
      rw [h] at hm
      exact hm (hfix_P w₂)
    · exfalso
      change w₁.1 = u₂.1 at h
      have hm := hmove_V u₂
      rw [← h] at hm
      exact hm (hfix_P w₁)
    · exact congrArg Sum.inr (Subtype.ext h)
  have hsum_le : 2 ^ m + H₁.relIndex P ≤ H₀.index := by
    rw [← hV_rel, ← card_orbit_quotient_one_eq_relIndex H₀ V,
      ← card_orbit_quotient_eq_relIndex H₀ P g₀, ← Nat.card_sum, Subgroup.index]
    exact Nat.card_le_card_of_injective f hf_inj
  let K₁ : Subgroup (SpecialLinearGroup (Fin m) K) := (H₁.subgroupOf P).map π
  have hker_le : π.ker ≤ H₁.subgroupOf P := by
    rw [hπ_ker]
    exact Subgroup.subgroupOf_mono P hVH₁
  have hcomap_K₁ : K₁.comap π = H₁.subgroupOf P :=
    Subgroup.comap_map_eq_self hker_le
  have hK₁_idx : K₁.index = H₁.relIndex P := by
    rw [← Subgroup.index_comap_of_surjective K₁ hπ_surj, hcomap_K₁, Subgroup.relIndex]
  by_cases hK₁_top : K₁ = ⊤
  · have hsub_top : H₁.subgroupOf P = ⊤ := by
      rw [← hcomap_K₁, hK₁_top, Subgroup.comap_top]
    have hPH₁ : P ≤ H₁ := Subgroup.subgroupOf_eq_top.mp hsub_top
    rcases hP_max H₁ hPH₁ with rfl | htop
    · rw [← hH₁_idx, hP_idx]
    · exact absurd htop hH₁_ne
  · have hK₁_ge := hIH K₁ hK₁_top
    rw [hK₁_idx] at hK₁_ge
    have hpos : 1 ≤ 2 ^ m := Nat.one_le_pow m 2 (by decide)
    have hpow : 2 ^ (m + 1) = 2 ^ m + 2 ^ m := by ring
    omega

/-- Step lemma (`m ↦ m + 1` for `m ≥ 3, Nat.card K = 2`): if every proper subgroup of `SL(m, K)`
has index at least `2 ^ m - 1`, then every proper subgroup `H₀ < SL(m + 1, K)` with
`¬ (zSubgroup _ K ≤ H₀)` and `2 ^ m < H₀.index` has `2 ^ (m + 1) - 1 ≤ H₀.index`. -/
theorem two_pow_sub_one_le_index_sl_succ {m : ℕ} (hm : 3 ≤ m)
    {K : Type*} [Field K] [Finite K] (hK : Nat.card K = 2)
    (hIH : ∀ K₁ : Subgroup (SpecialLinearGroup (Fin m) K), K₁ ≠ ⊤ → 2 ^ m - 1 ≤ K₁.index)
    {H₀ : Subgroup (SpecialLinearGroup (Fin (m + 1)) K)}
    (hH₀ : H₀ ≠ ⊤) (hZ : ¬ (zSubgroup (by omega : 2 ≤ m + 1) K ≤ H₀))
    (hgt : 2 ^ m < H₀.index) :
    2 ^ (m + 1) - 1 ≤ H₀.index := by
  have ht2 : 2 ≤ m + 1 := by omega
  have ht4 : 4 ≤ m + 1 := by omega
  by_cases hge : 2 * 2 ^ m ≤ H₀.index
  · have hpow : 2 ^ (m + 1) = 2 * 2 ^ m := by ring
    omega
  have hidx : H₀.index < 2 * 2 ^ m := Nat.lt_of_not_le hge
  rcases inf_vZeroSubgroup_eq_bot_or_inf_vOneSubgroup_eq_bot ht4 hK hZ hidx with hbot0 | hbot1
  · have hrel0 : H₀.relIndex (vZeroSubgroup ht2 K) = 2 ^ m := by
      rw [relIndex_eq_card_of_inf_eq_bot hbot0, card_vZeroSubgroup ht2 K, hK, Nat.add_sub_cancel]
    exact two_pow_succ_sub_one_le_index_of_parabolic_proj (by omega) hIH (parabolicFirstProj hK)
      hH₀ hgt (eq_of_stabilizer_flagSpace_le (d := 1))
      (index_stabilizer_flagSpace_one_of_card_two (by omega) hK)
      (parabolicFirstProj_surjective hK)
      (ker_parabolicFirstProj (by omega) hK)
      (fun _ hp _ hv => conj_mem_vZeroSubgroup_of_mem_stabilizer_one (by omega) hK hp hv)
      (fun _ ha _ hb => vZeroSubgroup_mul_comm ht2 ha hb)
      hbot0 hrel0 ⟨0, 1, rfl⟩
      (fun _ hy _ hv => vZeroSubgroup_smul_eq_self_of_notMem_orbit ht2 hK hZ hidx hbot0 hy hv)
  · have hrel1 : H₀.relIndex (vOneSubgroup ht2 K) = 2 ^ m := by
      rw [relIndex_eq_card_of_inf_eq_bot hbot1, card_vOneSubgroup ht2 K, hK, Nat.add_sub_cancel]
    exact two_pow_succ_sub_one_le_index_of_parabolic_proj (by omega) hIH (parabolicLastProj hK)
      hH₀ hgt (eq_of_stabilizer_flagSpace_le (d := m))
      (index_stabilizer_flagSpace_pred_of_card_two (by omega : 3 ≤ m + 1) hK)
      (parabolicLastProj_surjective hK)
      (ker_parabolicLastProj (by omega) hK)
      (fun _ hp _ hv => conj_mem_vOneSubgroup_of_mem_stabilizer_last (by omega) hK hp hv)
      (fun _ ha _ hb => vOneSubgroup_mul_comm ht2 ha hb)
      hbot1 hrel1 ⟨0, 1, rfl⟩
      (fun _ hy _ hv => vOneSubgroup_smul_eq_self_of_notMem_orbit ht2 hK hZ hidx hbot1 hy hv)

/-- For `t = 4` and `Nat.card K = 2`, every proper subgroup `H < projectiveSL 4 K` satisfies
`H.index = 8 ∨ 15 ≤ H.index`. -/
theorem index_eq_eight_or_fifteen_le_of_four_two {K : Type*} [Field K] [Finite K]
    (hK : Nat.card K = 2) {H : Subgroup (projectiveSL 4 K)} (hH : H ≠ ⊤) :
    H.index = 8 ∨ 15 ≤ H.index := by
  have _ : Finite (projectiveSL 4 K) := by unfold projectiveSL; infer_instance
  have h8_le : 8 ≤ H.index := by
    have h := card_pow_pred_le_index_of_ne_top (by decide : 3 ≤ 4) hH
    rw [hK] at h
    exact h
  rcases eq_or_lt_of_le h8_le with h8 | hgt
  · exact Or.inl h8.symm
  · obtain ⟨g, hidx, hZ⟩ := exists_comap_not_le_zSubgroup (by decide : 3 ≤ 4) hH
    set H₀ := (H.map (MulAut.conj g : projectiveSL 4 K →* projectiveSL 4 K)).comap (proj 4 K)
    have hH₀_ne : H₀ ≠ ⊤ := by
      intro htop
      rw [htop, Subgroup.index_top] at hidx
      omega
    have h15 := two_pow_sub_one_le_index_sl_succ (by decide : 3 ≤ 3) hK
      (fun _ hK₁ => seven_le_index_sl_three_two hK hK₁) hH₀_ne hZ (hidx.symm ▸ hgt)
    exact Or.inr (hidx ▸ h15)

/-- For `5 ≤ t` and `Nat.card K = 2`, every proper subgroup `H < SL(t, K)` satisfies
`2 ^ t - 1 ≤ H.index`. -/
theorem two_pow_sub_one_le_index_sl_of_five_le {t : ℕ} (ht : 5 ≤ t)
    {K : Type*} [Field K] [Finite K] (hK : Nat.card K = 2) :
    ∀ H : Subgroup (SpecialLinearGroup (Fin t) K), H ≠ ⊤ → 2 ^ t - 1 ≤ H.index := by
  have _ : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have _ : CharP K 2 := charP_two_of_card_two hK
  induction t, ht using Nat.le_induction with
  | base =>
    intro H hH
    exact thirty_one_le_index_sl_five_two hK hH
  | succ m hm ih =>
    intro H hH
    have _ : NeZero (m + 1) := ⟨by omega⟩
    let e := slEquivProjectiveSLOfCardTwo (m + 1) hK
    let H' := H.map (e : SpecialLinearGroup (Fin (m + 1)) K →* projectiveSL (m + 1) K)
    have hmap_ne : H' ≠ ⊤ := by
      intro htop
      apply hH
      rw [eq_top_iff]
      intro x _
      have hx : e x ∈ H' := htop ▸ Subgroup.mem_top (e x)
      obtain ⟨h, hh, hhe⟩ := hx
      exact e.injective hhe ▸ hh
    obtain ⟨g, hidx, hZ⟩ := exists_comap_not_le_zSubgroup (by omega : 3 ≤ m + 1) hmap_ne
    have hH'_idx : H'.index = H.index := Subgroup.index_map_equiv H e
    rw [hH'_idx] at hidx
    set H₀ := (H'.map
      (MulAut.conj g : projectiveSL (m + 1) K →* projectiveSL (m + 1) K)).comap (proj (m + 1) K)
    have hgt_sum := pow_pred_add_pow_sub_two_le_index (by omega : 4 ≤ m + 1) hK
      (Or.inl (by omega : 5 ≤ m + 1)) hZ
    have hpos : 0 < 2 ^ (m + 1 - 2) := pow_pos (by decide) _
    have hgt : 2 ^ m < H₀.index := by
      change 2 ^ (m + 1 - 1) + 2 ^ (m + 1 - 2) ≤ H₀.index at hgt_sum
      rw [Nat.add_sub_cancel] at hgt_sum
      omega
    have hH₀_ne : H₀ ≠ ⊤ := by
      intro htop
      rw [htop, Subgroup.index_top] at hgt
      have : 2 ≤ 2 ^ m := le_self_pow₀ (by decide) (by omega)
      omega
    rw [← hidx]
    exact two_pow_sub_one_le_index_sl_succ (by omega : 3 ≤ m) hK ih hH₀_ne hZ hgt

/-- For `5 ≤ t` and `Nat.card K = 2`, every proper subgroup `H < projectiveSL t K` satisfies
`2 ^ t - 1 ≤ H.index`. -/
theorem two_pow_sub_one_le_index_of_five_le {t : ℕ} (ht : 5 ≤ t)
    {K : Type*} [Field K] [Finite K] (hK : Nat.card K = 2)
    {H : Subgroup (projectiveSL t K)} (hH : H ≠ ⊤) :
    2 ^ t - 1 ≤ H.index := by
  have hcomap_ne : H.comap (proj t K) ≠ ⊤ := by
    intro htop
    apply hH
    rw [← Subgroup.map_comap_eq_self_of_surjective (proj_surjective t K) H, htop,
      Subgroup.map_top_of_surjective _ (proj_surjective t K)]
  rw [← Subgroup.index_comap_of_surjective H (proj_surjective t K)]
  exact two_pow_sub_one_le_index_sl_of_five_le ht hK (H.comap (proj t K)) hcomap_ne

/-- For `3 ≤ t` and `Nat.card K = 2`, every proper subgroup `H < projectiveSL t K` satisfies
`(t = 4 ∧ H.index = 8) ∨ 2 ^ t - 1 ≤ H.index`. -/
theorem index_eq_eight_or_two_pow_sub_one_le_of_card_two {t : ℕ} (ht : 3 ≤ t)
    {K : Type*} [Field K] [Finite K] (hK : Nat.card K = 2)
    {H : Subgroup (projectiveSL t K)} (hH : H ≠ ⊤) :
    (t = 4 ∧ H.index = 8) ∨ 2 ^ t - 1 ≤ H.index := by
  rcases eq_or_lt_of_le ht with rfl | ht4
  · exact Or.inr (seven_le_index_of_three_two hK hH)
  · rcases eq_or_lt_of_le (show 4 ≤ t by omega) with rfl | ht5
    · rcases index_eq_eight_or_fifteen_le_of_four_two hK hH with h8 | h15
      · exact Or.inl ⟨rfl, h8⟩
      · exact Or.inr h15
    · exact Or.inr (two_pow_sub_one_le_index_of_five_le (by omega) hK hH)

/-- Order of `projectiveSL 4 K` when `Nat.card K = 2` is `20160`. -/
theorem card_projectiveSL_four_two {K : Type*} [Field K] [Finite K] (hK : Nat.card K = 2) :
    Nat.card (projectiveSL 4 K) = 20160 := by
  have h1 := (scalars 4 K).card_eq_card_quotient_mul_card_subgroup
  have hSL : Nat.card (SpecialLinearGroup (Fin 4) K) = 20160 := by
    rw [card_SL_eq (by omega : 1 ≤ 4), hK]
    decide
  have hsc : Nat.card (scalars 4 K) = 1 := by
    rw [scalars_eq_bot_of_card_two 4 hK, Subgroup.card_bot]
  rw [hSL, hsc, mul_one] at h1
  exact h1.symm

end Maroti
