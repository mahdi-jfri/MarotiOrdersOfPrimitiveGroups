attribute [local irreducible] CFSG.Sporadic.J3.Native.j3Data

/-- Every proper subgroup of `J₃` has index at least `36`. -/
theorem index_ge_J3 {S : Type*} [Group S] [Finite S] [IsSimpleGroup S]
    (e : S ≃* NativeSporadic.Carrier .J3) {H : Subgroup S} (hH : H ≠ ⊤) :
    36 ≤ H.index := by
  obtain ⟨eJ⟩ : Nonempty (S ≃* CFSG.Sporadic.J3.J J3.D) := ⟨e.trans J3.φ⟩
  have : Finite (CFSG.Sporadic.J3.J J3.D) := Finite.of_equiv S eJ.toEquiv
  have _ : FaithfulSMul S (S ⧸ H) := faithfulSMul_quotient_of_ne_top hH
  have hz_ne : eJ.symm (J3.x 0) ≠ 1 :=
    fun h1 => J3.x0_ne_one (eJ.symm.injective (h1.trans (map_one eJ.symm).symm))
  obtain ⟨q, hq⟩ := exists_stabilizer_not_le (α := S ⧸ H) (Subgroup.zpowers_ne_bot.mpr hz_ne)
  let K := MulAction.stabilizer S q
  let K' : Subgroup (CFSG.Sporadic.J3.J J3.D) :=
    { carrier := {g | eJ.symm g ∈ K}
      mul_mem' := fun {a b} ha hb => by
        change eJ.symm (a * b) ∈ K
        rw [map_mul]
        exact K.mul_mem ha hb
      one_mem' := by
        change eJ.symm 1 ∈ K
        rw [map_one]
        exact K.one_mem
      inv_mem' := fun {a} ha => by
        change eJ.symm a⁻¹ ∈ K
        rw [map_inv]
        exact K.inv_mem ha }
  have hx0_not : J3.x 0 ∉ K' := fun hx0 => hq (Subgroup.zpowers_le.mpr hx0)
  have hle := j3_thirty_six_le_index J3.x_pow J3.x_comm J3.x_inj J3.h_conj
    J3.card_normalizer J3.omega_basis hx0_not
  let φQ : CFSG.Sporadic.J3.J J3.D ⧸ K' → S ⧸ K :=
    Quotient.lift (fun g => (eJ.symm g : S ⧸ K)) fun a b hab => by
      have hab' : (a : CFSG.Sporadic.J3.J J3.D ⧸ K') = b := Quotient.sound hab
      rw [QuotientGroup.eq] at hab'
      change eJ.symm (a⁻¹ * b) ∈ K at hab'
      rw [map_mul, map_inv] at hab'
      exact QuotientGroup.eq.mpr hab'
  have hφQ : Function.Injective φQ := by
    intro u v huv
    induction u using QuotientGroup.induction_on with | H a =>
    induction v using QuotientGroup.induction_on with | H b =>
    change (eJ.symm a : S ⧸ K) = (eJ.symm b : S ⧸ K) at huv
    rw [QuotientGroup.eq, ← map_inv, ← map_mul] at huv
    exact QuotientGroup.eq.mpr huv
  have hidx_le : K'.index ≤ K.index := Nat.card_le_card_of_injective φQ hφQ
  exact (hle.trans hidx_le).trans (index_stabilizer_le_card q)

/-- Maróti's bound for primitive almost simple groups with socle `J₃`. -/
theorem sporadicCase_J3 {α : Type} [Finite α] (G : Subgroup (Equiv.Perm α)) (S : Type)
    [Group S] [MulAction.IsPreprimitive G α] (hS : IsAlmostSimpleWith G S)
    (he : Nonempty (S ≃* NativeSporadic.Carrier .J3)) :
    Nat.card G ≤ bound (Nat.card α) := by
  have : Finite S := hS.finite
  have : IsSimpleGroup S := hS.isSimpleGroup
  obtain ⟨e⟩ := he
  have hcard : Nat.card S = 50232960 := by
    rw [Nat.card_congr e.toEquiv]
    exact CFSG.Sporadic.J3.card_J3
  refine hS.card_le_bound_of_outerAut_dvd (n₀ := 36) (c := 2) (by decide)
    (fun H hH => index_ge_J3 e hH)
    (card_outer_dvd_two_of_sporadicSocle ⟨.J3, ⟨e⟩⟩) ?_
  rw [hcard]
  decide

end Maroti
