module

public import Maroti.AlmostSimple.Basic
public import Maroti.Sporadic.AutBound
public import Maroti.Sporadic.ExtraspecialCoord
public import CFSG.RankThree.Asc83Table.J3

/-!
# Sporadic Simple Group `J₃`

This file proves Maróti's bound `Nat.card G ≤ bound (Nat.card α)` for primitive almost simple
groups `G` whose socle `S` is isomorphic to Janko's third group `J₃` (Maróti, *On the orders of
primitive groups*, J. Algebra 258 (2002), Theorem 1.1).

Using `CFSG.RankThree.Asc83Table.J3`, `J₃` has an elementary abelian `3`-subgroup `B` of order `27`
generated by `x 0, x 1, x 2` together with normalizing elements `h 0, h 1, h 2` acting on
`B ≅ (ZMod 3)³` via the matrices `t33 0, t33 1, t33 2 ∈ GL (Fin 3) (ZMod 3)` and satisfying
`omega_basis` (`(b * h 0 ^ i * h 1 ^ j) ^ 3 ≠ 1` for `(i, j) ≠ (0, 0)`). Here `t33 2` has order `8`
and acts irreducibly on the `2`-dimensional subspace `{(a, b, 0)} = ⟨![1, 0, 0], ![0, 1, 0]⟩`, while
`t33 0` and `t33 1` act as transvections mapping `(a, b, c)` to `(a + c, b, c)` and `(a, b + c, c)`.
We show that for every subgroup `K` not containing `⟨x 0⟩`, `K` has index at least `36 ≥ 32`, and
hence every proper subgroup of `J₃` has index at least `36`.
-/

@[expose] public section

attribute [-instance] instCommGroupOfIsSimpleGroupOfIsNilpotent
  instAddCommGroupOfIsSimpleAddGroupOfIsNilpotent

namespace Maroti

open Subgroup
open CFSG.Blueprint CFSG.RankThree.Asc83Table
open scoped Matrix

private theorem j3_t33AC_eigenvectors :
    ∀ (v : Fin 3 → ZMod 3), v ≠ 0 →
      ∀ (s : Fin 4), 0 < (s : ℕ) →
        ∀ (m : ZMod 3),
          ((((t33 0 * t33 2) ^ (s : ℕ) : GL33) : Matrix (Fin 3) (Fin 3) (ZMod 3)) *ᵥ v) =
            m • v →
          v = ![0, 0, 1] ∨ v = ![0, 0, 2] := by
  decide

private theorem j3_t33C_not_mem_001 :
    ∀ (v : Fin 3 → ZMod 3), (v = ![0, 0, 1] ∨ v = ![0, 0, 2]) →
      ∀ (s : Fin 4), 0 < (s : ℕ) →
        ∀ (m : ZMod 3),
          (((t33 2 ^ (s : ℕ) : GL33) : Matrix (Fin 3) (Fin 3) (ZMod 3)) *ᵥ v) ≠
            m • v := by
  decide

private theorem j3_two_indep_plane :
    ∀ (u₁ u₂ : Fin 3 → ZMod 3),
      u₁ ≠ 0 → u₂ ≠ 0 → u₂ ≠ u₁ → u₂ ≠ (2 : ZMod 3) • u₁ →
      ∃ d₁ d₂ : ZMod 3, (d₁ • u₁ + d₂ • u₂) 2 = 0 ∧
        ((d₁ • u₁ + d₂ • u₂) 0 ≠ 0 ∨ (d₁ • u₁ + d₂ • u₂) 1 ≠ 0) := by
  decide

private theorem j3_two_indep_in_plane_span :
    ∀ (u₁ u₂ : Fin 3 → ZMod 3),
      (u₁ ≠ 0 ∧ u₂ ≠ 0 ∧ u₂ ≠ u₁ ∧ u₂ ≠ (2 : ZMod 3) • u₁ ∧ u₁ 2 = 0 ∧ u₂ 2 = 0) →
      ∃ c₁ c₂ : ZMod 3, c₁ • u₁ + c₂ • u₂ = (![1, 0, 0] : Fin 3 → ZMod 3) := by
  decide

private theorem j3_t33AC_conj_span :
    ∀ (w : Fin 3 → ZMod 3), w 2 = 0 → (w 0 ≠ 0 ∨ w 1 ≠ 0) →
      ∀ (d : Fin 4), 0 < (d : ℕ) →
        ∀ (i₁ i₂ : Fin 3),
          ∃ c₁ c₂ : ZMod 3,
            c₁ • w + c₂ • (((((t33 0 ^ (i₁ : ℕ))⁻¹ * t33 2 ^ (d : ℕ) * t33 0 ^ (i₂ : ℕ) : GL33) :
              Matrix (Fin 3) (Fin 3) (ZMod 3)) *ᵥ w)) = ![1, 0, 0] := by
  decide

private theorem j3_t33A_pow_span :
    ∀ (u : Fin 3 → ZMod 3), u 2 ≠ 0 →
      ∀ (e : Fin 3), 0 < (e : ℕ) →
        ∃ c₁ c₂ : ZMod 3,
          c₁ • u + c₂ • (((t33 0 ^ (e : ℕ) : GL33) : Matrix (Fin 3) (Fin 3) (ZMod 3)) *ᵥ u) =
            ![1, 0, 0] := by
  decide

private def j3ImageAddSubgroup {Q : Type*} [Group Q]
    (ψ : Q → (Fin 3 → ZMod 3)) (hψ_one : ψ 1 = 0)
    (hψ_mul : ∀ a b : Q, ψ (a * b) = ψ a + ψ b) (W : Subgroup Q) :
    AddSubgroup (Fin 3 → ZMod 3) where
  carrier := {v | ∃ w ∈ W, ψ w = v}
  zero_mem' := ⟨1, W.one_mem, hψ_one⟩
  add_mem' := by
    rintro _ _ ⟨w₁, hw₁, rfl⟩ ⟨w₂, hw₂, rfl⟩
    exact ⟨w₁ * w₂, W.mul_mem hw₁ hw₂, hψ_mul w₁ w₂⟩
  neg_mem' := by
    rintro _ ⟨w, hw, rfl⟩
    refine ⟨w⁻¹, W.inv_mem hw, ?_⟩
    apply add_left_cancel (a := ψ w)
    rw [← hψ_mul w w⁻¹, mul_inv_cancel, hψ_one, add_neg_cancel]

private theorem j3_coset_pow_le_index {G : Type*} [Group G] [Finite G]
    {B' K : Subgroup G} {g : G} (m : ℕ)
    (hg : ∀ b ∈ B', g * b * g⁻¹ ∈ B')
    (hnot : ∀ (s : Fin m) (b : B'), 0 < (s : ℕ) → (b : G) * g ^ (s : ℕ) ∉ K) :
    m * (K.subgroupOf B').index ≤ K.index := by
  have hg_pow : ∀ (n : ℕ), ∀ b ∈ B', g ^ n * b * (g ^ n)⁻¹ ∈ B' := by
    intro n
    induction n with
    | zero =>
      intro b hb
      simpa using hb
    | succ n ih =>
      intro b hb
      have h1 : g ^ (n + 1) * b * (g ^ (n + 1))⁻¹ =
          g * (g ^ n * b * (g ^ n)⁻¹) * g⁻¹ := by
        rw [pow_succ']
        group
      rw [h1]
      exact hg _ (ih b hb)
  set W : Subgroup B' := K.subgroupOf B'
  let Φ : Fin m × (B' ⧸ W) → G ⧸ K := fun s =>
    Quotient.liftOn s.2 (fun b : B' => ((g ^ (s.1 : ℕ) * (b : G) : G) : G ⧸ K)) fun b₁ b₂ hb => by
      have hb' : (QuotientGroup.mk b₁ : B' ⧸ W) = QuotientGroup.mk b₂ := Quotient.sound hb
      rw [QuotientGroup.eq, mem_subgroupOf] at hb'
      apply QuotientGroup.eq.mpr
      have h1 : (g ^ (s.1 : ℕ) * (b₁ : G))⁻¹ * (g ^ (s.1 : ℕ) * (b₂ : G)) =
          (b₁ : G)⁻¹ * (b₂ : G) := by group
      rw [h1]
      exact hb'
  have hstep_lt : ∀ (s₁ s₂ : Fin m) (b₁ b₂ : B'),
      s₁ < s₂ → Φ (s₁, QuotientGroup.mk b₁) = Φ (s₂, QuotientGroup.mk b₂) → False := by
    intro s₁ s₂ b₁ b₂ hlt heq
    have hk : (g ^ (s₁ : ℕ) * (b₁ : G))⁻¹ * (g ^ (s₂ : ℕ) * (b₂ : G)) ∈ K :=
      QuotientGroup.eq.mp heq
    set d : ℕ := (s₂ : ℕ) - (s₁ : ℕ)
    have hd_pos : 0 < d := Nat.sub_pos_of_lt hlt
    have hd_lt : d < m := by omega
    have hs₂ : (s₂ : ℕ) = (s₁ : ℕ) + d := (Nat.add_sub_of_le (le_of_lt hlt)).symm
    let b₀ : B' := b₁⁻¹ * ⟨g ^ d * (b₂ : G) * (g ^ d)⁻¹, hg_pow d b₂.1 b₂.2⟩
    have hb₀g : (b₀ : G) * g ^ d =
        (g ^ (s₁ : ℕ) * (b₁ : G))⁻¹ * (g ^ (s₂ : ℕ) * (b₂ : G)) := by
      simp only [b₀, Subgroup.coe_mul, Subgroup.coe_inv]
      rw [hs₂, pow_add]
      group
    exact hnot ⟨d, hd_lt⟩ b₀ hd_pos (hb₀g.symm ▸ hk)
  have hΦ : Function.Injective Φ := by
    rintro ⟨s₁, a₁⟩ ⟨s₂, a₂⟩ heq
    induction a₁ using QuotientGroup.induction_on with | H b₁ =>
    induction a₂ using QuotientGroup.induction_on with | H b₂ =>
    rcases lt_trichotomy s₁ s₂ with hlt | rfl | hgt
    · exact False.elim (hstep_lt s₁ s₂ b₁ b₂ hlt heq)
    · refine Prod.ext rfl ?_
      rw [QuotientGroup.eq, mem_subgroupOf]
      have hk : (g ^ (s₁ : ℕ) * (b₁ : G))⁻¹ * (g ^ (s₁ : ℕ) * (b₂ : G)) ∈ K :=
        QuotientGroup.eq.mp heq
      have h1 : (g ^ (s₁ : ℕ) * (b₁ : G))⁻¹ * (g ^ (s₁ : ℕ) * (b₂ : G)) =
          (b₁ : G)⁻¹ * (b₂ : G) := by group
      rwa [h1] at hk
    · exact False.elim (hstep_lt s₂ s₁ b₂ b₁ hgt heq.symm)
  have hle := Nat.card_le_card_of_injective Φ hΦ
  simpa only [Nat.card_prod, Nat.card_fin, Subgroup.index] using hle

private theorem j3_coset_two_pow_le_index {G : Type*} [Group G] [Finite G]
    {B' K : Subgroup G} {g₂ g₀ : G} (m₂ m₀ : ℕ)
    (hg₂_norm : g₂ ∈ normalizer (B' : Set G))
    (hg₀_norm : g₀ ∈ normalizer (B' : Set G))
    (hnot₂ : ∀ (d : Fin m₂) (i₁ i₂ : Fin m₀) (b : B'), 0 < (d : ℕ) →
      (b : G) * ((g₀ ^ (i₁ : ℕ))⁻¹ * g₂ ^ (d : ℕ) * g₀ ^ (i₂ : ℕ)) ∉ K)
    (hnot₀ : ∀ (e : Fin m₀) (b : B'), 0 < (e : ℕ) →
      (b : G) * g₀ ^ (e : ℕ) ∉ K) :
    (m₂ * m₀) * (K.subgroupOf B').index ≤ K.index := by
  set W : Subgroup B' := K.subgroupOf B'
  let Φ : (Fin m₂ × Fin m₀) × (B' ⧸ W) → G ⧸ K := fun s =>
    Quotient.liftOn s.2
      (fun b : B' => ((g₂ ^ (s.1.1 : ℕ) * g₀ ^ (s.1.2 : ℕ) * (b : G) : G) : G ⧸ K))
      fun b₁ b₂ hb => by
        have hb' : (QuotientGroup.mk b₁ : B' ⧸ W) = QuotientGroup.mk b₂ := Quotient.sound hb
        rw [QuotientGroup.eq, mem_subgroupOf] at hb'
        apply QuotientGroup.eq.mpr
        have h1 : (g₂ ^ (s.1.1 : ℕ) * g₀ ^ (s.1.2 : ℕ) * (b₁ : G))⁻¹ *
            (g₂ ^ (s.1.1 : ℕ) * g₀ ^ (s.1.2 : ℕ) * (b₂ : G)) =
            (b₁ : G)⁻¹ * (b₂ : G) := by group
        rw [h1]
        exact hb'
  have hstep_k : ∀ (k₁ k₂ : Fin m₂) (i₁ i₂ : Fin m₀) (b₁ b₂ : B'),
      k₁ < k₂ → Φ ((k₁, i₁), QuotientGroup.mk b₁) = Φ ((k₂, i₂), QuotientGroup.mk b₂) → False := by
    intro k₁ k₂ i₁ i₂ b₁ b₂ hlt heq
    have hk : (g₂ ^ (k₁ : ℕ) * g₀ ^ (i₁ : ℕ) * (b₁ : G))⁻¹ *
        (g₂ ^ (k₂ : ℕ) * g₀ ^ (i₂ : ℕ) * (b₂ : G)) ∈ K :=
      QuotientGroup.eq.mp heq
    set d : ℕ := (k₂ : ℕ) - (k₁ : ℕ)
    have hd_pos : 0 < d := Nat.sub_pos_of_lt hlt
    have hd_lt : d < m₂ := by omega
    have hk₂ : (k₂ : ℕ) = (k₁ : ℕ) + d := (Nat.add_sub_of_le (le_of_lt hlt)).symm
    set u : G := (g₀ ^ (i₁ : ℕ))⁻¹ * g₂ ^ d * g₀ ^ (i₂ : ℕ)
    have hu_norm : u ∈ normalizer (B' : Set G) :=
      mul_mem (mul_mem (inv_mem (pow_mem hg₀_norm _)) (pow_mem hg₂_norm _)) (pow_mem hg₀_norm _)
    have hub₂ : u * (b₂ : G) * u⁻¹ ∈ B' := (mem_normalizer_iff.mp hu_norm b₂.1).1 b₂.2
    let b₀ : B' := b₁⁻¹ * ⟨u * (b₂ : G) * u⁻¹, hub₂⟩
    have hb₀u : (b₀ : G) * u =
        (g₂ ^ (k₁ : ℕ) * g₀ ^ (i₁ : ℕ) * (b₁ : G))⁻¹ *
        (g₂ ^ (k₂ : ℕ) * g₀ ^ (i₂ : ℕ) * (b₂ : G)) := by
      simp only [b₀, u, Subgroup.coe_mul, Subgroup.coe_inv]
      rw [hk₂, pow_add]
      group
    exact hnot₂ ⟨d, hd_lt⟩ i₁ i₂ b₀ hd_pos (hb₀u.symm ▸ hk)
  have hstep_i : ∀ (k : Fin m₂) (i₁ i₂ : Fin m₀) (b₁ b₂ : B'),
      i₁ < i₂ → Φ ((k, i₁), QuotientGroup.mk b₁) = Φ ((k, i₂), QuotientGroup.mk b₂) → False := by
    intro k i₁ i₂ b₁ b₂ hlt heq
    have hk : (g₂ ^ (k : ℕ) * g₀ ^ (i₁ : ℕ) * (b₁ : G))⁻¹ *
        (g₂ ^ (k : ℕ) * g₀ ^ (i₂ : ℕ) * (b₂ : G)) ∈ K :=
      QuotientGroup.eq.mp heq
    set e : ℕ := (i₂ : ℕ) - (i₁ : ℕ)
    have he_pos : 0 < e := Nat.sub_pos_of_lt hlt
    have he_lt : e < m₀ := by omega
    have hi₂ : (i₂ : ℕ) = (i₁ : ℕ) + e := (Nat.add_sub_of_le (le_of_lt hlt)).symm
    have hue_norm : g₀ ^ e ∈ normalizer (B' : Set G) := pow_mem hg₀_norm _
    have hub₂ : g₀ ^ e * (b₂ : G) * (g₀ ^ e)⁻¹ ∈ B' :=
      (mem_normalizer_iff.mp hue_norm b₂.1).1 b₂.2
    let b₀ : B' := b₁⁻¹ * ⟨g₀ ^ e * (b₂ : G) * (g₀ ^ e)⁻¹, hub₂⟩
    have hb₀u : (b₀ : G) * g₀ ^ e =
        (g₂ ^ (k : ℕ) * g₀ ^ (i₁ : ℕ) * (b₁ : G))⁻¹ *
        (g₂ ^ (k : ℕ) * g₀ ^ (i₂ : ℕ) * (b₂ : G)) := by
      simp only [b₀, Subgroup.coe_mul, Subgroup.coe_inv]
      rw [hi₂, pow_add]
      group
    exact hnot₀ ⟨e, he_lt⟩ b₀ he_pos (hb₀u.symm ▸ hk)
  have hΦ : Function.Injective Φ := by
    rintro ⟨⟨k₁, i₁⟩, a₁⟩ ⟨⟨k₂, i₂⟩, a₂⟩ heq
    induction a₁ using QuotientGroup.induction_on with | H b₁ =>
    induction a₂ using QuotientGroup.induction_on with | H b₂ =>
    rcases lt_trichotomy k₁ k₂ with hlt | rfl | hgt
    · exact False.elim (hstep_k k₁ k₂ i₁ i₂ b₁ b₂ hlt heq)
    · rcases lt_trichotomy i₁ i₂ with hilt | rfl | higt
      · exact False.elim (hstep_i k₁ i₁ i₂ b₁ b₂ hilt heq)
      · refine Prod.ext rfl ?_
        rw [QuotientGroup.eq, mem_subgroupOf]
        have hk : (g₂ ^ (k₁ : ℕ) * g₀ ^ (i₁ : ℕ) * (b₁ : G))⁻¹ *
            (g₂ ^ (k₁ : ℕ) * g₀ ^ (i₁ : ℕ) * (b₂ : G)) ∈ K :=
          QuotientGroup.eq.mp heq
        have h1 : (g₂ ^ (k₁ : ℕ) * g₀ ^ (i₁ : ℕ) * (b₁ : G))⁻¹ *
            (g₂ ^ (k₁ : ℕ) * g₀ ^ (i₁ : ℕ) * (b₂ : G)) =
            (b₁ : G)⁻¹ * (b₂ : G) := by group
        rwa [h1] at hk
      · exact False.elim (hstep_i k₁ i₂ i₁ b₂ b₁ higt heq.symm)
    · exact False.elim (hstep_k k₂ k₁ i₂ i₁ b₂ b₁ hgt heq.symm)
  have hle := Nat.card_le_card_of_injective Φ hΦ
  simpa only [Nat.card_prod, Nat.card_fin, Subgroup.index] using hle

section AbstractJ3

variable {G : Type*} [Group G] [Finite G]
variable {x : Fin 3 → G} (hx : ∀ i, x i ^ 3 = 1) (hc : ∀ i j, Commute (x i) (x j))
  (hinj : Function.Injective (basisProd x))
variable {h : Fin 3 → G}
  (hh : ∀ k j, h k * x j * (h k)⁻¹ =
    basisProd x fun i => (t33 k : Matrix (Fin 3) (Fin 3) (ZMod 3)) i j)

local notation "B" => Subgroup.closure (Set.range x)

include hx hc hinj in
private noncomputable def j3Coord (b : B) : Fin 3 → ZMod 3 :=
  fun i => Multiplicative.toAdd ((basisEquiv hx hc hinj).symm b) i

omit [Finite G] in
include hx hc hinj in
private theorem j3Coord_basisProd (a : Fin 3 → ZMod 3) :
    j3Coord hx hc hinj ⟨basisProd x a, basisProd_mem hx hc a⟩ = a := by
  have h1 : (⟨basisProd x a, basisProd_mem hx hc a⟩ : B) =
      basisEquiv hx hc hinj (Multiplicative.ofAdd a) :=
    Subtype.ext (coe_basisEquiv hx hc hinj a).symm
  funext i
  change Multiplicative.toAdd ((basisEquiv hx hc hinj).symm
    ⟨basisProd x a, basisProd_mem hx hc a⟩) i = a i
  rw [h1, MulEquiv.symm_apply_apply, toAdd_ofAdd]

omit [Finite G] in
include hx hc hinj in
private theorem j3Coord_one : j3Coord hx hc hinj 1 = 0 := by
  funext i
  change Multiplicative.toAdd ((basisEquiv hx hc hinj).symm 1) i = 0
  rw [map_one, toAdd_one]
  rfl

omit [Finite G] in
include hx hc hinj in
private theorem j3Coord_mul (b₁ b₂ : B) :
    j3Coord hx hc hinj (b₁ * b₂) = j3Coord hx hc hinj b₁ + j3Coord hx hc hinj b₂ := by
  funext i
  change Multiplicative.toAdd ((basisEquiv hx hc hinj).symm (b₁ * b₂)) i = _
  rw [map_mul, toAdd_mul]
  rfl

omit [Finite G] in
include hx hc hinj in
private theorem j3Coord_inv (b : B) :
    j3Coord hx hc hinj b⁻¹ = -j3Coord hx hc hinj b := by
  funext i
  change Multiplicative.toAdd ((basisEquiv hx hc hinj).symm b⁻¹) i = _
  rw [map_inv, toAdd_inv]
  rfl

omit [Finite G] in
include hx hc hinj in
private theorem j3Coord_injective : Function.Injective (j3Coord hx hc hinj) := by
  intro b₁ b₂ h12
  exact (basisEquiv hx hc hinj).symm.injective (Multiplicative.toAdd.injective h12)

include hx hc hh in
private theorem h_mem_norm (k : Fin 3) :
    ∀ b ∈ B, h k * b * (h k)⁻¹ ∈ B := by
  have hk := mem_normalizer_h hx hc hh k
  rw [mem_normalizer_iff] at hk
  intro b hb
  exact (hk b).1 hb

omit [Finite G] in
include hx hc hinj in
private theorem j3Coord_conj_norm (n : normalizer (B : Set G)) (b : B) :
    j3Coord hx hc hinj ⟨(n : G) * (b : G) * (n : G)⁻¹, (mem_normalizer_iff.mp n.2 b.1).1 b.2⟩ =
      ((rho (basisEquiv hx hc hinj) n : GL33) : Matrix (Fin 3) (Fin 3) (ZMod 3)) *ᵥ
        j3Coord hx hc hinj b := by
  have hmat : conjMat (basisEquiv hx hc hinj) n =
      ((rho (basisEquiv hx hc hinj) n : GL33) : Matrix (Fin 3) (Fin 3) (ZMod 3)) := rfl
  have hvec := congrArg (fun M => M *ᵥ j3Coord hx hc hinj b) hmat.symm
  rw [conjMat, LinearMap.toMatrix'_mulVec] at hvec
  change _ = conjAdd (basisEquiv hx hc hinj) n
    (Multiplicative.toAdd ((basisEquiv hx hc hinj).symm b)) at hvec
  rw [conjAdd_apply, ofAdd_toAdd, MulEquiv.apply_symm_apply] at hvec
  exact hvec.symm

private theorem j3_smul_mem_addSubgroup {U : AddSubgroup (Fin 3 → ZMod 3)} (c : ZMod 3)
    {v : Fin 3 → ZMod 3} (hv : v ∈ U) :
    c • v ∈ U := by
  have hc_eq : c • v = c.val • v := by
    rw [← Nat.cast_smul_eq_nsmul (ZMod 3), ZMod.natCast_zmod_val]
  rw [hc_eq]
  exact U.nsmul_mem hv c.val

omit [Finite G] in
include hx hc hinj in
private theorem j3_mem_imageAddSubgroup_of_mul_mem {K : Subgroup G}
    (n : normalizer (B : Set G)) (b₀ : B) (hmem : (b₀ : G) * (n : G) ∈ K)
    {v : Fin 3 → ZMod 3}
    (hv : v ∈ j3ImageAddSubgroup (j3Coord hx hc hinj) (j3Coord_one hx hc hinj)
      (j3Coord_mul hx hc hinj) (K.subgroupOf B)) :
    ((rho (basisEquiv hx hc hinj) n : GL33) : Matrix (Fin 3) (Fin 3) (ZMod 3)) *ᵥ v ∈
      j3ImageAddSubgroup (j3Coord hx hc hinj) (j3Coord_one hx hc hinj)
        (j3Coord_mul hx hc hinj) (K.subgroupOf B) := by
  rcases hv with ⟨w, hw, rfl⟩
  have hcomm : IsMulCommutative B :=
    isMulCommutative_closure (by rintro _ ⟨i, rfl⟩ _ ⟨j, rfl⟩ _; exact hc i j)
  have hnw_mem : (n : G) * (w : G) * (n : G)⁻¹ ∈ B :=
    (mem_normalizer_iff.mp n.2 w.1).1 w.2
  let nw : B := ⟨(n : G) * (w : G) * (n : G)⁻¹, hnw_mem⟩
  have hb₀_comm : (b₀ : G) * (nw : G) = (nw : G) * (b₀ : G) :=
    congrArg Subtype.val (mul_comm' b₀ nw)
